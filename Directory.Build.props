<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>Xact Solutions</Company>
    <Product>FiGet</Product>
    <Copyright>Copyright (c) 2026 Xact Solutions</Copyright>
    <!-- CA1848/CA1873: LoggerMessage source generators are not worth the ceremony here.
         CA2007: ASP.NET Core has no synchronisation context.
         CA1515: public types in an application are fine; the test projects need them.
         CA1062: nullable reference types already cover argument null checks.
         CA1859: concrete-type return hints make signatures worse for no measurable gain. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1515;CA1062;CA1716;CA1711;CA1720;CA1859</NoWarn>
  </PropertyGroup>
</Project>
