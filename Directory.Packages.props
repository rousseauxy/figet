<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the two PackageVersion lines below lift packages that only arrive transitively. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Never referenced directly. The data and identity packages bring 8.0.1, 9.0.11 and 10.0.12, all in
         the range of CVE-2026-84008 and of the Xml advisories published 2026-10-13. The runtime in the base
         image (10.0.13) carries patched copies; this keeps the package graph honest too. The Microsoft
         packages above follow the base image's runtime and never run ahead of it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <!-- Referenced directly by FiGet.Domain: version comparison is the domain, not a detail. -->
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <!-- Only for PasswordHasher: the hashing, not the rest of Identity. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.13" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Theme packs are YAML, the same version as the sibling application, so a pack moves unchanged. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
  </ItemGroup>
</Project>
