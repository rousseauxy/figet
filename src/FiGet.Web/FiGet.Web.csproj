<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>figet-web</UserSecretsId>
    <!--
      Deliberately NOT InvariantGlobalization. Microsoft.Data.SqlClient refuses to open a connection under invariant
      mode and throws NotSupportedException, which killed the first SQL Server deployment at start-up: applying
      migrations is the first thing this server does, so an unsupported mode is a crash loop rather than a degraded
      feature. The runtime images this ships on carry ICU, and the test host never set the flag - which is why every
      test passed while the shipped container could not open a database.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>
  <!--
    The composition root, and the only project allowed to see every layer at once: it is where the
    ports declared in FiGet.Application are bound to the adapters in FiGet.Infrastructure.
  -->
  <ItemGroup>
    <ProjectReference Include="..\FiGet.Domain\FiGet.Domain.csproj" />
    <ProjectReference Include="..\FiGet.Application\FiGet.Application.csproj" />
    <ProjectReference Include="..\FiGet.Infrastructure\FiGet.Infrastructure.csproj" />
    <ProjectReference Include="..\FiGet.Infrastructure.SqlServer\FiGet.Infrastructure.SqlServer.csproj" />
    <ProjectReference Include="..\FiGet.Infrastructure.Sqlite\FiGet.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="..\FiGet.Http\FiGet.Http.csproj" />
    <ProjectReference Include="..\FiGet.Protocol.Assets\FiGet.Protocol.Assets.csproj" />
    <ProjectReference Include="..\FiGet.Protocol.Management\FiGet.Protocol.Management.csproj" />
    <ProjectReference Include="..\FiGet.Protocol.V2\FiGet.Protocol.V2.csproj" />
    <ProjectReference Include="..\FiGet.Protocol.V3\FiGet.Protocol.V3.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FiGet.Integration.Tests" />
  </ItemGroup>
</Project>
