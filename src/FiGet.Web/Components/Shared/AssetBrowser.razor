@using FiGet.Application.Assets
@using FiGet.Domain.Assets
@using FiGet.Protocol.Assets
@inject AssetService AssetFiles
@inject IAssetCachePolicyStore CachePolicies

@* The browse page of an asset directory. Statically rendered like the rest of the public pages: a folder
   is a link, a file is a download, and the one piece of script is the upload drop zone an admin sees. *@

<p class="fg-crumbs">
    <a href="/assets">Assets</a>
    <span class="fg-crumb-sep">/</span>
    @if (Folder.IsRoot)
    {
        <span>@Feed.Name</span>
    }
    else
    {
        <a href="@FolderLink(AssetPath.Root)">@Feed.Name</a>
        @for (var i = 0; i < Folder.Segments.Count; i++)
        {
            var depth = i + 1;
            <span class="fg-crumb-sep">/</span>
            @if (depth == Folder.Segments.Count)
            {
                <span>@Folder.Segments[i]</span>
            }
            else
            {
                AssetPath.TryParse(string.Join('/', Folder.Segments.Take(depth)), out var ancestor);
                <a href="@FolderLink(ancestor)">@Folder.Segments[i]</a>
            }
        }
    }
</p>

<div class="fg-page-head">
    <h1>@(Folder.IsRoot ? Feed.Name : Folder.Name)</h1>
    <span class="fg-badge">Asset directory</span>
    @if (Feed.IsFolderBacked)
    {
        <span class="fg-badge fg-badge-plain" title="The files are a folder on the server, read as it is: what is placed there is served at once">From a folder on the server</span>
    }
    @if (Level >= FeedAccessLevel.Manage)
    {
        <a class="fg-btn fg-btn-sm" href="/admin/assets/@Feed.Name">Settings</a>
    }
</div>

@if (FetchMessage is { } notice)
{
    <div class="@(notice.Ok ? "fg-alert fg-alert-ok" : "fg-alert fg-alert-danger")">@notice.Text</div>
}

<p class="fg-url">
    <span class="fg-label">Download URL</span>
    <code>@BaseUrl</code>
    <button type="button" class="fg-copy" data-copy="@BaseUrl" title="Copy this URL" aria-label="Copy the download URL of this folder">Copy</button>
</p>

<Accordion Id="download" Title="Download from a script" Group="asset-actions">
    <Instructions Lines="@FiGet.Domain.Feeds.InstructionTemplates.Render(Feed.FileInstructions, FiGet.Domain.Feeds.InstructionTemplates.DefaultFiles, new Dictionary<string, string> { ["directory"] = Feed.Name, ["folderUrl"] = BaseUrl })" />
</Accordion>

@if (missing)
{
    <p class="fg-empty">There is no folder <code>@Folder.Value</code> in this directory.</p>
    return;
}

@if (Level >= FeedAccessLevel.Manage)
{
    @* What downloads under this folder tell caches; inherited by the folders below unless one says otherwise. Fixed modes,
       never free-form headers, so nothing here can undo the download headers every file carries. *@
    <Accordion Id="cache" Title="@CacheTitle" Group="asset-actions">
        <form method="post" action="/admin/assets/@Uri.EscapeDataString(Feed.Name)/cache" class="fg-form fg-form-inline">
            <AntiforgeryToken />
            <input type="hidden" name="path" value="@Folder.Value" />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div class="fg-field">
                <label for="cache-mode">@(Folder.IsRoot ? "Caching for this directory" : "Caching for this folder")</label>
                <select id="cache-mode" name="mode">
                    @if (!Folder.IsRoot)
                    {
                        <option value="inherit" selected="@(ownPolicy is null)">Inherit from the folder above (@Describe(inherited))</option>
                    }
                    else
                    {
                        <option value="inherit" selected="@(ownPolicy is null)">Browser and proxy defaults</option>
                    }
                    <option value="no-store" selected="@(ownPolicy?.Mode == AssetCacheMode.NoStore)">Never cache (no-store, no-cache, must-revalidate)</option>
                    <option value="max-age" selected="@(ownPolicy?.Mode == AssetCacheMode.MaxAge)">Cache for a number of seconds</option>
                </select>
            </div>
            <div class="fg-field">
                <label for="cache-seconds">Seconds</label>
                <input id="cache-seconds" name="maxAge" type="number" min="0" value="@(ownPolicy?.MaxAgeSeconds ?? 3600)" />
            </div>
            <button type="submit" class="fg-btn">Apply</button>
        </form>
    </Accordion>
}

@if (Feed.IsFolderBacked && !Feed.FolderWritable && Level >= FeedAccessLevel.Publish)
{
    <p class="fg-muted fg-small">
        The files are a folder on the server and are managed there; uploads, folders and deletes through FiGet are off for
        this directory.
    </p>
}

@if (Level >= FeedAccessLevel.Publish && AssetService.AcceptsWrites(Feed))
{
    <section class="fg-dropzone" data-asset-upload data-upload-url="/admin/assets/@Uri.EscapeDataString(Feed.Name)/upload" data-import-url="/admin/assets/@Uri.EscapeDataString(Feed.Name)/import" data-folder="@Folder.Value">
        <AntiforgeryToken />
        <p class="fg-dropzone-prompt">
            <strong>Drop files here</strong> to upload them into <code>@(Folder.IsRoot ? "/" : Folder.Value)</code>, or
            <label class="fg-dropzone-pick">choose files<input type="file" multiple data-asset-files /></label>.
        </p>
        <p class="fg-muted fg-small">
            Up to @Display.Size(MaxAssetBytes) per file. A file that already exists is kept, unless you choose to replace it
            in its row as it comes up.
        </p>
        <p class="fg-dropzone-prompt fg-small">
            Or <label class="fg-dropzone-pick">import a .zip or .tar.gz<input type="file" accept=".zip,.tgz,.gz" data-asset-archive /></label>
            and unpack it here, keeping its folders.
        </p>
        @* One switch for both ways in: a dropped file and an unpacked archive entry meet the same existing file. *@
        <label class="fg-check fg-small"><input type="checkbox" data-asset-overwrite /> Replace files that already exist without asking, for dropped files and imports alike</label>
        <ul class="fg-upload-list" data-asset-progress aria-live="polite"></ul>
    </section>

    <Accordion Id="fetch" Title="Fetch from a URL" Group="asset-actions" Open="@(FetchMessage is { Ok: false })">
        <form method="post" action="/admin/assets/@Uri.EscapeDataString(Feed.Name)/fetch" class="fg-form">
            <AntiforgeryToken />
            <input type="hidden" name="parent" value="@Folder.Value" />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div class="fg-field">
                <label for="fetch-url">URL</label>
                <input id="fetch-url" name="url" type="url" required placeholder="https://download.example.com/tool/setup-1.2.3.exe" />
            </div>
            <div class="fg-field">
                <label for="fetch-name">Save as (empty keeps the name in the URL)</label>
                <input id="fetch-name" name="name" maxlength="@AssetPath.MaxSegmentLength" />
            </div>
            <label class="fg-check"><input type="checkbox" name="overwrite" value="true" /> Replace a file that already exists</label>
            <p class="fg-muted fg-small">The server downloads it once and keeps it here; the page waits until it is done.</p>
            <button type="submit" class="fg-btn fg-btn-primary">Fetch</button>
        </form>
    </Accordion>

    <Accordion Id="new-folder" Title="New folder" Group="asset-actions">
        <form method="post" action="/admin/assets/@Uri.EscapeDataString(Feed.Name)/folders" class="fg-form">
            <AntiforgeryToken />
            <input type="hidden" name="parent" value="@Folder.Value" />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div class="fg-field">
                <label for="folder-name">Name</label>
                <input id="folder-name" name="name" required maxlength="@AssetPath.MaxSegmentLength" placeholder="for example: tools" />
            </div>
            <button type="submit" class="fg-btn fg-btn-primary">Create folder</button>
        </form>
    </Accordion>
}

<p class="fg-result-count">
    @FolderCount folder@(FolderCount == 1 ? "" : "s"), @FileCount file@(FileCount == 1 ? "" : "s").
    @if (items.Count > 0)
    {
        <span>Download @(Folder.IsRoot ? "everything" : "this folder") as <a href="@ExportLink("zip")" download>.zip</a> or <a href="@ExportLink("tgz")" download>.tar.gz</a>.</span>
    }
</p>

@if (items.Count == 0)
{
    <p class="fg-empty">This folder is empty.</p>
}
else
{
    <div class="fg-table-wrap">
        <table class="fg-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Size</th>
                    <th>Modified</th>
                    <th>Type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        @if (item.IsDirectory)
                        {
                            AssetPath.TryParse(item.Path, out var folder);
                            <td><a href="@FolderLink(folder)">@item.Name/</a></td>
                            <td class="fg-num">@Display.None</td>
                            <td class="fg-num">@Display.Date(item.ModifiedUtc)</td>
                            <td><span class="fg-badge fg-badge-plain">Folder</span></td>
                        }
                        else
                        {
                            <td><a href="@ContentUrl(item)" title="Download @item.Name">@Display.BreakableId(item.Name)</a></td>
                            <td class="fg-num">@Display.Size(item.Size)</td>
                            <td class="fg-num">@Display.Date(item.ModifiedUtc)</td>
                            <td class="fg-small fg-muted">@(item.ContentType ?? AssetContentTypes.Resolve(null, item.Name))</td>
                        }
                        <td class="fg-cell-actions">
                            @if (!item.IsDirectory)
                            {
                                <button type="button" class="fg-copy" data-copy="@ContentUrl(item)" title="Copy the download URL" aria-label="Copy the download URL of @item.Name">Copy URL</button>
                            }
                            @if (Level >= FeedAccessLevel.Publish && AssetService.AcceptsWrites(Feed))
                            {
                                <form method="post" action="/admin/assets/@Uri.EscapeDataString(Feed.Name)/delete"
                                      data-confirm="@(item.IsDirectory ? $"Delete the folder {item.Name} and everything in it?" : $"Delete {item.Name}?")">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="path" value="@item.Path" />
                                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                    <button type="submit" class="fg-btn fg-btn-sm fg-btn-danger">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<FiGet.Domain.Entities.AssetItem> items = [];
    private bool missing;
    private IReadOnlyList<AssetCachePolicy> policies = [];
    private AssetCachePolicy? ownPolicy;
    private AssetCachePolicy? inherited;

    private string CacheTitle => "Caching: " + Describe(ownPolicy ?? inherited) + (ownPolicy is null && !Folder.IsRoot ? " (inherited)" : "");

    private static string Describe(AssetCachePolicy? policy) => policy?.Mode switch
    {
        AssetCacheMode.NoStore => "never cached",
        AssetCacheMode.MaxAge => $"cached for {policy.MaxAgeSeconds ?? 0} seconds",
        _ => "browser and proxy defaults",
    };

    [Parameter, EditorRequired]
    public Feed Feed { get; set; } = default!;

    /// <summary>The folder being shown, as the query string carried it.</summary>
    [Parameter]
    public string? Path { get; set; }

    /// <summary>What the viewer may do here: Publish shows the upload and delete controls, Manage the settings link.</summary>
    [Parameter]
    public FeedAccessLevel Level { get; set; }

    /// <summary>A signed-in viewer exports through the page's own route, which reads with their account.</summary>
    [Parameter]
    public bool SignedIn { get; set; }

    [Parameter]
    public long MaxAssetBytes { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private AssetPath Folder { get; set; } = AssetPath.Root;

    private int FolderCount => items.Count(i => i.IsDirectory);

    private int FileCount => items.Count(i => !i.IsDirectory);

    private string ReturnUrl => HttpContext.Request.Path + HttpContext.Request.QueryString;

    private string BaseUrl => $"{PublicUrls.ClientBase(HttpContext, Feed.ClientBaseUrl)}/endpoints/{Uri.EscapeDataString(Feed.Name)}/content/"
        + (Folder.IsRoot ? "" : AssetEndpoints.EscapePath(Folder.Value) + "/");

    protected override async Task OnParametersSetAsync()
    {
        if (!AssetPath.TryParse(Path, out var folder))
        {
            missing = true;
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        Folder = folder;
        if (!folder.IsRoot && await AssetFiles.FindAsync(Feed, folder, HttpContext.RequestAborted) is not { IsDirectory: true })
        {
            missing = true;
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        items = await AssetFiles.ListAsync(Feed, folder, recursive: false, HttpContext.RequestAborted);

        if (Level >= FeedAccessLevel.Manage)
        {
            policies = await CachePolicies.ListAsync(Feed.Key, HttpContext.RequestAborted);
            ownPolicy = policies.FirstOrDefault(p => p.PathLower == folder.Lower);
            inherited = folder.IsRoot ? null : AssetEndpoints.Nearest(policies, folder.Parent.Lower);
        }
    }

    /// <summary>
    /// A reader gets the API's own export URL, which works anonymously on a directory that reads anonymously.
    /// An admin gets the page's route instead, because the API takes tokens and the browser holds a cookie.
    /// </summary>
    private string ExportLink(string format)
    {
        var path = Folder.IsRoot ? "" : AssetEndpoints.EscapePath(Folder.Value);
        return SignedIn
            ? $"/admin/assets/{Uri.EscapeDataString(Feed.Name)}/export?format={format}&path={Uri.EscapeDataString(Folder.Value)}"
            : $"/endpoints/{Uri.EscapeDataString(Feed.Name)}/export/{path}?format={format}&recursive=true";
    }

    [SupplyParameterFromQuery(Name = "fetch")]
    private string? FetchResult { get; set; }

    /// <summary>What the last fetch did, from a fixed set of codes, so nothing from the address bar is shown as text.</summary>
    private (bool Ok, string Text)? FetchMessage => FetchResult switch
    {
        "fetched" => (true, "The file was fetched and stored."),
        "exists" => (false, "A file with that name is already here. Tick 'replace' to overwrite it."),
        "too-large" => (false, "The file is larger than this server accepts."),
        "refused" => (false, "That URL was refused: it is not http or https, or it points at a private or local address this server does not fetch from."),
        "invalid" => (false, "That name or URL is not valid."),
        "failed" => (false, "The remote server could not be reached, answered with an error, or took too long."),
        _ => null,
    };

    private string ContentUrl(FiGet.Domain.Entities.AssetItem item) =>
        $"{PublicUrls.ClientBase(HttpContext, Feed.ClientBaseUrl)}/endpoints/{Uri.EscapeDataString(Feed.Name)}/content/{AssetEndpoints.EscapePath(item.Path)}";

    private string FolderLink(AssetPath folder) =>
        folder.IsRoot
            ? $"/assets/{Uri.EscapeDataString(Feed.Name)}"
            : $"/assets/{Uri.EscapeDataString(Feed.Name)}?path={Uri.EscapeDataString(folder.Value)}";
}
