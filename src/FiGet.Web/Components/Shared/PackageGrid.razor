@*
    The signed-in view of a feed's packages: searching and paging without reloading the page.

    Interactive, and only ever rendered for a signed-in reader. A circuit is server state held for as
    long as somebody keeps the page open, and the anonymous read-only view is reachable without
    credentials, so that one stays statically rendered and gets the plain table instead.

    Two consequences of running in a circuit rather than a request:

    - There is no HttpContext, so anything derived from the request (the feed's public URL) is passed in
      by the statically rendered page above.
    - Scoped services live as long as the circuit, so resolving IPackageStore directly would hold one
      DbContext open per connected reader. Every query takes its own scope and disposes it, which is
      why IServiceScopeFactory is injected rather than the stores themselves.
*@

@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.Extensions.DependencyInjection
@using FiGet.Application.Connectors
@using FiGet.Domain.Search
@using FiGet.Domain.Versions
@using NuGet.Versioning
@implements IDisposable
@inject IServiceScopeFactory Scopes

<div class="fg-search-row">
    <div class="fg-search-bar">
        <input type="search" value="@query" @oninput="QueryChangedAsync"
               placeholder="Search id, title, tags, description" aria-label="Search packages" />
        @if (IsProxy)
        {
            <select @bind="source" @bind:after="ResetAsync" aria-label="Where the package comes from">
                <option value="">Everywhere</option>
                <option value="local">Local</option>
                <option value="cached">Cached</option>
                <option value="upstream">Upstream only</option>
            </select>
        }
    </div>
    @if (query.Length > 0 || source.Length > 0)
    {
        <button type="button" class="fg-btn fg-btn-ghost" @onclick="ClearAsync">Clear</button>
    }
</div>

@if (message is not null)
{
    <div class="fg-alert @(failed ? "fg-alert-danger" : "fg-alert-ok")">@message</div>
}

<p class="fg-result-count">
    @total package@(total == 1 ? "" : "s")@(query.Length == 0 ? "" : $" matching “{query}”").
    @if (IsProxy && query.Length == 0)
    {
        <text>Browsing shows what this feed holds; search to reach the upstreams as well.</text>
    }
</p>

<div class="fg-table-wrap">
    <QuickGrid TGridItem="Row" ItemsProvider="provider" Class="fg-table" @ref="grid">
        @* Sortable columns carry a SortBy only so the grid draws them as sortable; the provider reads which column
           was chosen and asks the database, because the rows on screen are one page of many. *@
        <TemplateColumn Title="Package" Context="row" SortBy="BySort" IsDefaultSortColumn="false">
            <a href="/feeds/@FeedName/packages/@row.Id">@Display.BreakableId(row.Id)</a>
        </TemplateColumn>
        <TemplateColumn Title="Latest" Context="row">
            <span class="fg-num">@row.Latest</span>
        </TemplateColumn>
        <TemplateColumn Title="Versions" Context="row" SortBy="BySort" InitialSortDirection="SortDirection.Descending">
            <span class="fg-num">@(row.Versions > 0 ? row.Versions.ToString(CultureInfo.InvariantCulture) : Display.None)</span>
        </TemplateColumn>
        <TemplateColumn Title="Source" Context="row">
            <span class="fg-badge @SourceBadge(row.Source)">@row.Source</span>
        </TemplateColumn>
        <TemplateColumn Title="Downloads" Context="row" SortBy="BySort" InitialSortDirection="SortDirection.Descending">
            <span class="fg-num">@(row.Local ? Display.Count(row.Downloads) : Display.None)</span>
        </TemplateColumn>
        <TemplateColumn Title="Last published" Context="row" SortBy="BySort" InitialSortDirection="SortDirection.Descending">
            <span class="fg-num">@Display.Date(row.Published)</span>
        </TemplateColumn>
        <TemplateColumn Title="" Context="row">
            @if (!row.Local)
            {
                @* A circuit call, not a form post: there is no HttpContext here to mint an
                   antiforgery token, and the circuit is already authenticated. *@
                <button type="button" class="fg-btn fg-btn-sm" disabled="@pulling"
                        title="Download @row.Id @row.Latest into this feed"
                        @onclick="() => PullAsync(row)">
                    Pull
                </button>
            }
        </TemplateColumn>
    </QuickGrid>
</div>

@if (total > PageSize)
{
    @* Ours, not the grid's. Paginator's scoped rules outrank plain selectors, hard-code a #ccc border
       that ignores the theme, and draw their arrows with a background any override wipes out. This also
       matches the pager the anonymous view already uses. *@
    <nav class="fg-pager">
        @if (pageIndex > 0)
        {
            <button type="button" class="fg-btn fg-btn-sm" @onclick="() => GoToAsync(pageIndex - 1)">← Previous</button>
        }
        <span class="fg-pager-info">
            @(pageIndex * PageSize + 1) to @Math.Min((pageIndex + 1) * PageSize, total) of @total
        </span>
        @if ((pageIndex + 1) * PageSize < total)
        {
            <button type="button" class="fg-btn fg-btn-sm" @onclick="() => GoToAsync(pageIndex + 1)">Next →</button>
        }
    </nav>
}

@code {
    private const int PageSize = 50;

    /// <summary>
    /// Paged here rather than by the grid, on purpose. Given a <c>PaginationState</c>, QuickGrid pads
    /// every page out to <c>ItemsPerPage</c> with blank rows that carry no class and no aria-rowindex —
    /// nothing a stylesheet can select — so five results in a page of fifty drew forty-five empty lines.
    /// Its own samples do not show this because the padding only happens when Pagination is set.
    /// </summary>
    private int pageIndex;

    /// <summary>A placeholder the grid needs to call a column sortable; the order itself comes from the database.</summary>
    private static readonly GridSort<Row> BySort = GridSort<Row>.ByAscending(row => row.Id);

    /// <summary>The order the last page was loaded in, so choosing another order starts again at the first page.</summary>
    private PackageSort? loadedSort;

    private GridItemsProvider<Row>? provider;
    private QuickGrid<Row>? grid;
    private CancellationTokenSource debounce = new();
    private string query = "";
    private string source = "";
    private string? message;
    private bool failed;
    private bool pulling;
    private int total;

    [Parameter, EditorRequired]
    public string FeedName { get; set; } = "";

    /// <summary>Whether this feed has upstreams, which is what makes the source filter meaningful.</summary>
    [Parameter]
    public bool IsProxy { get; set; }

    protected override void OnInitialized() => provider = LoadAsync;

    public void Dispose() => debounce.Dispose();

    private async Task QueryChangedAsync(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? "";

        // Typing must not fire a query per keystroke, and an upstream search is a network call.
        await debounce.CancelAsync();
        debounce.Dispose();
        debounce = new CancellationTokenSource();

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), debounce.Token);
            await ResetAsync();
        }
        catch (OperationCanceledException)
        {
            // Another keystroke arrived; that one will run the search.
        }
    }

    private async Task ClearAsync()
    {
        query = "";
        source = "";
        message = null;
        await ResetAsync();
    }

    /// <summary>Back to the first page and re-run: page seven of one search is not page seven of the next.</summary>
    private async Task ResetAsync()
    {
        pageIndex = 0;
        if (grid is not null)
        {
            await grid.RefreshDataAsync();
        }
    }

    private async Task GoToAsync(int target)
    {
        pageIndex = Math.Max(0, target);
        if (grid is not null)
        {
            await grid.RefreshDataAsync();
        }
    }

    private async ValueTask<GridItemsProviderResult<Row>> LoadAsync(GridItemsProviderRequest<Row> request)
    {
        await using var scope = Scopes.CreateAsyncScope();
        var feeds = scope.ServiceProvider.GetRequiredService<IFeedStore>();
        var packages = scope.ServiceProvider.GetRequiredService<IPackageStore>();

        var feed = await feeds.FindAsync(FeedName, request.CancellationToken);
        if (feed is null)
        {
            return GridItemsProviderResult.From<Row>([], 0);
        }

        var sort = request.SortByColumn?.Title switch
        {
            "Package" => new PackageSort(PackageSortField.Id, !request.SortByAscending),
            "Versions" => new PackageSort(PackageSortField.Versions, !request.SortByAscending),
            "Downloads" => new PackageSort(PackageSortField.Downloads, !request.SortByAscending),
            "Last published" => new PackageSort(PackageSortField.LastPublished, !request.SortByAscending),
            _ => null,
        };

        if (sort != loadedSort)
        {
            pageIndex = 0;
            loadedSort = sort;
        }

        var rows = new List<Row>();
        var count = 0;

        if (source != "upstream")
        {
            var filter = new PackageSearchFilter(SearchQueryParser.Parse(query), IncludePrerelease: true, IncludeSemVer2: true, PackageTypeLower: null, sort);
            // The grid is not paging, so its request always starts at zero: the offset is ours to apply.
            var page = await packages.SearchAsync(feed.Key, filter, pageIndex * PageSize, PageSize, request.CancellationToken);
            count = page.TotalHits;

            var found = (await packages.GetPackagesAsync(page.PackageKeys, request.CancellationToken)).ToDictionary(p => p.Key);
            foreach (var key in page.PackageKeys)
            {
                if (!found.TryGetValue(key, out var package))
                {
                    continue;
                }

                var pushed = package.Versions.Any(version => version.Origin == PackageOrigin.Pushed);
                if ((source == "local" && !pushed) || (source == "cached" && pushed))
                {
                    continue;
                }

                var list = VersionListBuilder.BuildLocal(package.Versions, includeSemVer2: true);
                var latest = list.Latest(includePrerelease: true) ?? list[^1];
                rows.Add(new Row(
                    package.Id,
                    latest.Payload!.NormalizedVersion,
                    package.Versions.Count,
                    pushed ? "Local" : "Cached",
                    package.Versions.Sum(version => version.Downloads),
                    package.Versions.Max(version => version.PublishedUtc),
                    Local: true));
            }
        }

        // A package nobody has cached must still be findable: that is what putting a proxy feed in
        // front of a gallery is for.
        if (feed.Upstreams.Count > 0 && source != "local" && source != "cached" && !string.IsNullOrWhiteSpace(query))
        {
            var connector = scope.ServiceProvider.GetRequiredService<ConnectorService>();
            var known = rows.Select(row => row.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var hits = await connector.SearchUpstreamsAsync(feed, query, includePrerelease: true, PageSize, request.CancellationToken);

            foreach (var hit in hits.Where(hit => !known.Contains(hit.Id)))
            {
                rows.Add(new Row(hit.Id, hit.Version.ToNormalizedString(), 0, "Upstream", hit.Downloads, null, Local: false));
            }

            count = Math.Max(count, rows.Count);
        }

        total = count;

        // The provider runs *during* a render, so assigning the count above does not repaint the line
        // that shows it — it kept saying "0 packages" over a table of results. Queued rather than
        // called directly, because re-rendering from inside a render is re-entrant.
        _ = InvokeAsync(StateHasChanged);

        return GridItemsProviderResult.From(rows, count);
    }

    /// <summary>
    /// Fetches this version from the upstream and keeps it, the same fetch a client's first download
    /// would do. Useful before a machine that has no internet needs it.
    /// </summary>
    private async Task PullAsync(Row row)
    {
        if (pulling)
        {
            return;
        }

        pulling = true;
        message = null;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var feeds = scope.ServiceProvider.GetRequiredService<IFeedStore>();
            var connector = scope.ServiceProvider.GetRequiredService<ConnectorService>();

            var feed = await feeds.FindAsync(FeedName, CancellationToken.None);
            if (feed is null || !NuGetVersion.TryParse(row.Latest, out var version))
            {
                (message, failed) = ($"Could not pull {row.Id} {row.Latest}.", true);
                return;
            }

            var pulled = await connector.EnsureCachedAsync(feed, row.Id, version, CancellationToken.None);
            (message, failed) = pulled is null
                ? ($"No upstream of {FeedName} could serve {row.Id} {row.Latest}.", true)
                : ($"Pulled {row.Id} {row.Latest} into {FeedName}.", false);
        }
        finally
        {
            pulling = false;
        }

        await ResetAsync();
    }

    /// <summary>
    /// Held here reads as settled; upstream-only reads as somewhere else. Keyed on the label the row
    /// already carries, so renaming one without the other leaves the badge silently unstyled.
    /// </summary>
    private static string SourceBadge(string source) => source switch
    {
        "Local" => "fg-badge-accent",
        "Cached" => "fg-badge-info",
        _ => "fg-badge-plain",
    };

    /// <summary>A row of the grid. Upstream-only packages have no local versions, downloads or date.</summary>
    private sealed record Row(string Id, string Latest, int Versions, string Source, long Downloads, DateTime? Published, bool Local);
}
