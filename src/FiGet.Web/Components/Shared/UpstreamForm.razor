@* Adding or editing one upstream, opened inline on a feed's settings page. *@
@using FiGet.Domain.Entities

<div class="fg-inline-panel">
    <h3>@(Upstream is null ? "Add upstream" : $"Edit {Upstream.Name}")</h3>
    @if (Error is not null)
    {
        <div class="fg-alert fg-alert-danger" role="alert">@Error</div>
    }
    <form method="post" action="/admin/feeds/@Feed.Name/upstreams/@(Upstream is null ? "add" : "update")" class="fg-form">
        <AntiforgeryToken />
        @if (Upstream is null)
        {
            <input type="hidden" name="returnUrl" value="@($"/admin/feeds/{Uri.EscapeDataString(Feed.Name)}?upstream=added#upstreams")" />
        }
        else
        {
            <input type="hidden" name="key" value="@Upstream.Key" />
        }

        <UpstreamFields Upstream="Upstream" Prefix="@(Upstream is null ? "upstream-new" : $"upstream-{Upstream.Key}")" />

        @if (Upstream is not null)
        {
            <p class="fg-muted fg-small">
                A new URL, protocol or credential drops the version lists stored from the old source, and they are fetched again
                from the new one. Packages already cached stay.
            </p>
        }
        else
        {
            <p class="fg-muted fg-small">Asked after the upstreams the feed already has; the arrows in the list change the order.</p>
        }

        <div class="fg-row">
            <button type="submit" class="fg-btn fg-btn-primary">@(Upstream is null ? "Add upstream" : "Save upstream")</button>
            <a class="fg-btn" href="@Cancel">Cancel</a>
        </div>
    </form>
</div>

@code {
    [Parameter, EditorRequired]
    public Feed Feed { get; set; } = default!;

    /// <summary>The upstream being edited, or null to add one.</summary>
    [Parameter]
    public FeedUpstream? Upstream { get; set; }

    [Parameter]
    public string? Error { get; set; }

    /// <summary>Where Cancel goes: the page with the form closed.</summary>
    [Parameter]
    public string Cancel { get; set; } = "";
}
