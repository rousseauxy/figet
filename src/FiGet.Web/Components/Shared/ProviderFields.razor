@using FiGet.Web.SignIn

@* The fields of a sign-in provider, inside the EditForm of the page that adds or edits one. *@

<div class="fg-field">
    <label for="provider-display">Button name</label>
    <InputText id="provider-display" @bind-Value="Model.DisplayName" placeholder="for example: Authentik" />
    <ValidationMessage For="() => Model.DisplayName" />
</div>
<div class="fg-field">
    <label for="provider-slug">Slug</label>
    <InputText id="provider-slug" @bind-Value="Model.Slug" placeholder="for example: authentik" />
    <span class="fg-small fg-muted">In the redirect URI. Changing it later means registering the new URI at the provider.</span>
    <ValidationMessage For="() => Model.Slug" />
</div>
<div class="fg-field">
    <label for="provider-authority">Issuer URL</label>
    <InputText id="provider-authority" @bind-Value="Model.Authority" placeholder="https://auth.example.org/application/o/figet/" />
    <span class="fg-small fg-muted">Where <code>/.well-known/openid-configuration</code> is found.</span>
    <ValidationMessage For="() => Model.Authority" />
</div>
<div class="fg-field">
    <label for="provider-client">Client id</label>
    <InputText id="provider-client" @bind-Value="Model.ClientId" autocomplete="off" />
    <ValidationMessage For="() => Model.ClientId" />
</div>
<div class="fg-field">
    <label for="provider-secret">Client secret</label>
    <InputText id="provider-secret" type="password" @bind-Value="Model.ClientSecret" autocomplete="new-password" />
    <span class="fg-small fg-muted">@(Editing ? "Leave empty to keep the stored secret. It is never shown again." : "Stored encrypted and never shown again.")</span>
</div>
<div class="fg-field">
    <label for="provider-scopes">Scopes</label>
    <InputText id="provider-scopes" @bind-Value="Model.Scopes" />
</div>
<div class="fg-field">
    <label for="provider-username-claim">User name claim</label>
    <InputText id="provider-username-claim" @bind-Value="Model.UserNameClaim" />
    <span class="fg-small fg-muted">A new account's user name comes from this claim, or else from the email address.</span>
    <ValidationMessage For="() => Model.UserNameClaim" />
</div>
<div class="fg-field">
    <label for="provider-groups-claim">Groups claim</label>
    <InputText id="provider-groups-claim" @bind-Value="Model.GroupsClaim" placeholder="for example: groups" />
    <span class="fg-small fg-muted">Empty turns group mapping off. Link provider groups to FiGet groups on each group's page.</span>
</div>
<div class="fg-field">
    <label for="provider-order">Button order</label>
    <InputNumber id="provider-order" @bind-Value="Model.Ordinal" />
</div>
<div class="fg-field">
    <label for="provider-domains">Allowed email domains</label>
    <InputTextArea id="provider-domains" @bind-Value="Model.AllowedEmailDomains" rows="2" placeholder="for example: example.org" />
    <span class="fg-small fg-muted">One per line. Someone signing in for the first time needs a verified address in one of them. Empty allows any address.</span>
</div>
<label class="fg-check"><InputCheckbox @bind-Value="Model.CreateAccounts" /> Make an account at a first sign-in. Off: an admin makes the account, and its owner connects this provider from the profile page. With a provider anyone can register at, on means anyone gets an account.</label>
<label class="fg-check"><InputCheckbox @bind-Value="Model.Enabled" /> Enabled: show it on the sign-in page and accept sign-ins</label>

<fieldset>
    <legend>API access tokens</legend>
    <p class="fg-small fg-muted">
        Next to FiGet's own API keys, the feeds, asset directories and packages API can accept short-lived access tokens this
        issuer signs: an application's client-credentials token, or a CI job's token from GitLab or GitHub Actions. A token
        may do what the FiGet groups linked to its groups claim may do, at most publish. For an issuer nobody signs in with,
        leave the client id and secret empty and sign-ins off.
    </p>
    <label class="fg-check"><InputCheckbox @bind-Value="Model.AcceptApiTokens" /> Accept access tokens from this issuer on the API</label>
    <div class="fg-field">
        <label for="provider-audiences">Audiences</label>
        <InputTextArea id="provider-audiences" @bind-Value="Model.ApiAudiences" rows="2" placeholder="for example: the application (client) id, or https://figet.example.org" />
        <span class="fg-small fg-muted">One per line. A token must be issued for one of them.</span>
    </div>
    <div class="fg-field">
        <label for="provider-required-claims">Required claims</label>
        <InputTextArea id="provider-required-claims" @bind-Value="Model.ApiRequiredClaims" rows="2" placeholder="for example: ref_protected=true" />
        <span class="fg-small fg-muted">One <code>name=value</code> per line. Every name listed must be in the token with one of its values. Use it for an issuer many projects share.</span>
    </div>
</fieldset>

@code {
    [Parameter, EditorRequired]
    public ProviderInput Model { get; set; } = default!;

    [Parameter]
    public bool Editing { get; set; }
}
