@page "/feeds/{Name}/packages/{Id}"
@using System.Security.Claims
@using FiGet.Core.Connectors
@using FiGet.Core.Versions
@inject IFeedStore Feeds
@inject IPackageStore Packages
@inject ConnectorService Connector

<PageTitle>@Id · FiGet</PageTitle>

@if (feed is null || shown is null)
{
    <h1>Package not found</h1>
    <p><code>@Id</code> is not in feed <code>@Name</code>. <a href="/feeds/@Name">Back to the feed</a>.</p>
    return;
}

<p class="crumbs"><a href="/">Feeds</a> / <a href="/feeds/@feed.Name">@feed.Name</a></p>
<h1>@displayId <span class="version">@shown.NormalizedVersion</span></h1>

<nav class="tabs">
    <a class="@(All ? "" : "active")" href="/feeds/@feed.Name/packages/@displayId">Overview</a>
    <a class="@(All ? "active" : "")" href="/feeds/@feed.Name/packages/@displayId?all=true">All versions</a>
</nav>

@if (!All)
{
    @if (!string.IsNullOrWhiteSpace(shown.Description))
    {
        <p class="description">@shown.Description</p>
    }

    <dl class="facts">
        <dt>Authors</dt><dd>@(string.IsNullOrWhiteSpace(shown.Authors) ? "—" : shown.Authors)</dd>
        <dt>Tags</dt><dd>@(string.IsNullOrWhiteSpace(shown.Tags) ? "—" : shown.Tags)</dd>
        <dt>Project</dt>
        <dd>
            @if (Uri.TryCreate(shown.ProjectUrl, UriKind.Absolute, out var project) && project.Scheme is "https" or "http")
            {
                <a href="@project" rel="noopener noreferrer">@project</a>
            }
            else
            {
                <span>—</span>
            }
        </dd>
        <dt>Licence</dt><dd>@(shown.LicenseExpression is { Length: > 0 } expr ? expr : (string.IsNullOrWhiteSpace(shown.LicenseUrl) ? "—" : shown.LicenseUrl))</dd>
    </dl>

    <h2>Install the latest</h2>
    <pre><code>Install-Module -Name @displayId -RequiredVersion @shown.NormalizedVersion -Repository @feed.Name</code></pre>
    <pre><code>Install-PSResource -Name @displayId -Version @shown.NormalizedVersion -Repository @feed.Name</code></pre>
    <pre><code>dotnet add package @displayId --version @shown.NormalizedVersion --source @(feedUrl)/v3/index.json</code></pre>

    <h2>Recent versions</h2>
}
else
{
    <h2>Every version of @displayId</h2>
}

<div class="table-wrap">
    <table>
        <thead>
            <tr><th>Version</th><th>Source</th><th>State</th><th>Published</th><th>Size</th><th>Downloads</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var entry in Rows)
            {
                var row = entry.Payload!;
                var local = entry.Source == VersionSource.Local;
                <tr class="@(row.Listed ? "" : "inactive")">
                    <td><a href="/feeds/@feed.Name/packages/@displayId/@row.NormalizedVersion">@row.NormalizedVersion</a></td>
                    <td><span class="badge">@Origin(entry)</span></td>
                    <td>
                        @(row.Listed ? "Listed" : "Unlisted")
                        @if (entry.IsAbsoluteLatestVersion) { <span class="badge">latest</span> }
                        @if (entry.IsLatestVersion && !entry.IsAbsoluteLatestVersion) { <span class="badge">latest stable</span> }
                    </td>
                    <td>@(local ? row.PublishedUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC" : "—")</td>
                    <td>@(local ? FormatSize(row.Size) : "—")</td>
                    <td>@row.Downloads.ToString("N0", CultureInfo.InvariantCulture)</td>
                    <td class="actions">
                        @if (local)
                        {
                            <a href="@(feedUrl)/package/@displayId/@row.NormalizedVersion">Download</a>
                        }
                        else if (IsAdmin)
                        {
                            <form method="post" action="/admin/feeds/@feed.Name/pull">
                                <AntiforgeryToken />
                                <input type="hidden" name="id" value="@displayId" />
                                <input type="hidden" name="version" value="@row.NormalizedVersion" />
                                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                <button type="submit" class="link">Pull</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!All && versions.Count > RecentCount)
{
    <p class="muted"><a href="/feeds/@feed.Name/packages/@displayId?all=true">Show all @versions.Count versions</a>.</p>
}

@code {
    /// <summary>How many versions the overview shows before sending you to the full list.</summary>
    private const int RecentCount = 10;

    private Feed? feed;
    private string displayId = "";
    private PackageVersion? shown;
    private IReadOnlyList<VersionListEntry<PackageVersion>> versions = [];
    private string feedUrl = "";

    [Parameter]
    public string Name { get; set; } = "";

    [Parameter]
    public string Id { get; set; } = "";

    [SupplyParameterFromQuery(Name = "all")]
    private bool All { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool IsAdmin => HttpContext.User.HasClaim(ClaimTypes.Role, "admin");

    private string ReturnUrl => HttpContext.Request.Path + HttpContext.Request.QueryString;

    /// <summary>Newest first, because that is the version being looked for.</summary>
    private IEnumerable<VersionListEntry<PackageVersion>> Rows =>
        All ? versions.Reverse() : versions.Reverse().Take(RecentCount);

    protected override async Task OnInitializedAsync()
    {
        feed = await Feeds.FindAsync(Name, HttpContext.RequestAborted);
        if (feed is not null && !feed.AnonymousRead && !IsAdmin)
        {
            // Same rule as the feed page: a feed that needs credentials is not confirmed to exist either.
            feed = null;
        }

        if (feed is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var idLower = Id.ToLowerInvariant();

        // Upstreams first, so a version withdrawn upstream is reflected in the rows read just below.
        var upstream = feed.Upstreams.Count == 0
            ? []
            : await Connector.UpstreamCandidatesAsync(feed, idLower, HttpContext.RequestAborted);

        var package = await Packages.GetPackageAsync(feed.Key, idLower, includeDependencies: false, HttpContext.RequestAborted);
        var local = package?.Versions ?? [];
        if (local.Count == 0 && upstream.Count == 0)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        displayId = package?.Id ?? Id;
        feedUrl = PublicUrls.Feed(HttpContext, feed.Name);
        versions = VersionListBuilder
            .Build(local.Select(VersionListBuilder.ToCandidate).Concat(upstream), includeSemVer2: true)
            .Where(e => e.Payload is not null)
            .ToList();

        shown = (versions.Latest(includePrerelease: true) ?? versions[^1]).Payload;
    }

    /// <summary>Where this version is right now: pushed here, cached from an upstream, or only upstream.</summary>
    private static string Origin(VersionListEntry<PackageVersion> entry) => entry.Source switch
    {
        VersionSource.Local when entry.Payload!.Origin == PackageOrigin.Cached => "Cached",
        VersionSource.Local => "Pushed here",
        _ => "Upstream",
    };

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => (bytes / 1024d / 1024d).ToString("0.0", CultureInfo.InvariantCulture) + " MB",
        >= 1024 => (bytes / 1024d).ToString("0", CultureInfo.InvariantCulture) + " KB",
        _ => bytes.ToString(CultureInfo.InvariantCulture) + " B",
    };
}
