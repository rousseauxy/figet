@page "/feeds/{Name}/packages/{Id}"
@using System.Security.Claims
@using FiGet.Application.Connectors
@using FiGet.Domain.Versions
@inject FiGet.Application.Accounts.FeedAccessService Access
@using FiGet.Domain.Feeds
@inject IFeedStore Feeds
@inject IPackageStore Packages
@inject IPackageStorage Storage
@inject ConnectorService Connector

<PageTitle>@Id · FiGet</PageTitle>

@if (feed is null || shown is null)
{
    <h1>Package not found</h1>
    <p class="fg-muted"><code>@Id</code> is not in feed <code>@Name</code>. <a href="/feeds/@Name">Back to the feed</a>.</p>
    return;
}

<p class="fg-crumbs">
    <a href="/">Feeds</a>
    <span class="fg-crumb-sep">/</span>
    <a href="/feeds/@feed.Name">@feed.Name</a>
    <span class="fg-crumb-sep">/</span>
    <span>@displayId</span>
</p>

<div class="fg-page-head">
    @if (Display.Link(shown.IconUrl) is { } icon)
    {
        <img class="fg-icon" src="@icon" alt="" loading="lazy" data-fallback />
    }
    <h1>@displayId</h1>
    <span class="fg-version">@shown.NormalizedVersion</span>
    <span class="fg-badge @OriginBadge(latest!)">@Origin(latest!)</span>
    @if (upstreamName.Length > 0 && Origin(latest!) != "Local")
    {
        <span class="fg-small fg-muted" title="The upstream this package comes from">from @upstreamName</span>
    }
</div>

@* The same tabs as a single version, because the questions are the same ones: what is it, what does it
   say about itself, what does it need, what is inside. They answer for the version named above. *@
<PullOutcome />

<nav class="fg-tabs">
    <a class="fg-tab @Active("")" href="@TabLink("")">Overview</a>
    <a class="fg-tab @Active("metadata")" href="@TabLink("metadata")">Metadata</a>
    <a class="fg-tab @Active("dependencies")" href="@TabLink("dependencies")">Dependencies</a>
    @if (LatestIsLocal)
    {
        <a class="fg-tab @Active("files")" href="@TabLink("files")">Files</a>
    }
    <a class="fg-tab @Active("versions")" href="@TabLink("versions")">All versions</a>
</nav>

@switch (CurrentTab)
{
    case "metadata":
        <PackageMetadata DisplayId="@displayId" Row="shown" Origin="@Origin(latest!)" IsLocal="LatestIsLocal" />
        break;

    case "dependencies":
        <PackageDependencies Dependencies="dependencies" FeedName="@feed.Name" IsLocal="LatestIsLocal" />
        break;

    case "files":
        <PackageFiles Files="files" />
        break;

    case "versions":
        <h2>Every version of @displayId</h2>
        @VersionTable(Rows)
        <nav class="fg-pager">
            @if (Page > 1)
            {
                <a class="fg-btn fg-btn-sm" href="@TabLink("versions", Page - 1)">← Newer</a>
            }
            <span class="fg-pager-info">
                @(Skip + 1) to @(Skip + Rows.Count()) of @visible.Count versions, newest first
            </span>
            @if (Skip + PageSize < visible.Count)
            {
                <a class="fg-btn fg-btn-sm" href="@TabLink("versions", Page + 1)">Older →</a>
            }
            @* Only worth offering when there is more than one page to have. *@
            @if (visible.Count > DefaultPageSize)
            {
                <span class="fg-pager-sizes">
                    @foreach (var size in PageSizes)
                    {
                        if (size == PageSize)
                        {
                            <strong>@size</strong>
                        }
                        else
                        {
                            <a href="@TabLink("versions", 1, size)">@size</a>
                        }
                    }
                    <span class="fg-muted">per page</span>
                </span>
            }
        </nav>
        @if (level >= FeedAccessLevel.Publish && CachedCount > 0)
        {
            <section class="fg-panel fg-panel-danger">
                <h2>Cached copies</h2>
                <p class="fg-muted fg-small">
                    This feed holds @CachedCount version@(CachedCount == 1 ? "" : "s") of @displayId. A held
                    copy is answered instead of the upstream, so it stays the answer - and can stay the
                    latest - however the gallery moves on. Removing them makes this feed follow its
                    upstreams again; nothing is lost, since the next download fetches them back.
                    @if (CachedHidden > 0)
                    {
                        <text>
                            @CachedHidden of @(CachedHidden == 1 ? "them is" : "them are") not in the list
                            above, because the gallery unlists
                            @(CachedHidden == 1 ? "that version" : "those versions") and this page hides
                            what the gallery hides. Un-caching removes
                            @(CachedHidden == 1 ? "it" : "them") as well.
                        </text>
                    }
                    @if (versions.Any(e => e.Source == VersionSource.Local && e.Payload!.Origin == PackageOrigin.Pushed))
                    {
                        <text>Versions pushed to this feed are left alone.</text>
                    }
                </p>
                <form method="post" action="/admin/feeds/@feed!.Name/packages/uncache" data-confirm="@($"Remove the cached copies of {displayId}? They are fetched from the upstream again when asked for.")" data-confirm-button="Un-cache">
                    <AntiforgeryToken />
                    <input type="hidden" name="id" value="@displayId" />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <button type="submit" class="fg-btn fg-btn-danger">
                        Un-cache @CachedCount version@(CachedCount == 1 ? "" : "s")
                    </button>
                </form>
            </section>
        }
        @if (UnlistedHidden > 0)
        {
            <p class="fg-muted">
                @UnlistedHidden unlisted version@(UnlistedHidden == 1 ? "" : "s") hidden, as the gallery hides
                @(UnlistedHidden == 1 ? "it" : "them"). @(UnlistedHidden == 1 ? "It stays" : "They stay") installable
                by exact version.
            </p>
        }
        @PrereleaseNote
        break;

    default:
        @if (!string.IsNullOrWhiteSpace(shown.Description))
        {
            <p class="fg-lede">@shown.Description</p>
        }

        <div class="fg-panel">
            <dl class="fg-facts">
                <dt>Version</dt><dd class="fg-num">@shown.NormalizedVersion</dd>
                <dt>Authors</dt><dd>@(string.IsNullOrWhiteSpace(shown.Authors) ? Display.None : shown.Authors)</dd>
                <dt>Published</dt><dd class="fg-num">@Display.Date(shown.PublishedUtc)</dd>
            </dl>
        </div>

        <h2>Install the latest</h2>
        <Instructions Lines="@InstructionTemplates.Render(feed.PackageInstructions, InstructionTemplates.DefaultPackageFor(feed.Purpose), new Dictionary<string, string> { ["id"] = displayId, ["version"] = shown.NormalizedVersion, ["feed"] = feed.Name, ["feedUrl"] = feedUrl, ["v3Url"] = feedUrl + "/v3/index.json" })" />

        <h2>Recent versions</h2>
        @VersionTable(visible.Reverse().Take(RecentCount))
        @if (visible.Count > RecentCount)
        {
            <p class="fg-result-count"><a href="@TabLink("versions")">Show all @visible.Count versions</a>.</p>
        }
        @if (UnlistedHidden > 0)
        {
            <p class="fg-muted">
                @UnlistedHidden unlisted version@(UnlistedHidden == 1 ? "" : "s") hidden, as the gallery hides
                @(UnlistedHidden == 1 ? "it" : "them"). @(UnlistedHidden == 1 ? "It stays" : "They stay") installable
                by exact version.
            </p>
        }
        @PrereleaseNote

        break;
}

@code {
    /// <summary>Versions of this package this feed is holding a copy of, which is what un-caching removes.</summary>
    private int CachedCount => versions.Count(e => e.Source == VersionSource.Local && e.Payload!.Origin == PackageOrigin.Cached);

    /// <summary>
    /// Cached versions the table does not show, because the gallery unlists them. Without this the panel
    /// offers to remove two versions while the list above it shows one, which reads as a miscount.
    /// </summary>
    private int CachedHidden => versions.Count(e =>
        e.Source == VersionSource.Local && e.Payload!.Origin == PackageOrigin.Cached && !e.Listed);

    /// <summary>How many versions the overview shows before sending you to the full list.</summary>
    private const int RecentCount = 10;

    /// <summary>
    /// How many the full list shows at a time. A package with two thousand versions is not unusual on a
    /// gallery, and rendering all of them is a download rather than a page.
    /// </summary>
    private const int DefaultPageSize = 50;

    /// <summary>
    /// Sizes offered per page. Capped deliberately: the rows are rendered server-side, and a package with
    /// a couple of thousand versions - PnP.PowerShell has 2098 - makes a page nobody enjoys waiting for.
    /// </summary>
    private static readonly int[] PageSizes = [50, 100, 250, 500];

    /// <summary>Rows per page: whatever the query asked for, if it is one of the offered sizes.</summary>
    private int PageSize => Array.IndexOf(PageSizes, Per) >= 0 ? Per : DefaultPageSize;

    private Feed? feed;
    private string displayId = "";
    private string upstreamName = "";
    private PackageVersion? shown;
    private VersionListEntry<PackageVersion>? latest;
    private IReadOnlyList<VersionListEntry<PackageVersion>> versions = [];

    /// <summary>
    /// What the tables show: the versions the sources still advertise, mirroring the gallery's own page.
    /// PSGallery lists 36 versions of PnP.PowerShell and withdraws the other 2062; those are gallery
    /// history and are left out here too, whether or not this feed happens to hold one.
    ///
    /// Hiding is display only — <c>versions</c> stays whole behind it, because the latest is computed
    /// across all of it. An unlisted version stays resolvable by exact version, which is the case that
    /// matters: a pinned install names a version and does not care whether the gallery still shows it.
    /// The flat container serves every stored version on purpose, and a held copy can still be relisted
    /// through <c>POST /v3/publish/{id}/{version}</c>. Local search and autocomplete already filtered
    /// unlisted versions out; this table was the last place they appeared.
    /// </summary>
    private IReadOnlyList<VersionListEntry<PackageVersion>> visible = [];
    private IReadOnlyList<PackageDependency> dependencies = [];
    private IReadOnlyList<PackageFileEntry>? files;
    private string feedUrl = "";

    /// <summary>
    /// The version list, rendered the same way on the overview and on the full list. One definition so
    /// the two cannot drift, which they had already started to do when they were written out twice.
    /// </summary>
    private RenderFragment<IEnumerable<VersionListEntry<PackageVersion>>> VersionTable => rows =>
        @<div class="fg-table-wrap">
            <table class="fg-table">
                <thead>
                    <tr>
                        <th>Version</th>
                        <th>Source</th>
                        <th>State</th>
                        <th>Published</th>
                        <th>Size</th>
                        <th>Downloads</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in rows)
                    {
                        var row = entry.Payload!;
                        var local = entry.Source == VersionSource.Local;
                        <tr class="@(row.Listed ? "" : "is-inactive")">
                            <td class="fg-num"><a href="/feeds/@feed!.Name/packages/@displayId/@row.NormalizedVersion">@row.NormalizedVersion</a></td>
                            <td><span class="fg-badge @OriginBadge(entry)">@Origin(entry)</span></td>
                            <td>
                                @* Only what is worth saying: nearly every row is listed, so printing it
                                   on all of them buried the two flags that actually differ. *@
                                @if (!row.Listed)
                                {
                                    <span class="fg-badge fg-badge-warn">unlisted</span>
                                }
                                @if (entry.IsAbsoluteLatestVersion)
                                {
                                    <span class="fg-badge fg-badge-accent">latest</span>
                                }
                                else if (entry.IsLatestVersion)
                                {
                                    <span class="fg-badge fg-badge-accent">latest stable</span>
                                }
                            </td>
                            <td class="fg-num">@Display.Date(local ? row.PublishedUtc : null)</td>
                            <td class="fg-num">@(local ? Display.Size(row.Size) : Display.None)</td>
                            <td class="fg-num" title="@(local ? null : "The gallery reports only a total for the whole package, not per version")">@(local ? Display.Count(row.Downloads) : Display.None)</td>
                            <td class="fg-cell-actions">
                                @if (local)
                                {
                                    <a class="fg-btn fg-btn-sm fg-btn-icon fg-icon-download" href="@(feedUrl)/package/@displayId/@row.NormalizedVersion" title="Download @displayId @row.NormalizedVersion" aria-label="Download @displayId @row.NormalizedVersion"></a>
                                }
                                else if (level >= FeedAccessLevel.Publish)
                                {
                                    <form method="post" action="/admin/feeds/@feed!.Name/pull" data-busy="Pulling with its dependencies...">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="id" value="@displayId" />
                                        <input type="hidden" name="version" value="@row.NormalizedVersion" />
                                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                        <button type="submit" class="fg-btn fg-btn-sm fg-btn-icon fg-icon-pull" title="Pull @displayId @row.NormalizedVersion into this feed, with its dependencies" aria-label="Pull @displayId @row.NormalizedVersion into this feed"></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>;

    [Parameter]
    public string Name { get; set; } = "";

    [Parameter]
    public string Id { get; set; } = "";

    [SupplyParameterFromQuery(Name = "tab")]
    private string? Tab { get; set; }

    /// <summary>The old link shape for the full list, kept so anything already bookmarked still works.</summary>
    [SupplyParameterFromQuery(Name = "all")]
    private bool All { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int Page { get; set; }

    /// <summary>Rows per page. Anything not in <c>PageSizes</c> falls back to the default.</summary>
    [SupplyParameterFromQuery(Name = "per")]
    private int Per { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>What the signed-in account, or a visitor, may do with this feed.</summary>
    private FeedAccessLevel level;

    private string ReturnUrl => HttpContext.Request.Path + HttpContext.Request.QueryString;

    private string CurrentTab => All ? "versions" : (Tab ?? "").Trim().ToLowerInvariant();

    private bool LatestIsLocal => latest!.Source == VersionSource.Local;

    private int Skip => (Math.Max(1, Page) - 1) * PageSize;

    /// <summary>Newest first, because that is the version being looked for.</summary>
    private IEnumerable<VersionListEntry<PackageVersion>> Rows => visible.Reverse().Skip(Skip).Take(PageSize);

    [SupplyParameterFromQuery(Name = "pre")]
    private string? Pre { get; set; }

    /// <summary>Prerelease versions shown, and counted as the latest. Off by default, like a gallery.</summary>
    private bool IncludePrerelease => Pre == "1";

    /// <summary>Unlisted versions held back from the tables, so the count is never quietly wrong.</summary>
    private int UnlistedHidden => versions.Count(e => !e.Listed);

    /// <summary>Listed prerelease versions held back while prerelease is off.</summary>
    private int PrereleaseHidden => IncludePrerelease ? 0 : versions.Count(e => e.Listed && e.Version.IsPrerelease && !ReferenceEquals(e, latest));

    /// <summary>The switch, with what it hides or shows, under each version list.</summary>
    private RenderFragment PrereleaseNote => __builder =>
    {
        if (IncludePrerelease && versions.Any(e => e.Listed && e.Version.IsPrerelease))
        {
            <p class="fg-muted">Prerelease versions shown. <a href="@TabLink(CurrentTab, prerelease: false)">Show stable versions only</a>.</p>
        }
        else if (PrereleaseHidden > 0)
        {
            <p class="fg-muted">@PrereleaseHidden prerelease version@(PrereleaseHidden == 1 ? "" : "s") hidden. <a href="@TabLink(CurrentTab, prerelease: true)">Show prerelease versions</a>.</p>
        }
    };

    private string Active(string tab) => CurrentTab == tab ? "active" : "";

    private string TabLink(string tab, int? page = null, int? per = null, bool? prerelease = null)
    {
        var link = $"/feeds/{Uri.EscapeDataString(Name)}/packages/{Uri.EscapeDataString(displayId)}";
        var pre = prerelease ?? IncludePrerelease;
        if (tab.Length == 0)
        {
            return pre ? link + "?pre=1" : link;
        }

        link += "?tab=" + tab + (pre ? "&pre=1" : "");
        if (page is not null)
        {
            link += "&page=" + page.Value.ToString(CultureInfo.InvariantCulture);
        }

        // Carried on every link, or paging back would silently drop the size the reader chose.
        var size = per ?? (PageSize == DefaultPageSize ? null : PageSize);
        return size is null ? link : link + "&per=" + size.Value.ToString(CultureInfo.InvariantCulture);
    }

    protected override async Task OnInitializedAsync()
    {
        Page = Math.Max(1, Page);
        feed = await Feeds.FindAsync(Name, HttpContext.RequestAborted);
        level = feed is null ? FeedAccessLevel.None : await Access.LevelAsync(feed, FiGetApp.Actor(HttpContext.User), HttpContext.RequestAborted);
        if (feed is not null && (level < FeedAccessLevel.Read || !FiGet.Http.FeedAccess.ReachableFrom(HttpContext, feed)))
        {
            // Same rule as the feed page: a feed that needs credentials is not confirmed to exist either.
            feed = null;
        }

        if (feed is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var idLower = Id.ToLowerInvariant();

        // Upstreams first, so a version withdrawn upstream is reflected in the rows read just below.
        var upstream = feed.Upstreams.Count == 0
            ? new UpstreamCandidates([], "")
            : await Connector.UpstreamCandidatesAsync(feed, idLower, HttpContext.RequestAborted);

        var package = await Packages.GetPackageAsync(feed.Key, idLower, includeDependencies: true, HttpContext.RequestAborted);
        var local = package?.Versions ?? [];
        if (local.Count == 0 && upstream.Versions.Count == 0)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        displayId = package?.Id ?? upstream.Spell(Id);
        upstreamName = upstream.Upstream;
        feedUrl = $"{PublicUrls.ClientBase(HttpContext, feed.ClientBaseUrl)}/nuget/{Uri.EscapeDataString(feed.Name)}";
        versions = [.. VersionListBuilder
            .Build(local.Select(VersionListBuilder.ToCandidate).Concat(upstream.Versions), includeSemVer2: true)
            .Where(entry => entry.Payload is not null)];

        latest = versions.Shown(IncludePrerelease)!;
        visible = [.. versions.Where(entry => entry.Listed && (IncludePrerelease || !entry.Version.IsPrerelease || ReferenceEquals(entry, latest)))];
        shown = latest.Payload;
        dependencies = [.. shown!.Dependencies.OrderBy(dependency => dependency.Ordinal)];

        if (LatestIsLocal && CurrentTab == "files")
        {
            var key = new PackageStorageKey(feed.Key, displayId.ToLowerInvariant(), shown.NormalizedVersionLower);
            files = await PackageFileReader.ReadAsync(Storage, key, HttpContext.RequestAborted);
        }
    }

    /// <summary>Where this version is right now: pushed here, cached from an upstream, or only upstream.</summary>
    private static string Origin(VersionListEntry<PackageVersion> entry) => entry.Source switch
    {
        VersionSource.Local when entry.Payload!.Origin == PackageOrigin.Cached => "Cached",
        VersionSource.Local => "Local",
        _ => "Upstream",
    };

    private static string OriginBadge(VersionListEntry<PackageVersion> entry) => entry.Source switch
    {
        VersionSource.Local when entry.Payload!.Origin == PackageOrigin.Cached => "fg-badge-info",
        VersionSource.Local => "fg-badge-accent",
        _ => "fg-badge-plain",
    };
}
