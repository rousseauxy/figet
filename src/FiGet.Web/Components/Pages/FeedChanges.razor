@page "/feeds/{Name}/changes"
@using FiGet.Application.Reports
@inject FiGet.Application.Accounts.FeedAccessService Access
@inject IFeedStore Feeds
@inject ChangeReportService Reports
@inject TimeProvider Time

@*
    What changed among the packages this feed holds - pushed here, cached from an upstream, or offered by an upstream
    and not fetched yet. The last is what the page is for: it is the warning that a gallery has moved ahead of what
    this feed serves, which is worth knowing before a fleet installs it rather than after.

    Read from the database, never from a gallery: anyone who may read the feed may open this, and a page that reaches
    out is a way to make this server spend somebody else's bandwidth.
*@

<PageTitle>What's new · @Name · FiGet</PageTitle>

@if (feed is null)
{
    <h1>Feed not found</h1>
    <p class="fg-muted">
        There is no feed named <code>@Name</code>, or it cannot be read without signing in.
        <a href="/">Back to feeds</a>.
    </p>
    return;
}

<p class="fg-crumbs">
    <a href="/">Feeds</a>
    <span class="fg-crumb-sep">/</span>
    <a href="/feeds/@feed.Name">@feed.Name</a>
    <span class="fg-crumb-sep">/</span>
    <span>What's new</span>
</p>

<div class="fg-page-head">
    <h1>What's new in @feed.Name</h1>
    <a class="fg-btn fg-btn-sm" href="/feeds/@feed.Name">Browse packages</a>
</div>

<nav class="fg-pills" aria-label="Period">
    @foreach (var choice in Windows)
    {
        <a class="fg-pill @(choice.Days == days ? "active" : "")" href="/feeds/@feed.Name/changes?days=@choice.Days" aria-current="@(choice.Days == days ? "true" : null)">@choice.Label</a>
    }
</nav>

<p class="fg-muted fg-small">
    Versions this feed gained since @Display.Date(report!.FromUtc), and versions its upstreams offer that nobody here
    has fetched. Only packages this feed holds: a gallery's other news is not this feed's.
    @if (report!.StoppedAtLimit)
    {
        <strong>More changed than fits in one report; the oldest are not shown.</strong>
    }
</p>

<ChangeTable Title="Pushed here" Feed="@feed.Name" Changes="report!.Of(PackageChangeKind.Pushed)" Empty="Nothing was pushed to this feed in this period." />
<ChangeTable Title="Cached from an upstream" Feed="@feed.Name" Changes="report!.Of(PackageChangeKind.Cached)" Empty="No new version was fetched from an upstream in this period." />

@if (feed.Upstreams.Count > 0)
{
    <ChangeTable Title="Newer upstream, not fetched"
                 Feed="@feed.Name"
                 Changes="report!.Of(PackageChangeKind.Upstream)"
                 Empty="Every package this feed holds is at the newest version its upstreams offer."
                 ShowUpstream="true" />
}

@code {
    [Parameter]
    public string Name { get; set; } = "";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "days")]
    private string? Window { get; set; }

    private Feed? feed;
    private ChangeReport? report;
    private int days = ChangeReportService.DefaultDays;

    /// <summary>The periods offered, in the vocabulary the usage graph already uses.</summary>
    private static readonly (int Days, string Label)[] Windows = [(1, "24 hours"), (7, "7 days"), (30, "30 days")];

    protected override async Task OnInitializedAsync()
    {
        feed = await Feeds.FindAsync(Name, HttpContext.RequestAborted);
        var level = feed is null ? FeedAccessLevel.None : await Access.LevelAsync(feed, FiGetApp.Actor(HttpContext.User), HttpContext.RequestAborted);
        if (feed is { Kind: FeedKind.Assets } || level < FeedAccessLevel.Read || !FiGet.Http.FeedAccess.ReachableFrom(HttpContext, feed!))
        {
            // As on the feed's own page: a feed that needs credentials is not confirmed to exist either.
            feed = null;
        }

        if (feed is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        // Read as text and clamped: bound as a number, a hand-edited address is a 400 before this runs.
        days = ChangeReportService.Days(int.TryParse(Window, NumberStyles.Integer, CultureInfo.InvariantCulture, out var asked) ? asked : null);
        report = await Reports.BuildAsync(feed, days, Time.GetUtcNow().UtcDateTime, HttpContext.RequestAborted);
    }
}
