@page "/account/login"
@page "/account/login/local"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using FiGet.Application.Accounts
@inject AccountService Accounts
@inject NavigationManager Navigation
@inject FiGet.Http.AuditLog Audit

@*
    Two addresses, one form. /account/login/local is the fallback that always shows the local form, whatever sign-in
    providers are configured later; today both show it.
*@

<PageTitle>Sign in · FiGet</PageTitle>

<section class="fg-signin">
    <div class="fg-card">
        <div class="fg-card-header">Sign in</div>
        <div class="fg-card-body">
            <EditForm Model="Input!" FormName="login" OnValidSubmit="SignInAsync" method="post" class="fg-form">
                <DataAnnotationsValidator />
                <div class="fg-field">
                    <label for="username">User name</label>
                    <InputText id="username" autocomplete="username" @bind-Value="Input!.UserName" />
                    <ValidationMessage For="() => Input!.UserName" />
                </div>
                <div class="fg-field">
                    <label for="password">Password</label>
                    <InputText id="password" type="password" autocomplete="current-password" @bind-Value="Input!.Password" />
                    <ValidationMessage For="() => Input!.Password" />
                </div>
                @if (error is not null)
                {
                    <p class="fg-error">@error</p>
                }
                <button type="submit" class="fg-btn fg-btn-primary">Sign in</button>
            </EditForm>
        </div>
    </div>
</section>

@code {
    private string? error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "login")]
    private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task SignInAsync()
    {
        var result = await Accounts.SignInAsync(Input!.UserName, Input.Password, HttpContext.RequestAborted);
        switch (result.Status)
        {
            case SignInStatus.Success:
                break;
            case SignInStatus.LockedOut:
                Audit.Record(HttpContext, "signin.locked", Input.UserName);
                error = $"Too many failed attempts. Try again in {AccountService.LockoutDuration.TotalMinutes:0} minutes.";
                return;
            case SignInStatus.Disabled:
                Audit.Record(HttpContext, "signin.disabled", Input.UserName);
                error = "This account is disabled.";
                return;
            default:
                // Recorded without the password, obviously - what matters is that somebody tried, as whom, and from where.
                Audit.Record(HttpContext, "signin.refused", Input.UserName);
                error = "The user name or password is not right.";
                return;
        }

        var user = result.User!;
        await FiGetApp.SignInUserAsync(HttpContext, user);
        Audit.Record(HttpContext, "signin", user.UserName);

        if (user.MustChangePassword)
        {
            Navigation.NavigateTo("/account/password");
            return;
        }

        var target = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            ? ReturnUrl
            : "/";
        Navigation.NavigateTo(target);
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter your user name.")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
}
