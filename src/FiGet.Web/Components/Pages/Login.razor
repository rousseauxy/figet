@page "/account/login"
@page "/account/login/local"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using FiGet.Application.Accounts
@inject AccountService Accounts
@inject IOidcProviderStore Providers
@inject ISettingStore Settings
@inject NavigationManager Navigation
@inject FiGet.Http.AuditLog Audit

@*
    Two addresses. /account/login shows the enabled sign-in providers as buttons, with a link to the local form unless a
    super admin chose providers only; with no provider enabled it is the local form. /account/login/local always shows
    the local form, so a local account - the first administrator above all - can sign in whatever the providers do.
*@

<PageTitle>Sign in · FiGet</PageTitle>

<section class="fg-signin">
    <div class="fg-card">
        <div class="fg-card-header">Sign in</div>
        <div class="fg-card-body">
            @if (ExternalMessage is { } externalMessage)
            {
                <p class="fg-error" role="alert">@externalMessage</p>
            }

            @if (!IsLocalPath && providers.Count > 0)
            {
                <div class="fg-signin-providers">
                    @foreach (var provider in providers)
                    {
                        <form method="post" action="/account/external/@provider.Slug">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
                            <button type="submit" class="fg-btn fg-btn-primary fg-btn-block">Sign in with @provider.DisplayName</button>
                        </form>
                    }
                </div>
                @if (mode != SignInModes.ProvidersOnly)
                {
                    <p class="fg-signin-local"><a href="@LocalHref">Sign in with a local account</a></p>
                }
            }
            else
            {
                <EditForm Model="Input!" FormName="login" OnValidSubmit="SignInAsync" method="post" class="fg-form">
                    <DataAnnotationsValidator />
                    <div class="fg-field">
                        <label for="username">User name</label>
                        <InputText id="username" autocomplete="username" @bind-Value="Input!.UserName" />
                        <ValidationMessage For="() => Input!.UserName" />
                    </div>
                    <div class="fg-field">
                        <label for="password">Password</label>
                        <InputText id="password" type="password" autocomplete="current-password" @bind-Value="Input!.Password" />
                        <ValidationMessage For="() => Input!.Password" />
                    </div>
                    @if (error is not null)
                    {
                        <p class="fg-error">@error</p>
                    }
                    <button type="submit" class="fg-btn fg-btn-primary">Sign in</button>
                </EditForm>
                @if (IsLocalPath && providers.Count > 0)
                {
                    <p class="fg-signin-local"><a href="/account/login@(SafeReturnUrl == "/" ? "" : "?returnUrl=" + Uri.EscapeDataString(SafeReturnUrl))">Sign in with a provider instead</a></p>
                }
            }
        </div>
    </div>
</section>

@code {
    private string? error;
    private IReadOnlyList<OidcProvider> providers = [];
    private string mode = SignInModes.ProvidersAndLocal;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "login")]
    private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "external")]
    private string? External { get; set; }

    private bool IsLocalPath => HttpContext.Request.Path.StartsWithSegments("/account/login/local", StringComparison.OrdinalIgnoreCase);

    private string SafeReturnUrl => ReturnUrls.LocalOr(ReturnUrl, "/");

    private string LocalHref => "/account/login/local" + (SafeReturnUrl == "/" ? "" : "?returnUrl=" + Uri.EscapeDataString(SafeReturnUrl));

    private string? ExternalMessage => External switch
    {
        "failed" => "Signing in with the provider did not work. Try again, or ask an administrator.",
        "disabled" => "This account is disabled.",
        "exists" => "An account with this user name or email already exists. Sign in to it, then connect the provider from your profile.",
        "unknown" => "That sign-in provider is not available.",
        "expired" => "The page had expired. Try again.",
        "limited" => "Too many sign-in attempts from this address. Wait a minute and try again.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        providers = (await Providers.ListAsync(HttpContext.RequestAborted)).Where(p => p.Enabled).ToList();
        if (providers.Count > 0)
        {
            mode = await Settings.GetAsync(SettingKeys.SignInMode, HttpContext.RequestAborted) ?? SignInModes.ProvidersAndLocal;
        }
    }

    private async Task SignInAsync()
    {
        var result = await Accounts.SignInAsync(Input!.UserName, Input.Password, HttpContext.RequestAborted);
        switch (result.Status)
        {
            case SignInStatus.Success:
                break;
            case SignInStatus.LockedOut:
                Audit.Record(HttpContext, "signin.locked", Input.UserName);
                error = $"Too many failed attempts. Try again in {AccountService.LockoutDuration.TotalMinutes:0} minutes.";
                return;
            case SignInStatus.Disabled:
                Audit.Record(HttpContext, "signin.disabled", Input.UserName);
                error = "This account is disabled.";
                return;
            default:
                // Recorded without the password, obviously - what matters is that somebody tried, as whom, and from where.
                Audit.Record(HttpContext, "signin.refused", Input.UserName);
                error = "The user name or password is not right.";
                return;
        }

        var user = result.User!;
        await FiGetApp.SignInUserAsync(HttpContext, user);
        Audit.Record(HttpContext, "signin", user.UserName);

        if (user.MustChangePassword)
        {
            Navigation.NavigateTo("/account/password");
            return;
        }

        Navigation.NavigateTo(SafeReturnUrl);
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter your user name.")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
}
