@page "/account/login"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using FiGet.Application.Tokens
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject AccessTokenService Tokens
@inject NavigationManager Navigation

<PageTitle>Sign in · FiGet</PageTitle>

<section class="fg-signin">
    <div class="fg-card">
        <div class="fg-card-header">Sign in</div>
        <div class="fg-card-body">
            <p class="fg-muted fg-small">
                Paste an admin token. Sign-in with an identity provider arrives in a later release.
            </p>

            <EditForm Model="Input!" FormName="login" OnValidSubmit="SignInAsync" method="post" class="fg-form">
                <DataAnnotationsValidator />
                <div class="fg-field">
                    <label for="token">Admin token</label>
                    <InputText id="token" type="password" autocomplete="off" @bind-Value="Input!.Token" />
                    <ValidationMessage For="() => Input!.Token" />
                </div>
                @if (error is not null)
                {
                    <p class="fg-error">@error</p>
                }
                <button type="submit" class="fg-btn fg-btn-primary">Sign in</button>
            </EditForm>
        </div>
    </div>
</section>

@code {
    private string? error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "login")]
    private LoginInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task SignInAsync()
    {
        var token = await Tokens.ValidateAsync(Input!.Token, HttpContext.RequestAborted);
        if (token is null || !token.IsAdmin)
        {
            error = "That token is not a valid admin token.";
            return;
        }

        var identity = new ClaimsIdentity(
            [
                new Claim(ClaimTypes.Name, token.Name),
                new Claim(ClaimTypes.Role, "admin"),
                new Claim(FiGetApp.TokenKeyClaim, token.Key.ToString(CultureInfo.InvariantCulture)),
            ],
            CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));

        var target = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            ? ReturnUrl
            : "/";
        Navigation.NavigateTo(target);
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter a token.")]
        public string Token { get; set; } = "";
    }
}
