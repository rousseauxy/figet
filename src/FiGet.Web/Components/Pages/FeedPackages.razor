@page "/feeds/{Name}"
@using System.Security.Claims
@using FiGet.Application.Connectors
@using FiGet.Domain.Search
@using FiGet.Domain.Versions
@inject FiGet.Application.Accounts.FeedAccessService Access
@inject IFeedStore Feeds
@inject IPackageStore Packages
@inject ConnectorService Connector

<PageTitle>@Name · FiGet</PageTitle>

@if (feed is null)
{
    <h1>Feed not found</h1>
    <p class="fg-muted">
        There is no feed named <code>@Name</code>, or it cannot be read without signing in.
        <a href="/">Back to feeds</a>.
    </p>
    return;
}

<p class="fg-crumbs">
    <a href="/">Feeds</a>
    <span class="fg-crumb-sep">/</span>
    <span>@feed.Name</span>
</p>

<div class="fg-page-head">
    <h1>@feed.Name</h1>
    @if (level >= FeedAccessLevel.Manage)
    {
        <a class="fg-btn fg-btn-sm" href="/admin/feeds/@feed.Name">Settings</a>
    }
</div>

<p class="fg-url">
    <span class="fg-label">v3 source</span>
    <code>@SourceUrl</code>
    <button type="button" class="fg-copy" data-copy="@SourceUrl" title="Copy this URL" aria-label="Copy the v3 source URL">Copy</button>
</p>

<details class="fg-more fg-connect">
    <summary>Connect a client</summary>
    <Instructions Lines="@InstructionTemplates.Render(feed.FeedInstructions, InstructionTemplates.DefaultFeed, new Dictionary<string, string> { ["feed"] = feed.Name, ["feedUrl"] = FeedUrl, ["v3Url"] = SourceUrl })" />
</details>

@* A pull posts back here with what it did. *@
<PullOutcome />

<div class="fg-search-row">
    <form method="get" class="fg-search-bar">
        <input type="search" name="q" value="@Q" placeholder="Search id, title, tags, description" aria-label="Search packages" />
        @if (IsProxy)
        {
            @* Inside the bar rather than under it: where a result may come from is part of the search,
               not a separate question. app.js submits on change so choosing is one action. *@
            <select name="src" data-autosubmit aria-label="Where the package comes from">
                <option value="" selected="@(Src.Length == 0)">Everywhere</option>
                <option value="local" selected="@(Src == "local")">Local</option>
                <option value="cached" selected="@(Src == "cached")">Cached</option>
                <option value="upstream" selected="@(Src == "upstream")">Upstream only</option>
            </select>
        }
        <button type="submit">Search</button>
        @* Off by default, like a gallery: the version a row shows is the latest stable one. *@
        <label class="fg-check fg-search-toggle" title="Show prerelease versions as the latest">
            <input type="checkbox" name="pre" value="1" checked="@IncludePrerelease" data-autosubmit /> Prerelease
        </label>
    </form>
    @if (Q?.Length > 0 || Src.Length > 0 || IncludePrerelease)
    {
        <a class="fg-btn fg-btn-ghost" href="/feeds/@feed.Name">Clear</a>
    }
</div>

<p class="fg-result-count">
    @rows.Count shown@(total > rows.Count ? $" of {total}" : "")@(string.IsNullOrWhiteSpace(Q) ? "" : $" matching “{Q}”").
    @if (IsProxy && string.IsNullOrWhiteSpace(Q))
    {
        <text>Browsing shows what this feed holds; search to reach the upstreams as well.</text>
    }
</p>

@if (rows.Count == 0)
{
    <p class="fg-empty">Nothing here yet.</p>
}
else
{
    <div class="fg-table-wrap">
        <table class="fg-table">
            <thead>
                <tr>
                    <th aria-sort="@AriaSort(PackageSortField.Id)"><a class="fg-sort @SortClass(PackageSortField.Id)" href="@SortLink(PackageSortField.Id)">Package</a></th>
                    <th>Latest</th>
                    <th aria-sort="@AriaSort(PackageSortField.Versions)"><a class="fg-sort @SortClass(PackageSortField.Versions)" href="@SortLink(PackageSortField.Versions)">Versions</a></th>
                    <th>Source</th>
                    <th aria-sort="@AriaSort(PackageSortField.Downloads)"><a class="fg-sort @SortClass(PackageSortField.Downloads)" href="@SortLink(PackageSortField.Downloads)">Downloads</a></th>
                    <th aria-sort="@AriaSort(PackageSortField.LastPublished)"><a class="fg-sort @SortClass(PackageSortField.LastPublished)" href="@SortLink(PackageSortField.LastPublished)">Last published</a></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        @* Always a link, including for a package only an upstream holds: its page lists
                           every version the upstreams report and describes them, which is the whole point
                           of a proxy feed. Leaving those rows as plain text made the one case a proxy
                           exists for the one case you could not click. *@
                        <td><a href="@PackageLink(row.Id)">@Display.BreakableId(row.Id)</a></td>
                        <td class="fg-num">@row.Latest @if (row.Latest.Contains('-')) { <span class="fg-badge fg-badge-warn">prerelease</span> }</td>
                        <td class="fg-num">@(row.Versions > 0 ? row.Versions.ToString(CultureInfo.InvariantCulture) : Display.None)</td>
                        <td>
                            <span class="fg-badge @SourceBadge(row.Source)">@row.Source</span>
                            @if (row.Upstream.Length > 0)
                            {
                                <div class="fg-small fg-muted" title="The upstream this package comes from">@row.Upstream</div>
                            }
                        </td>
                        <td class="fg-num">@(row.Local ? Display.Count(row.Downloads) : Display.None)</td>
                        <td class="fg-num">@Display.Date(row.Published)</td>
                        <td class="fg-cell-actions">
                            @if (level >= FeedAccessLevel.Publish && !row.Local)
                            {
                                @* Fetches this version from the upstream and keeps it, the way a client's
                                   first download would. Useful before a machine that has no internet needs it. *@
                                <form method="post" action="/admin/feeds/@feed.Name/pull" data-busy="Pulling with its dependencies...">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <input type="hidden" name="version" value="@row.Latest" />
                                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                    <button type="submit" class="fg-btn fg-btn-sm fg-btn-icon fg-icon-pull" title="Pull @row.Id @row.Latest into this feed, with its dependencies" aria-label="Pull @row.Id @row.Latest into this feed"></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="fg-pager">
        @if (Page > 1)
        {
            <a class="fg-btn fg-btn-sm" href="@PageLink(Page - 1)">← Previous</a>
        }
        <span class="fg-pager-info">Page @Page</span>
        @if (Page * PageSize < total)
        {
            <a class="fg-btn fg-btn-sm" href="@PageLink(Page + 1)">Next →</a>
        }
    </nav>
}

@code {
    private const int PageSize = 50;

    private Feed? feed;
    private int total;
    private List<Row> rows = [];

    [Parameter]
    public string Name { get; set; } = "";

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    /// <summary>Where results may come from: empty, <c>local</c>, <c>cached</c> or <c>upstream</c>.</summary>
    [SupplyParameterFromQuery(Name = "src")]
    private string? Source { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int Page { get; set; }

    [SupplyParameterFromQuery(Name = "pre")]
    private string? Pre { get; set; }

    private bool IncludePrerelease => Pre == "1";

    /// <summary>A package's page, with the prerelease choice carried over so it opens on the version the row shows.</summary>
    private string PackageLink(string id) =>
        $"/feeds/{Uri.EscapeDataString(Name)}/packages/{Uri.EscapeDataString(id)}" + (IncludePrerelease ? "?pre=1" : "");

    [SupplyParameterFromQuery(Name = "sort")]
    private string? SortField { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    private string? SortDirection { get; set; }

    private PackageSort? Sort => PackageSort.Parse(SortField, SortDirection);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string FeedUrl => $"{PublicUrls.ClientBase(HttpContext, feed!.ClientBaseUrl)}/nuget/{Uri.EscapeDataString(feed!.Name)}";

    private string SourceUrl => $"{FeedUrl}/v3/index.json";

    /// <summary>Reading is open on a feed that allows it; the buttons need the admin claim.</summary>
    /// <summary>What the signed-in account, or a visitor, may do with this feed.</summary>
    private FeedAccessLevel level;

    /// <summary>Where a button press returns to, so a pull does not lose the search that found it.</summary>
    private string ReturnUrl => HttpContext.Request.Path + HttpContext.Request.QueryString;

    private bool IsProxy => feed!.Upstreams.Count > 0;

    private string Src => (Source ?? "").Trim().ToLowerInvariant();

    protected override async Task OnInitializedAsync()
    {
        Page = Math.Max(1, Page);
        feed = await Feeds.FindAsync(Name, HttpContext.RequestAborted);
        // An asset directory is not a package feed; it has its own page under /assets.
        level = feed is null ? FeedAccessLevel.None : await Access.LevelAsync(feed, FiGetApp.Actor(HttpContext.User), HttpContext.RequestAborted);
        if (feed is { Kind: FeedKind.Assets } || level < FeedAccessLevel.Read)
        {
            // A feed that needs credentials is not confirmed to exist either.
            feed = null;
        }

        if (feed is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }


        if (Src != "upstream")
        {
            await AddLocalAsync();
        }

        // A proxy feed searches its upstreams too: a package nobody has cached yet must still be findable,
        // which is what makes one feed cover both what was pushed here and what the gallery has.
        if (IsProxy && Src != "local" && Src != "cached" && !string.IsNullOrWhiteSpace(Q))
        {
            await AddUpstreamAsync();
        }
    }

    private async Task AddLocalAsync()
    {
        var filter = new PackageSearchFilter(SearchQueryParser.Parse(Q), IncludePrerelease: true, IncludeSemVer2: true, PackageTypeLower: null, Sort);
        var page = await Packages.SearchAsync(feed!.Key, filter, (Page - 1) * PageSize, PageSize, HttpContext.RequestAborted);
        total = page.TotalHits;

        var packages = (await Packages.GetPackagesAsync(page.PackageKeys, HttpContext.RequestAborted)).ToDictionary(p => p.Key);
        foreach (var key in page.PackageKeys)
        {
            if (!packages.TryGetValue(key, out var package))
            {
                continue;
            }

            var pushed = package.Versions.Any(v => v.Origin == PackageOrigin.Pushed);
            if ((Src == "local" && !pushed) || (Src == "cached" && pushed))
            {
                continue;
            }

            // The same merge the package page makes, from what is already stored about the upstream, so the version a row
            // shows is the one its page opens on: a cached old version must not read as the latest while the gallery has newer.
            var upstream = IsProxy ? await Connector.StoredUpstreamCandidatesAsync(feed!, package, package.IdLower, HttpContext.RequestAborted) : new UpstreamCandidates([], "");
            var list = VersionListBuilder.Build(package.Versions.Select(VersionListBuilder.ToCandidate).Concat(upstream.Versions), includeSemVer2: true);
            var latest = list.Shown(IncludePrerelease)!;
            rows.Add(new Row(
                package.Id,
                latest.Payload!.NormalizedVersion,
                package.Versions.Count,
                pushed ? "Local" : "Cached",
                package.Versions.Sum(v => v.Downloads),
                package.Versions.Max(v => v.PublishedUtc),
                Local: true,
                Upstream: pushed ? "" : upstream.Upstream));
        }
    }

    private async Task AddUpstreamAsync()
    {
        var known = rows.Select(r => r.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var hits = await Connector.SearchUpstreamsAsync(feed!, Q!, includePrerelease: IncludePrerelease, PageSize, HttpContext.RequestAborted);

        foreach (var hit in hits.Where(h => !known.Contains(h.Id)))
        {
            rows.Add(new Row(
                hit.Id,
                hit.Version.ToNormalizedString(),
                Versions: 0,
                "Upstream",
                hit.Downloads,
                Published: null,
                Local: false,
                Upstream: hit.Upstream));
        }

        total = Math.Max(total, rows.Count);
    }

    /// <summary>
    /// Held here reads as settled; upstream-only reads as somewhere else. Keyed on the label the row
    /// already carries, so renaming one without the other leaves the badge silently unstyled.
    /// </summary>
    private static string SourceBadge(string source) => source switch
    {
        "Local" => "fg-badge-accent",
        "Cached" => "fg-badge-info",
        _ => "fg-badge-plain",
    };

    private string PageLink(int page) => Link(page, Sort);

    /// <summary>
    /// A header's link: the first click on a column orders it the way it is usually wanted - ids A to Z, numbers and
    /// dates largest first - and clicking the current column again reverses it. Always back to page one.
    /// </summary>
    private string SortLink(PackageSortField field)
    {
        var current = Sort;
        var descending = current?.Field == field ? !current.Descending : field != PackageSortField.Id;
        return Link(1, new PackageSort(field, descending));
    }

    private string SortClass(PackageSortField field) =>
        Sort?.Field == field ? (Sort.Descending ? "fg-sort-desc" : "fg-sort-asc") : "";

    private string? AriaSort(PackageSortField field) =>
        Sort?.Field == field ? (Sort.Descending ? "descending" : "ascending") : null;

    private string Link(int page, PackageSort? sort)
    {
        var link = $"/feeds/{Uri.EscapeDataString(Name)}?page={page}";
        if (!string.IsNullOrWhiteSpace(Q))
        {
            link += "&q=" + Uri.EscapeDataString(Q);
        }

        if (Src.Length > 0)
        {
            link += "&src=" + Uri.EscapeDataString(Src);
        }

        if (sort is not null)
        {
            link += "&sort=" + sort.Field.ToString().ToLowerInvariant() + (sort.Descending ? "&dir=desc" : "");
        }

        if (IncludePrerelease)
        {
            link += "&pre=1";
        }

        return link;
    }

    /// <summary>A row of the table. Upstream-only packages have no local versions, downloads or date.</summary>
    private sealed record Row(string Id, string Latest, int Versions, string Source, long Downloads, DateTime? Published, bool Local, string Upstream = "");
}
