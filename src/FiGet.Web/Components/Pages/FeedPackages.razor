@page "/feeds/{Name}"
@using System.Security.Claims
@using FiGet.Core.Connectors
@using FiGet.Core.Search
@using FiGet.Core.Versions
@inject IFeedStore Feeds
@inject IPackageStore Packages
@inject ConnectorService Connector

<PageTitle>@Name · FiGet</PageTitle>

@if (feed is null)
{
    <h1>Feed not found</h1>
    <p>
        There is no feed named <code>@Name</code>, or it cannot be read without signing in.
        <a href="/">Back to feeds</a>.
    </p>
    return;
}

<h1>@feed.Name</h1>
<p class="muted url-cell">
    v3 source: <code>@SourceUrl</code>
    <button type="button" class="copy" data-copy="@SourceUrl" title="Copy this URL" aria-label="Copy the v3 source URL">Copy</button>
    @if (IsAdmin)
    {
        <a href="/feeds/@feed.Name/settings">Settings</a>
    }
</p>

<form method="get" class="search">
    <input type="search" name="q" value="@Q" placeholder="Search id, title, tags, description" aria-label="Search packages" />
    @if (IsProxy)
    {
        <select name="src" aria-label="Where the package comes from">
            <option value="" selected="@(Src.Length == 0)">Everywhere</option>
            <option value="local" selected="@(Src == "local")">Pushed here</option>
            <option value="cached" selected="@(Src == "cached")">Cached</option>
            <option value="upstream" selected="@(Src == "upstream")">Upstream only</option>
        </select>
    }
    <button type="submit">Search</button>
    @if (Q?.Length > 0 || Src.Length > 0)
    {
        <a class="clear" href="/feeds/@feed.Name">Clear</a>
    }
</form>

<p class="muted">
    @rows.Count shown@(total > rows.Count ? $" of {total}" : "")@(string.IsNullOrWhiteSpace(Q) ? "" : $" matching “{Q}”").
    @if (IsProxy && string.IsNullOrWhiteSpace(Q))
    {
        <text>Browsing shows what this feed holds; search to reach the upstreams as well.</text>
    }
</p>

@if (rows.Count > 0)
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Package</th><th>Latest</th><th>Versions</th><th>Source</th><th>Downloads</th><th>Last published</th></tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td>
                            @if (row.Local)
                            {
                                <a href="/feeds/@feed.Name/packages/@row.Id">@row.Id</a>
                            }
                            else
                            {
                                @row.Id
                            }
                        </td>
                        <td>@row.Latest</td>
                        <td>@(row.Versions > 0 ? row.Versions.ToString(CultureInfo.InvariantCulture) : "—")</td>
                        <td><span class="badge">@row.Source</span></td>
                        <td>@(row.Local ? row.Downloads.ToString("N0", CultureInfo.InvariantCulture) : "—")</td>
                        <td>@(row.Published is null ? "—" : row.Published.Value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="pager">
        @if (Page > 1)
        {
            <a href="@PageLink(Page - 1)">← Previous</a>
        }
        @if (Page * PageSize < total)
        {
            <a href="@PageLink(Page + 1)">Next →</a>
        }
    </nav>
}

@code {
    private const int PageSize = 50;

    private Feed? feed;
    private int total;
    private List<Row> rows = [];

    [Parameter]
    public string Name { get; set; } = "";

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    /// <summary>Where results may come from: empty, <c>local</c>, <c>cached</c> or <c>upstream</c>.</summary>
    [SupplyParameterFromQuery(Name = "src")]
    private string? Source { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int Page { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string SourceUrl => $"{PublicUrls.Feed(HttpContext, feed!.Name)}/v3/index.json";

    /// <summary>Reading is open on a feed that allows it; the buttons need the admin claim.</summary>
    private bool IsAdmin => HttpContext.User.HasClaim(ClaimTypes.Role, "admin");

    private bool IsProxy => feed!.Upstreams.Count > 0;

    private string Src => (Source ?? "").Trim().ToLowerInvariant();

    protected override async Task OnInitializedAsync()
    {
        Page = Math.Max(1, Page);
        feed = await Feeds.FindAsync(Name, HttpContext.RequestAborted);
        if (feed is not null && !feed.AnonymousRead && !IsAdmin)
        {
            // A feed that needs credentials is not confirmed to exist either.
            feed = null;
        }

        if (feed is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        if (Src != "upstream")
        {
            await AddLocalAsync();
        }

        // A proxy feed searches its upstreams too: a package nobody has cached yet must still be findable,
        // which is what makes one feed cover both what was pushed here and what the gallery has.
        if (IsProxy && Src != "local" && Src != "cached" && !string.IsNullOrWhiteSpace(Q))
        {
            await AddUpstreamAsync();
        }
    }

    private async Task AddLocalAsync()
    {
        var filter = new PackageSearchFilter(SearchQueryParser.Parse(Q), IncludePrerelease: true, IncludeSemVer2: true, PackageTypeLower: null);
        var page = await Packages.SearchAsync(feed!.Key, filter, (Page - 1) * PageSize, PageSize, HttpContext.RequestAborted);
        total = page.TotalHits;

        var packages = (await Packages.GetPackagesAsync(page.PackageKeys, HttpContext.RequestAborted)).ToDictionary(p => p.Key);
        foreach (var key in page.PackageKeys)
        {
            if (!packages.TryGetValue(key, out var package))
            {
                continue;
            }

            var pushed = package.Versions.Any(v => v.Origin == PackageOrigin.Pushed);
            if ((Src == "local" && !pushed) || (Src == "cached" && pushed))
            {
                continue;
            }

            var list = VersionListBuilder.BuildLocal(package.Versions, includeSemVer2: true);
            var latest = list.Latest(includePrerelease: true) ?? list[^1];
            rows.Add(new Row(
                package.Id,
                latest.Payload!.NormalizedVersion,
                package.Versions.Count,
                pushed ? "Pushed here" : "Cached",
                package.Versions.Sum(v => v.Downloads),
                package.Versions.Max(v => v.PublishedUtc),
                Local: true));
        }
    }

    private async Task AddUpstreamAsync()
    {
        var known = rows.Select(r => r.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var hits = await Connector.SearchUpstreamsAsync(feed!, Q!, includePrerelease: true, PageSize, HttpContext.RequestAborted);

        foreach (var hit in hits.Where(h => !known.Contains(h.Id)))
        {
            rows.Add(new Row(
                hit.Id,
                hit.Version.ToNormalizedString(),
                Versions: 0,
                "Upstream",
                hit.Downloads,
                Published: null,
                Local: false));
        }

        total = Math.Max(total, rows.Count);
    }

    private string PageLink(int page)
    {
        var link = $"/feeds/{Uri.EscapeDataString(Name)}?page={page}";
        if (!string.IsNullOrWhiteSpace(Q))
        {
            link += "&q=" + Uri.EscapeDataString(Q);
        }

        if (Src.Length > 0)
        {
            link += "&src=" + Uri.EscapeDataString(Src);
        }

        return link;
    }

    /// <summary>A row of the table. Upstream-only packages have no local versions, downloads or date.</summary>
    private sealed record Row(string Id, string Latest, int Versions, string Source, long Downloads, DateTime? Published, bool Local);
}
