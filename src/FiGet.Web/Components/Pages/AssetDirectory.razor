@page "/assets/{Name}"
@using System.Security.Claims
@inject FiGet.Application.Accounts.FeedAccessService Access
@inject IFeedStore Feeds
@inject Microsoft.Extensions.Options.IOptions<UploadOptions> Upload

@if (directory is null)
{
    <PageTitle>Not found · FiGet</PageTitle>
    <h1>Asset directory not found</h1>
    <p class="fg-muted">
        There is no asset directory named <code>@Name</code>, or it cannot be read without signing in.
        <a href="/assets">Back to assets</a>.
    </p>
    return;
}

<PageTitle>@directory.Name · FiGet</PageTitle>
<AssetBrowser Feed="directory" Path="@Folder" Level="level" SignedIn="FiGetApp.Actor(HttpContext.User) is not null" MaxAssetBytes="Upload.Value.MaxAssetSizeBytes" />

@code {
    private Feed? directory;

    [Parameter]
    public string Name { get; set; } = "";

    [SupplyParameterFromQuery(Name = "path")]
    private string? Folder { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private FeedAccessLevel level;

    protected override async Task OnInitializedAsync()
    {
        var feed = await Feeds.FindAsync(Name, HttpContext.RequestAborted);

        // A package feed is not an asset directory, and one that needs credentials is not confirmed to exist.
        level = feed is null ? FeedAccessLevel.None : await Access.LevelAsync(feed, FiGetApp.Actor(HttpContext.User), HttpContext.RequestAborted);
        // Browsing is a listing: a stranger needs the directory's listing switch, not only its anonymous download.
        var signedIn = FiGetApp.Actor(HttpContext.User) is not null;
        directory = feed is { Kind: FeedKind.Assets } && level >= FeedAccessLevel.Read && (signedIn || feed.AnonymousList) && FiGet.Http.FeedAccess.ReachableFrom(HttpContext, feed) ? feed : null;
        if (directory is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
