@page "/account/profile"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using FiGet.Application.Accounts
@using FiGet.Application.Tokens
@inject AccountService Accounts
@inject IUserStore Users
@inject AccessTokenService TokenService
@inject IAccessTokenStore TokenStore
@inject IFeedStore Feeds
@inject FeedAccessService Access
@inject TimeProvider Time
@inject IOidcProviderStore Providers
@inject IExternalLoginStore Logins
@inject FiGet.Http.AuditLog Audit

@*
    The signed-in account's own page: profile, password, sign-in providers and personal API keys.

    Connecting a provider is the only way a provider identity joins an existing account: sign-in never matches one by name
    or email (docs/auth-plan.md). Disconnecting the last way to sign in - no password, one provider - is refused.

    A personal key acts as its owner: its access and feed are limits, and at every use it does the lower of those and
    what the account may do then. So the feed list offers only feeds the account can read.
*@

<PageTitle>Profile · FiGet</PageTitle>

@if (user is null)
{
    return;
}

<h1>@user.UserName</h1>

@if (message is not null)
{
    <div class="fg-alert fg-alert-ok" role="status">@message</div>
}
@if (problem is not null)
{
    <div class="fg-alert fg-alert-danger" role="alert">@problem</div>
}

<section class="fg-panel">
    <h2>Profile</h2>
    <EditForm Model="Input!" FormName="profile" OnValidSubmit="SaveAsync" method="post" class="fg-form">
        <div class="fg-field">
            <label for="display-name">Display name</label>
            <InputText id="display-name" @bind-Value="Input!.DisplayName" maxlength="128" />
        </div>
        <div class="fg-field">
            <label for="email">Email</label>
            <InputText id="email" type="email" @bind-Value="Input!.Email" maxlength="256" />
        </div>
        <button type="submit" class="fg-btn fg-btn-primary">Save profile</button>
    </EditForm>

    <dl class="fg-facts">
        <dt>Role</dt><dd>@RoleName(user.Role)</dd>
        <dt>Member since</dt><dd class="fg-num">@user.CreatedUtc.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
        <dt>Last sign-in</dt><dd class="fg-num">@(user.LastSignInUtc?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) ?? Display.None)</dd>
    </dl>
</section>

<section class="fg-panel">
    <h2>Password</h2>
    @if (user.PasswordHash is null)
    {
        <p class="fg-muted fg-small">This account signs in through a sign-in provider and has no password here.</p>
    }
    else
    {
        <p><a class="fg-btn" href="/account/password">Change password</a></p>
    }
</section>

@if (providerRows.Count > 0)
{
    <section class="fg-panel" id="providers">
        <h2>Sign-in providers</h2>
        <p class="fg-muted fg-small">Connect a provider to sign in to this account with it.</p>
        <div class="fg-table-wrap">
            <table class="fg-table">
                <tbody>
                    @foreach (var (provider, login) in providerRows)
                    {
                        <tr>
                            <td><strong>@provider.DisplayName</strong></td>
                            <td class="fg-small fg-muted">
                                @if (login is not null)
                                {
                                    <span>Connected@(string.IsNullOrEmpty(login.Email) ? "" : " as " + login.Email) since @login.LinkedUtc.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                                }
                                else if (!provider.Enabled)
                                {
                                    <span>Not available</span>
                                }
                            </td>
                            <td class="fg-cell-actions">
                                @if (login is not null)
                                {
                                    <form method="post" action="/account/external/logins/@login.Key/remove">
                                        <AntiforgeryToken />
                                        <button type="submit" class="fg-btn fg-btn-sm fg-btn-danger">Disconnect</button>
                                    </form>
                                }
                                else if (provider.Enabled)
                                {
                                    <form method="post" action="/account/external/@provider.Slug/link">
                                        <AntiforgeryToken />
                                        <button type="submit" class="fg-btn fg-btn-sm">Connect</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="fg-panel" id="keys">
    <h2>API keys</h2>
    <p class="fg-muted fg-small">
        For NuGet and PowerShell clients: send a key as <code>X-NuGet-ApiKey</code>, or as the password of Basic
        authentication. A key does what your account may do, never more, and stops working when your access changes or
        your account is disabled. It is shown once, when it is created.
    </p>

    @if (createdKey is not null)
    {
        <div class="fg-secret" role="status">
            <p><strong>Key “@createdKey.Token.Name” created.</strong> Copy it now; it will not be shown again.</p>
            <div class="fg-url">
                <pre><code>@createdKey.Secret</code></pre>
                <button type="button" class="fg-copy" data-copy="@createdKey.Secret" title="Copy this key" aria-label="Copy the new key">Copy</button>
            </div>
        </div>
    }

    @if (keys.Count > 0)
    {
        <div class="fg-table-wrap">
            <table class="fg-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Prefix</th>
                        <th>Access</th>
                        <th>Feed</th>
                        <th>Last used</th>
                        <th>Expires</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var key in keys)
                    {
                        var active = key.RevokedUtc is null && (key.ExpiresUtc is null || key.ExpiresUtc > now);
                        <tr class="@(active ? "" : "is-inactive")">
                            <td>@key.Name</td>
                            <td><code>@key.Prefix…</code></td>
                            <td>@(key.Scopes.HasFlag(TokenScopes.Push) ? "Read and publish" : "Read")</td>
                            <td>@(key.Feed?.Name ?? "All feeds")</td>
                            <td class="fg-num">@Date(key.LastUsedUtc)</td>
                            <td>
                                @if (key.RevokedUtc is not null)
                                {
                                    <span class="fg-badge fg-badge-danger">Revoked</span>
                                }
                                else
                                {
                                    <span class="fg-num">@Date(key.ExpiresUtc, "Never")</span>
                                }
                            </td>
                            <td class="fg-cell-actions">
                                @if (key.RevokedUtc is null)
                                {
                                    <form method="post" @formname="@($"revoke-key-{key.Key}")" @onsubmit="() => RevokeKeyAsync(key.Key)">
                                        <AntiforgeryToken />
                                        <button type="submit" class="fg-btn fg-btn-sm fg-btn-danger">Revoke</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <Accordion Id="create-key" Title="Create a key" Open="@(keys.Count == 0)" FormName="create-key" Succeeded="@(createdKey is not null)">
    <EditForm Model="NewKey!" FormName="create-key" OnValidSubmit="CreateKeyAsync" method="post" class="fg-form">
        <DataAnnotationsValidator />
        <div class="fg-field">
            <label for="key-name">Name</label>
            <InputText id="key-name" @bind-Value="NewKey!.Name" maxlength="128" placeholder="for example: laptop" />
            <ValidationMessage For="() => NewKey!.Name" />
        </div>
        <div class="fg-field">
            <label for="key-access">Access</label>
            <InputSelect id="key-access" @bind-Value="NewKey!.Access">
                <option value="@KeyInput.ReadAccess">Read</option>
                <option value="@KeyInput.PublishAccess">Read and publish</option>
            </InputSelect>
        </div>
        <div class="fg-field">
            <label for="key-feed">Feed</label>
            <InputSelect id="key-feed" @bind-Value="NewKey!.FeedName">
                <option value="">All feeds</option>
                @foreach (var feed in readableFeeds)
                {
                    <option value="@feed.Name">@feed.Name@(feed.Kind == FeedKind.Assets ? " (asset directory)" : "")</option>
                }
            </InputSelect>
        </div>
        <div class="fg-field">
            <label for="key-expiry">Expires after (days, empty for never)</label>
            <InputNumber id="key-expiry" @bind-Value="NewKey!.ExpiresInDays" min="1" />
        </div>
        @if (keyError is not null)
        {
            <p class="fg-error">@keyError</p>
        }
        <button type="submit" class="fg-btn fg-btn-primary">Create key</button>
    </EditForm>
    </Accordion>
</section>

@code {
    private User? user;
    private string? message;
    private string? problem;
    private IReadOnlyList<(OidcProvider Provider, ExternalLogin? Login)> providerRows = [];
    private IReadOnlyList<AccessToken> keys = [];
    private IReadOnlyList<Feed> readableFeeds = [];
    private CreatedToken? createdKey;
    private string? keyError;
    private DateTime now;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "profile")]
    private ProfileInput? Input { get; set; }

    [SupplyParameterFromForm(FormName = "create-key")]
    private KeyInput? NewKey { get; set; }

    [SupplyParameterFromQuery(Name = "saved")]
    private string? Saved { get; set; }

    [SupplyParameterFromQuery(Name = "linked")]
    private string? Linked { get; set; }

    [SupplyParameterFromQuery(Name = "unlinked")]
    private string? Unlinked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        NewKey ??= new();
        await LoadAsync();
        Input ??= new ProfileInput { DisplayName = user?.DisplayName ?? "", Email = user?.Email ?? "" };
        if (Saved == "password")
        {
            message = "Password changed.";
        }

        (message, problem) = (Linked, Unlinked) switch
        {
            ("ok", _) => ("Provider connected. You can sign in to this account with it.", problem),
            ("already", _) => ("That provider identity was already connected to this account.", problem),
            ("taken", _) => (message, "That provider identity belongs to another account. Sign in with it to reach that account."),
            ("expired" or "unknown", _) => (message, "Connecting did not start. Reload the page and try again."),
            (_, "ok") => ("Provider disconnected.", problem),
            (_, "last") => (message, "That is this account's only way to sign in. Set a password or connect another provider first."),
            _ => (message, problem),
        };
    }

    private async Task LoadAsync()
    {
        var actor = FiGetApp.Actor(HttpContext.User);
        user = actor is null ? null : await Users.FindAsync(actor.Key, HttpContext.RequestAborted);
        if (actor is null)
        {
            return;
        }

        var links = await Logins.ListForUserAsync(actor.Key, HttpContext.RequestAborted);
        providerRows = (await Providers.ListAsync(HttpContext.RequestAborted))
            .Select(p => (Provider: p, Login: links.FirstOrDefault(l => l.ProviderKey == p.Key)))
            .Where(row => row.Provider.Enabled || row.Login is not null)
            .ToList();

        now = Time.GetUtcNow().UtcDateTime;
        keys = await TokenStore.ListOwnedAsync(actor.Key, HttpContext.RequestAborted);
        var feeds = await Feeds.ListAsync(HttpContext.RequestAborted);
        var levels = await Access.LevelsAsync(feeds, actor, HttpContext.RequestAborted);
        readableFeeds = feeds.Where(f => levels.GetValueOrDefault(f.Key) >= FeedAccessLevel.Read).OrderBy(f => f.NameLower).ToList();
    }

    private async Task SaveAsync()
    {
        await Accounts.UpdateProfileAsync(user!.Key, Input!.DisplayName, Input.Email, HttpContext.RequestAborted);
        Audit.Record(HttpContext, "account.profile", user.UserName);
        message = "Profile saved.";
        await LoadAsync();
    }

    private async Task CreateKeyAsync()
    {
        var actor = FiGetApp.Actor(HttpContext.User)!;
        var scopes = NewKey!.Access == KeyInput.PublishAccess ? TokenScopes.Push | TokenScopes.Delete : TokenScopes.Read;
        Feed? feed = null;
        if (!string.IsNullOrEmpty(NewKey.FeedName) && (feed = await Feeds.FindAsync(NewKey.FeedName, HttpContext.RequestAborted)) is null)
        {
            keyError = "That feed does not exist.";
            return;
        }

        DateTime? expires = NewKey.ExpiresInDays is > 0 ? Time.GetUtcNow().UtcDateTime.AddDays(NewKey.ExpiresInDays.Value) : null;
        var result = await TokenService.CreatePersonalKeyAsync(actor, NewKey.Name, scopes, feed, expires, HttpContext.RequestAborted);
        if (result.Created is null)
        {
            keyError = result.Status == TokenCreateStatus.AboveYourRights
                ? $"Your account cannot {(scopes.HasFlag(TokenScopes.Push) ? "publish to" : "read")} that feed, so a key for it cannot either."
                : "Enter a name.";
            return;
        }

        createdKey = result.Created;
        Audit.Record(
            HttpContext,
            "key.create",
            $"{user!.UserName}/{result.Created.Token.Name}",
            $"scopes={scopes} feed={feed?.Name ?? "all"} expires={(expires is null ? "never" : expires.Value.ToString("u", CultureInfo.InvariantCulture))}");
        NewKey = new();
        await LoadAsync();
    }

    private async Task RevokeKeyAsync(int key)
    {
        var actor = FiGetApp.Actor(HttpContext.User)!;
        var revoked = keys.FirstOrDefault(k => k.Key == key);
        if (await TokenService.RevokeOwnAsync(actor, key, HttpContext.RequestAborted))
        {
            Audit.Record(HttpContext, "key.revoke", $"{user!.UserName}/{revoked?.Name ?? key.ToString(CultureInfo.InvariantCulture)}");
            message = "Key revoked.";
        }

        await LoadAsync();
    }

    private static string Date(DateTime? value, string empty = "—") =>
        value is null ? empty : value.Value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    public static string RoleName(UserRole role) => role switch
    {
        UserRole.SuperAdmin => "Super admin",
        UserRole.Admin => "Admin",
        _ => "User",
    };

    private sealed class KeyInput
    {
        public const string ReadAccess = "read";
        public const string PublishAccess = "publish";

        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(128)]
        public string Name { get; set; } = "";

        public string Access { get; set; } = ReadAccess;

        public string FeedName { get; set; } = "";

        public int? ExpiresInDays { get; set; }
    }

    private sealed class ProfileInput
    {
        public string DisplayName { get; set; } = "";

        public string Email { get; set; } = "";
    }
}
