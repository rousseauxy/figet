@page "/account/password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using FiGet.Application.Accounts
@inject AccountService Accounts
@inject IUserStore Users
@inject NavigationManager Navigation
@inject FiGet.Http.AuditLog Audit

<PageTitle>Change password · FiGet</PageTitle>

<section class="fg-signin">
    <div class="fg-card">
        <div class="fg-card-header">@(mustChange ? "Choose a new password" : "Change password")</div>
        <div class="fg-card-body">
            @if (mustChange)
            {
                <p class="fg-muted fg-small">
                    This account's password was set for it, so a new one is needed before anything else. At least
                    @AccountService.MinimumPasswordLength characters.
                </p>
            }
            else
            {
                <p class="fg-muted fg-small">At least @AccountService.MinimumPasswordLength characters.</p>
            }

            @if (!hasPassword)
            {
                <p class="fg-muted">This account signs in through a sign-in provider and has no password here.</p>
            }
            else
            {
                <EditForm Model="Input!" FormName="change-password" OnValidSubmit="ChangeAsync" method="post" class="fg-form">
                    <DataAnnotationsValidator />
                    <div class="fg-field">
                        <label for="current-password">Current password</label>
                        <InputText id="current-password" type="password" autocomplete="current-password" @bind-Value="Input!.Current" />
                        <ValidationMessage For="() => Input!.Current" />
                    </div>
                    <div class="fg-field">
                        <label for="new-password">New password</label>
                        <InputText id="new-password" type="password" autocomplete="new-password" @bind-Value="Input!.New" />
                        <ValidationMessage For="() => Input!.New" />
                    </div>
                    <div class="fg-field">
                        <label for="confirm-password">New password again</label>
                        <InputText id="confirm-password" type="password" autocomplete="new-password" @bind-Value="Input!.Confirm" />
                        <ValidationMessage For="() => Input!.Confirm" />
                    </div>
                    @if (error is not null)
                    {
                        <p class="fg-error">@error</p>
                    }
                    <button type="submit" class="fg-btn fg-btn-primary">Save password</button>
                </EditForm>
            }
        </div>
    </div>
</section>

@code {
    private string? error;
    private bool mustChange;
    private bool hasPassword = true;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "change-password")]
    private PasswordInput? Input { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        var actor = FiGetApp.Actor(HttpContext.User);
        var user = actor is null ? null : await Users.FindAsync(actor.Key, HttpContext.RequestAborted);
        mustChange = user?.MustChangePassword == true;
        hasPassword = user?.PasswordHash is not null;
    }

    private async Task ChangeAsync()
    {
        if (Input!.New != Input.Confirm)
        {
            error = "The two new passwords are not the same.";
            return;
        }

        var actor = FiGetApp.Actor(HttpContext.User)!;
        var outcome = await Accounts.ChangeOwnPasswordAsync(actor.Key, Input.Current, Input.New, HttpContext.RequestAborted);
        switch (outcome)
        {
            case AccountOutcome.Done:
                break;
            case AccountOutcome.WrongPassword:
                error = "The current password is not right.";
                return;
            case AccountOutcome.PasswordTooShort:
                error = $"Use at least {AccountService.MinimumPasswordLength} characters, different from the current password.";
                return;
            default:
                error = "The password could not be changed.";
                return;
        }

        // The stamp moved with the password, which ends every session of this account - including this one, so it is
        // signed in again with the new stamp rather than sent back to the sign-in page.
        var user = await Users.FindAsync(actor.Key, HttpContext.RequestAborted);
        await FiGetApp.SignInUserAsync(HttpContext, user!);
        Audit.Record(HttpContext, "account.password", user!.UserName);
        Navigation.NavigateTo(mustChange ? "/" : "/account/profile?saved=password");
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string Current { get; set; } = "";

        [Required(ErrorMessage = "Enter a new password.")]
        public string New { get; set; } = "";

        [Required(ErrorMessage = "Enter the new password again.")]
        public string Confirm { get; set; } = "";
    }
}
