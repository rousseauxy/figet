@page "/"
@using System.Security.Claims
@inject IFeedStore Feeds

<PageTitle>Feeds · FiGet</PageTitle>

@* Read-only on purpose. Everything that changes something lives in the admin area, so this page can be
   served to anyone and a reader and an admin see the same thing, bar the feeds a reader may not read. *@

<div class="fg-page-head">
    <h1>Feeds</h1>
    <span class="fg-muted fg-small">@feeds.Count feed@(feeds.Count == 1 ? "" : "s")</span>
</div>

@if (feeds.Count == 0)
{
    <p class="fg-empty">@(IsAdmin ? "No feeds yet." : "No feed on this server is readable without signing in.")</p>
}
else
{
    <div class="fg-table-wrap">
        <table class="fg-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>Read</th>
                    <th>On existing version</th>
                    <th>Delete</th>
                    <th>URL</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var feed in feeds)
                {
                    var url = SourceUrl(feed);
                    <tr>
                        <td><a href="/feeds/@feed.Name">@feed.Name</a></td>
                        <td><span class="fg-badge">@Display.Kind(feed.Kind)</span></td>
                        <td>@(feed.AnonymousRead ? "Anonymous" : "Token")</td>
                        <td>@(feed.Kind == FeedKind.Assets ? Display.None : feed.AllowOverwrite ? "Overwrite" : "Reject (409)")</td>
                        <td>@(feed.Kind == FeedKind.Assets ? Display.None : feed.DeletionBehavior.ToString())</td>
                        <td>
                            <div class="fg-url">
                                <code>@url</code>
                                <button type="button" class="fg-copy" data-copy="@url" title="Copy this URL" aria-label="Copy the URL of @feed.Name">Copy</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (IsAdmin)
{
    <p class="fg-result-count">Creating feeds, upstreams and tokens lives in the <a href="/admin/feeds">admin area</a>.</p>
}

@code {
    private IReadOnlyList<Feed> feeds = [];

    /// <summary>
    /// Reading is open, managing is not: a visitor who has not signed in sees the feeds that allow
    /// anonymous reads, and nothing else.
    /// </summary>
    private bool IsAdmin => HttpContext.User.HasClaim(ClaimTypes.Role, "admin");

    /// <summary>The v3 source of a package feed; for an asset directory, where its files download from.</summary>
    private string SourceUrl(Feed feed) =>
        feed.Kind == FeedKind.Assets
            ? $"{PublicUrls.Base(HttpContext)}/endpoints/{Uri.EscapeDataString(feed.Name)}/content/"
            : $"{PublicUrls.Feed(HttpContext, feed.Name)}/v3/index.json";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var all = await Feeds.ListAsync(HttpContext.RequestAborted);
        feeds = IsAdmin ? all : all.Where(f => f.AnonymousRead).ToList();
    }
}
