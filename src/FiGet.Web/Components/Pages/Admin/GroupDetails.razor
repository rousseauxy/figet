@page "/admin/groups/{Key:int}"
@attribute [Authorize(Policy = FiGetApp.AdminPolicy)]
@layout AdminLayout
@using System.ComponentModel.DataAnnotations
@inject IGroupStore Groups
@inject IUserStore Users
@inject IOidcProviderStore Providers
@inject IFeedPermissionStore Permissions
@inject FiGet.Http.AuditLog Audit

<PageTitle>@(group?.Name ?? "Group") · admin · FiGet</PageTitle>

<p class="fg-crumbs"><a href="/admin/groups">Groups</a> <span class="fg-crumb-sep">/</span> <span>@(group?.Name ?? "Unknown")</span></p>

@if (group is null)
{
    <h1>No such group</h1>
    <p class="fg-muted">It may have been deleted. <a href="/admin/groups">Back to groups</a>.</p>
    return;
}

<h1>@group.Name</h1>

@if (Done is "added" or "removed" or "linked" or "unlinked" || saved)
{
    <div class="fg-alert fg-alert-ok" role="status">@DoneMessage</div>
}

<section class="fg-panel">
    <h2>Members</h2>
    @if (members.Count == 0)
    {
        <p class="fg-empty">Nobody yet.</p>
    }
    else
    {
        <div class="fg-table-wrap">
            <table class="fg-table">
                <tbody>
                    @foreach (var member in members)
                    {
                        <tr>
                            <td>
                                <strong>@member.UserName</strong> <span class="fg-muted fg-small">@member.DisplayName</span>
                                @if (providerMembers.Contains(member.Key))
                                {
                                    <span class="fg-badge fg-badge-info" title="Added by a sign-in provider's groups, and removed again when the provider no longer lists them">From provider</span>
                                }
                            </td>
                            <td class="fg-cell-actions">
                                <form method="post" action="/admin/groups/@group.Key/remove" data-confirm="@($"Remove {member.UserName} from {group.Name}?")" data-confirm-button="Remove">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="user" value="@member.Key" />
                                    <button type="submit" class="fg-btn fg-btn-sm fg-btn-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (candidates.Count > 0)
    {
        <form method="post" action="/admin/groups/@group.Key/add" class="fg-form fg-form-inline">
            <AntiforgeryToken />
            <div class="fg-field">
                <label for="add-member">Add an account</label>
                <select id="add-member" name="user" required>
                    @foreach (var user in candidates)
                    {
                        <option value="@user.Key">@user.UserName@(string.IsNullOrEmpty(user.DisplayName) ? "" : $" ({user.DisplayName})")</option>
                    }
                </select>
            </div>
            <button type="submit" class="fg-btn fg-btn-primary">Add member</button>
        </form>
    }
</section>

<section class="fg-panel">
    <h2>Access</h2>
    <p class="fg-muted fg-small">What this group's members get, and so what a change to the group affects. Grants are set on each feed's settings page.</p>
    @if (grants.Count == 0)
    {
        <p class="fg-empty">No feed or asset directory grants anything to this group yet.</p>
    }
    else
    {
        <div class="fg-table-wrap">
            <table class="fg-table">
                <thead>
                    <tr><th>Feed or directory</th><th>Level</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var grant in grants)
                    {
                        var settings = (grant.Kind == FeedKind.Assets ? "/admin/assets/" : "/admin/feeds/") + Uri.EscapeDataString(grant.FeedName);
                        <tr>
                            <td>
                                <a href="@settings"><strong>@grant.FeedName</strong></a>
                                @if (grant.Kind == FeedKind.Assets)
                                {
                                    <span class="fg-badge fg-badge-plain">Asset directory</span>
                                }
                            </td>
                            <td><span class="fg-badge @(grant.Level == FeedAccessLevel.Manage ? "fg-badge-accent" : grant.Level == FeedAccessLevel.Publish ? "fg-badge-info" : "")">@grant.Level</span></td>
                            <td class="fg-cell-actions"><a class="fg-btn fg-btn-sm" href="@(settings)/access">Change</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (providers.Count > 0)
{
    <section class="fg-panel">
        <h2>Provider groups</h2>
        <p class="fg-muted fg-small">
            Everyone in a linked group at a sign-in provider is a member here, refreshed each time they sign in with that
            provider. The provider needs a groups claim on its settings page. A provider group never grants a role.
        </p>
        @if (links.Count > 0)
        {
            <div class="fg-table-wrap">
                <table class="fg-table">
                    <tbody>
                        @foreach (var link in links)
                        {
                            var linked = providers.FirstOrDefault(p => p.Key == link.ProviderKey);
                            <tr>
                                <td>
                                    <strong>@link.ProviderGroup</strong> <span class="fg-muted fg-small">at @(linked?.DisplayName ?? "?")</span>
                                    @if (linked is not null && string.IsNullOrEmpty(linked.GroupsClaim))
                                    {
                                        <span class="fg-badge fg-badge-warn">No groups claim set</span>
                                    }
                                </td>
                                <td class="fg-cell-actions">
                                    <form method="post" action="/admin/groups/@group.Key/unlink-provider" data-confirm="@($"Unlink {link.ProviderGroup}? The members it gave this group are removed at their next sign-in.")" data-confirm-button="Unlink">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="link" value="@link.Key" />
                                        <button type="submit" class="fg-btn fg-btn-sm fg-btn-danger">Unlink</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <form method="post" action="/admin/groups/@group.Key/link-provider" class="fg-form">
            <AntiforgeryToken />
            <div class="fg-field">
                <label for="link-provider">Provider</label>
                <select id="link-provider" name="provider" required>
                    @foreach (var provider in providers)
                    {
                        <option value="@provider.Key">@provider.DisplayName</option>
                    }
                </select>
            </div>
            <div class="fg-field">
                <label for="link-group">Group at the provider</label>
                <input id="link-group" name="providerGroup" required maxlength="256" placeholder="as the provider names it" />
            </div>
            <button type="submit" class="fg-btn">Link provider group</button>
        </form>
    </section>
}

<section class="fg-panel">
    <h2>Name and description</h2>
    <EditForm Model="Edit!" FormName="edit-group" OnValidSubmit="SaveAsync" method="post" class="fg-form">
        <DataAnnotationsValidator />
        <div class="fg-field">
            <label for="group-name">Name</label>
            <InputText id="group-name" @bind-Value="Edit!.Name" />
            <ValidationMessage For="() => Edit!.Name" />
        </div>
        <div class="fg-field">
            <label for="group-description">Description</label>
            <InputText id="group-description" @bind-Value="Edit!.Description" />
        </div>
        @if (error is not null)
        {
            <p class="fg-error">@error</p>
        }
        <button type="submit" class="fg-btn">Save</button>
    </EditForm>
</section>

<section class="fg-panel fg-panel-danger">
    <h2>Delete this group</h2>
    <p class="fg-muted fg-small">Removes the group, its memberships, and every grant made to it. The accounts stay.</p>
    <form method="post" action="/admin/groups/@group.Key/delete" data-confirm="@($"Delete the group {group.Name}, its memberships and its grants?")" data-confirm-button="Delete group">
        <AntiforgeryToken />
        <button type="submit" class="fg-btn fg-btn-danger">Delete group</button>
    </form>
</section>

@code {
    private Group? group;
    private IReadOnlyList<User> members = [];
    private IReadOnlyList<User> candidates = [];
    private IReadOnlyList<OidcProvider> providers = [];
    private IReadOnlyList<GroupProviderLink> links = [];
    private IReadOnlySet<int> providerMembers = new HashSet<int>();
    private IReadOnlyList<GroupFeedGrant> grants = [];
    private string? error;
    private bool saved;

    [Parameter]
    public int Key { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "edit-group")]
    private GroupForm? Edit { get; set; }

    [SupplyParameterFromQuery(Name = "done")]
    private string? Done { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Edit ??= new GroupForm { Name = group?.Name ?? "", Description = group?.Description ?? "" };
    }

    private async Task LoadAsync()
    {
        group = await Groups.FindAsync(Key, HttpContext.RequestAborted);
        if (group is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        members = await Groups.MembersAsync(Key, HttpContext.RequestAborted);
        providerMembers = await Groups.ProviderMembersAsync(Key, HttpContext.RequestAborted);
        providers = await Providers.ListAsync(HttpContext.RequestAborted);
        links = await Groups.ProviderLinksAsync(Key, HttpContext.RequestAborted);
        grants = await Permissions.ListForGroupAsync(Key, HttpContext.RequestAborted);
        var memberKeys = members.Select(m => m.Key).ToHashSet();
        candidates = (await Users.ListAsync(HttpContext.RequestAborted)).Where(u => !memberKeys.Contains(u.Key)).ToList();
    }

    private async Task SaveAsync()
    {
        if (group is null)
        {
            return;
        }

        var name = Edit!.Name.Trim();
        if (!FiGet.Application.Accounts.AccountService.IsValidUserName(name))
        {
            error = "Use letters, digits, dot, dash or underscore, starting with a letter or digit (at most 64).";
            return;
        }

        if (!await Groups.UpdateAsync(Key, name, Edit.Description.Trim(), HttpContext.RequestAborted))
        {
            error = "That name is taken.";
            return;
        }

        Audit.Record(HttpContext, "group.update", name, $"was={group.Name}");
        saved = true;
        await LoadAsync();
    }

    private string DoneMessage => saved ? "Group saved." : Done switch
    {
        "added" => "Member added.",
        "removed" => "Member removed.",
        "linked" => "Provider group linked. Its members join at their next sign-in with that provider.",
        _ => "Provider group unlinked. Members it added leave at their next sign-in with that provider.",
    };

    private sealed class GroupForm
    {
        [Required(ErrorMessage = "Enter a name.")]
        public string Name { get; set; } = "";

        public string Description { get; set; } = "";
    }
}
