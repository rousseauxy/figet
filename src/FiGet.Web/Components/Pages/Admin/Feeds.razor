@page "/admin/feeds"
@page "/admin/assets"
@attribute [Authorize(Policy = FiGetApp.AdminPolicy)]
@layout AdminLayout
@using System.ComponentModel.DataAnnotations
@using FiGet.Domain.Feeds
@inject IFeedStore FeedStore
@inject IShareFolders Shares
@inject FiGet.Http.AuditLog Audit
@inject TimeProvider Time

@*
    Two tabs from one page: package feeds under /admin/feeds, asset directories under /admin/assets. They were one
    list, and a directory of files sat between package feeds with half its columns empty. What the two share - a
    name, who may read, a settings page - is most of this page, so two copies would only give the create form two
    places to drift apart.
*@
<PageTitle>@(IsAssets ? "Assets" : "Feeds") · admin · FiGet</PageTitle>

<h1>@(IsAssets ? "Asset directories" : "Feeds")</h1>
<p class="fg-lede">
    @(IsAssets
        ? "Every asset directory on this server, including the ones a reader cannot see."
        : "Every package feed on this server, including the ones a reader cannot see.")
</p>

@if (feeds.Count == 0)
{
    <p class="fg-empty">@(IsAssets ? "No asset directories yet." : "No feeds yet.") Create the first one below.</p>
}
else if (IsAssets)
{
    <div class="fg-table-wrap">
        <table class="fg-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Read</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var directory in feeds)
                {
                    <tr>
                        <td><a href="/admin/assets/@directory.Name">@directory.Name</a></td>
                        <td>@(directory.AnonymousRead ? (directory.AnonymousList ? "Anonymous" : "Anonymous, no listing") : "Token")@(directory.AllowedNetworks is null ? "" : ", listed networks")@(directory.IsFolderBacked ? " · folder" : "")</td>
                        <td class="fg-cell-actions">
                            <a class="fg-btn fg-btn-sm" href="/assets/@directory.Name">Browse</a>
                            <a class="fg-btn fg-btn-sm" href="/admin/assets/@directory.Name">Settings</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="fg-table-wrap">
        <table class="fg-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>Read</th>
                    <th>On existing version</th>
                    <th>Delete</th>
                    <th>Upstreams</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var feed in feeds)
                {
                    <tr>
                        <td><a href="/admin/feeds/@feed.Name">@feed.Name</a></td>
                        <td><span class="fg-badge">@Display.Kind(feed.Kind)</span></td>
                        <td>@(feed.AnonymousRead ? "Anonymous" : "Token")@(feed.AllowedNetworks is null ? "" : ", listed networks")</td>
                        <td>@(feed.AllowOverwrite ? "Overwrite" : "Reject (409)")</td>
                        <td>@feed.DeletionBehavior.ToString()</td>
                        <td class="fg-num">@(feed.Upstreams.Count == 0 ? Display.None : feed.Upstreams.Count.ToString(CultureInfo.InvariantCulture))</td>
                        <td class="fg-cell-actions">
                            <a class="fg-btn fg-btn-sm" href="/admin/feeds/@feed.Name">Settings</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (message is not null && !messageIsError)
{
    <div class="fg-alert fg-alert-ok" role="status">@message</div>
}

<Accordion Id="create" Title="@(IsAssets ? "Create an asset directory" : "Create a feed")" Open="@(feeds.Count == 0)" FormName="create-feed" Succeeded="@(message is not null && !messageIsError)">
    <EditForm Model="NewFeed!" FormName="create-feed" OnValidSubmit="CreateAsync" method="post" class="fg-form">
        <DataAnnotationsValidator />
        <div class="fg-field">
            <label for="feed-name">Name</label>
            <InputText id="feed-name" @bind-Value="NewFeed!.Name" placeholder="@(IsAssets ? "for example: installers" : "for example: modules")" />
            <ValidationMessage For="() => NewFeed!.Name" />
        </div>

        <label class="fg-check"><InputCheckbox @bind-Value="NewFeed!.AnonymousRead" /> @(IsAssets ? "Anyone can download a file without a token" : "Anyone can read without a token")</label>
        @if (IsAssets)
        {
            <label class="fg-check"><InputCheckbox @bind-Value="NewFeed!.AnonymousList" /> Anyone can list and browse the folders without a token</label>

            @* A folder on the server as the content, chosen by name from the shares mount: a page never takes a path, since
               one could name the database folder or the system. The operator decides what is under the mount. *@
            @if (!Shares.IsConfigured)
            {
                <p class="fg-muted fg-small">
                    A directory backed by a folder on the server needs the shares mount (<code>FiGet:Assets:SharesRoot</code>) or
                    the server configuration (<code>FiGet:Feeds:N:Folder</code>); see docs/configuration.md.
                </p>
            }
            else if (shares.Count == 0)
            {
                <p class="fg-muted fg-small">No folders under <code>@Shares.Root</code> yet: each share mounted as a sub-folder there can be a directory's content.</p>
            }
            else
            {
                <div class="fg-field">
                    <label for="feed-folder">Content</label>
                    <InputSelect id="feed-folder" @bind-Value="NewFeed!.Folder">
                        <option value="">FiGet's own storage (uploads)</option>
                        @foreach (var share in shares)
                        {
                            <option value="@share.Name">Folder @share.Name on the shares mount, read as it is</option>
                        }
                    </InputSelect>
                </div>
                <label class="fg-check"><InputCheckbox id="feed-folder-writes" @bind-Value="NewFeed!.FolderWrites" /> Uploads and deletes through FiGet act on the folder (folder-backed directories only; the share's own permissions still apply)</label>
            }
        }

        @if (!IsAssets)
        {
            <label class="fg-check"><InputCheckbox @bind-Value="NewFeed!.AllowOverwrite" /> Pushing an existing version replaces it</label>

            <div class="fg-field">
                <label for="feed-delete">Delete behaviour</label>
                <InputSelect id="feed-delete" @bind-Value="NewFeed!.DeletionBehavior">
                    <option value="@PackageDeletionBehavior.Unlist">Unlist (recommended)</option>
                    <option value="@PackageDeletionBehavior.HardDelete">Hard delete</option>
                </InputSelect>
            </div>
        }

        @if (message is not null && messageIsError)
        {
            <p class="fg-error">@message</p>
        }
        <button type="submit" class="fg-btn fg-btn-primary">@(IsAssets ? "Create directory" : "Create feed")</button>
    </EditForm>
</Accordion>

@code {
    private IReadOnlyList<Feed> feeds = [];
    private string? message;
    private bool messageIsError;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "create-feed")]
    private FeedForm? NewFeed { get; set; }

    /// <summary>Which tab this is, from the address it was reached by.</summary>
    private bool IsAssets => HttpContext.Request.Path.StartsWithSegments("/admin/assets", StringComparison.OrdinalIgnoreCase);

    private FeedKind Kind => IsAssets ? FeedKind.Assets : FeedKind.Curated;

    private IReadOnlyList<ShareFolder> shares = [];

    protected override void OnInitialized()
    {
        NewFeed ??= new();
        // Read on every render, the post included, so the options are there for the chosen one to match after a refusal.
        shares = IsAssets ? Shares.List() : [];
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        feeds = [.. (await FeedStore.ListAsync(HttpContext.RequestAborted)).Where(f => (f.Kind == FeedKind.Assets) == IsAssets)];

    private async Task CreateAsync()
    {
        if (!FeedNames.IsValid(NewFeed!.Name))
        {
            (message, messageIsError) = ("Use letters, digits, dot, dash or underscore, starting with a letter or digit (at most 64).", true);
            return;
        }

        // The posted value is a name, and the resolver is the only way from it to a path: anything that is not on the
        // list right now - a path, a name with a separator, a folder that is gone - creates nothing.
        string? folderRoot = null;
        var folderName = (NewFeed!.Folder ?? "").Trim();
        if (IsAssets && folderName.Length > 0)
        {
            folderRoot = Shares.Resolve(folderName);
            if (folderRoot is null)
            {
                (message, messageIsError) = ($"'{folderName}' is not a folder on the shares mount.", true);
                return;
            }
        }

        var folderWrites = folderRoot is not null && NewFeed!.FolderWrites;

        // Only the two a person chooses between, one per tab: a proxy feed is what a package feed becomes when it
        // gains an upstream, not something created as such. The package-only settings mean nothing to a directory.
        var created = await FeedStore.CreateAsync(
            new Feed
            {
                Name = NewFeed!.Name,
                NameLower = NewFeed!.Name.ToLowerInvariant(),
                Kind = Kind,
                AnonymousRead = NewFeed!.AnonymousRead,
                AnonymousList = IsAssets && NewFeed!.AnonymousList,
                FolderRoot = folderRoot,
                FolderWritable = folderWrites,
                AllowOverwrite = !IsAssets && NewFeed!.AllowOverwrite,
                DeletionBehavior = IsAssets ? PackageDeletionBehavior.Unlist : NewFeed!.DeletionBehavior,
                CreatedUtc = Time.GetUtcNow().UtcDateTime,
            },
            HttpContext.RequestAborted);

        if (created)
        {
            Audit.Record(
                HttpContext,
                "feed.create",
                NewFeed!.Name,
                $"kind={Kind} anonymousRead={NewFeed!.AnonymousRead} anonymousList={IsAssets && NewFeed!.AnonymousList} allowOverwrite={NewFeed!.AllowOverwrite} onDelete={NewFeed!.DeletionBehavior}"
                + (IsAssets ? $" folder={(folderRoot is null ? "none" : folderName)} folderWrites={folderWrites}" : ""));
        }

        // Feeds and directories share one set of names, so the refusal cannot say which of the two holds it
        // without looking; it names both rather than send someone to the wrong tab.
        (message, messageIsError) = created
            ? ($"{(IsAssets ? "Asset directory" : "Feed")} '{NewFeed!.Name}' created.", false)
            : ($"The name '{NewFeed!.Name}' is already taken by a feed or an asset directory, or is an alternate name of one.", true);
        await LoadAsync();
        if (created)
        {
            NewFeed = new();
        }
    }

    private sealed class FeedForm
    {
        [Required(ErrorMessage = "Enter a name.")]
        public string Name { get; set; } = "";

        public bool AnonymousRead { get; set; }

        public bool AnonymousList { get; set; }

        /// <summary>Empty for FiGet's own storage, else the name of a sub-folder of the shares mount. A name, never a path.</summary>
        public string Folder { get; set; } = "";

        public bool FolderWrites { get; set; }

        public bool AllowOverwrite { get; set; }

        public PackageDeletionBehavior DeletionBehavior { get; set; } = PackageDeletionBehavior.Unlist;
    }
}
