@page "/admin/system"
@attribute [Authorize(Policy = FiGetApp.AdminPolicy)]
@layout AdminLayout
@using System.Runtime.InteropServices
@using FiGet.Web.Configuration
@using FiGet.Web.Connectors
@using FiGet.Web.Security
@using Microsoft.Extensions.Options
@inject IDatabaseFacts Facts
@inject IJobLeaseStore Leases
@inject IStorageSpace Space
@inject IServerInstanceStore Instances
@inject IOptions<FiGetOptions> Options
@inject KeyRingMasterKey MasterKey
@inject TimeProvider Time

@*
    What is running, where it keeps things, how much room is left, and whether anything is keeping the database in
    check. Read-only on purpose: every setting it names is edited where it belongs, and a page that can rebuild or lock
    a database is a page that can take the server down from a browser.

    It counts no rows and walks no files. Everything here is a page count, a file size, a list of migrations or a handful
    of rows, so an administrator may refresh it as often as they like.
*@

<PageTitle>System · admin · FiGet</PageTitle>

<h1>System</h1>
<p class="fg-lede">
    What this server is running, what it is running on, and what keeps its database from growing without end. Stored
    files nothing points at are the <a href="/admin/storage">storage check</a>.
</p>

<section class="fg-panel">
    <h2>This server</h2>
    <dl class="fg-facts">
        <dt>FiGet</dt>
        <dd>@ServerVersion.Resolve(Options.Value.Version)</dd>

        <dt>Runtime</dt>
        <dd>@RuntimeInformation.FrameworkDescription on @RuntimeInformation.OSDescription (@RuntimeInformation.ProcessArchitecture.ToString().ToLowerInvariant())</dd>

        <dt>Public address</dt>
        <dd class="fg-badge-lead">
            @if (string.IsNullOrWhiteSpace(Options.Value.PublicBaseUrl))
            {
                <span class="fg-badge fg-badge-warn">Not set</span>
                <span>Every URL in a protocol answer is built from the request instead, which a client behind a proxy may not be able to follow. Set <code>FiGet:PublicBaseUrl</code>.</span>
            }
            else
            {
                <code>@Options.Value.PublicBaseUrl</code>
            }
        </dd>

        <dt>Clock</dt>
        <dd>
            @Display.Date(Time.GetUtcNow().UtcDateTime)
            <span class="fg-muted">— every time on these pages is UTC, whatever the container's time zone.</span>
        </dd>
    </dl>
</section>

<section class="fg-panel">
    <h2>Instances</h2>
    <p class="fg-muted fg-small">
        Every copy sharing this database says it is running, once a minute. One that stops saying so is listed until it
        has been quiet for @Display.Every(InstanceHeartbeatService.Forgotten), then forgotten. Nothing here decides
        anything: which copy runs a job is the lease below.
    </p>
    @if (Options.Value.Database.ExpectedReplicas != running.Count && running.Count > 0)
    {
        <div class="fg-alert fg-alert-warn" role="status">
            <strong>@running.Count running, @Options.Value.Database.ExpectedReplicas expected.</strong>
            <code>FiGet:Database:ExpectedReplicas</code> is what this server was told to expect; it is not a count of
            what is there. On a cluster, a difference is a rollout in progress or a pod that did not come back.
        </div>
    }
    @if (versions.Count > 1)
    {
        <div class="fg-alert fg-alert-warn" role="alert">
            <strong>Two versions are running at once:</strong> @string.Join(", ", versions).
            That is normal during a rolling update and a stuck rollout otherwise.
        </div>
    }
    <div class="fg-table-wrap">
        <table class="fg-table">
            <thead>
                <tr>
                    <th scope="col">Instance</th>
                    <th scope="col">Version</th>
                    <th scope="col">Started</th>
                    <th scope="col">Last seen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var one in instances)
                {
                    var quiet = Time.GetUtcNow().UtcDateTime - one.LastSeenUtc > Quiet;
                    <tr>
                        <td class="fg-badge-trail">
                            @one.Machine
                            @if (one.Id == Self.Id)
                            {
                                <span class="fg-badge fg-badge-plain" title="The instance answering this request">this one</span>
                            }
                        </td>
                        <td>@one.Version</td>
                        <td>@Display.Date(one.StartedUtc)</td>
                        <td class="fg-badge-trail">
                            @Display.Date(one.LastSeenUtc)
                            @if (quiet)
                            {
                                <span class="fg-badge fg-badge-warn" title="It has missed several heartbeats: stopped, or unable to write to the database">quiet</span>
                            }
                        </td>
                    </tr>
                }
                @if (instances.Count == 0)
                {
                    <tr><td colspan="4" class="fg-muted">Nothing yet: the first heartbeat is written a moment after a start.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="fg-panel">
    <h2>Storage</h2>
    <dl class="fg-facts">
        <dt>Volume</dt>
        <dd>@(space.Known ? space.Volume : "Unknown: the system would not say what this path is mounted on.")</dd>

        @if (space.Known)
        {
            <dt>Free</dt>
            <dd>
                @Display.Size(space.FreeBytes) of @Display.Size(space.TotalBytes)
                <span class="fg-muted">— @Percent(space.UsedBytes, space.TotalBytes) used, by everything on that volume and not by FiGet alone.</span>
            </dd>
        }
    </dl>
    <p class="fg-muted fg-small">
        A full volume fails a push, and nothing else on this server can warn about it. What FiGet's own files take is not
        here: that would mean walking every stored file, which the <a href="/admin/storage">storage check</a> does when
        you ask it to.
    </p>
</section>

@if (facts is null)
{
    <div class="fg-alert fg-alert-danger" role="alert">
        The database did not answer. It is reachable - this page needed it to load - but it refused the questions this
        page asks; the server log has the reason.
    </div>
    return;
}

@if (facts.PendingMigrations.Count > 0)
{
    <div class="fg-alert fg-alert-danger" role="alert">
        <strong>@facts.PendingMigrations.Count @(facts.PendingMigrations.Count == 1 ? "migration has" : "migrations have") not been applied.</strong>
        This build expects a newer schema than this database has, so anything the new schema added will fail.
        <code>FiGet:Database:MigrateOnStartup</code> is @(Options.Value.Database.MigrateOnStartup ? "on, so the last start could not apply them" : "off, so nothing will apply them"):
        @string.Join(", ", facts.PendingMigrations)
    </div>
}

<section class="fg-panel">
    <h2>Database</h2>
    <dl class="fg-facts">
        <dt>Engine</dt>
        <dd>@(facts.Engine == DatabaseEngine.SqlServer ? "Microsoft SQL Server" : "SQLite") @facts.EngineVersion</dd>

        <dt>@(facts.Engine == DatabaseEngine.SqlServer ? "Server and database" : "File")</dt>
        <dd>@facts.Location</dd>

        <dt>@(facts.Engine == DatabaseEngine.SqlServer ? "Recovery model" : "Journal mode")</dt>
        <dd>
            @facts.Mode
            @if (facts.Engine == DatabaseEngine.SqlServer && facts.Mode == "FULL")
            {
                <span class="fg-muted"> — the log is kept until a log backup frees it, so this needs one scheduled.</span>
            }
        </dd>

        <dt>Schema</dt>
        <dd>
            @(facts.AppliedMigrations.Count == 0 ? Display.None : facts.AppliedMigrations[^1])
            <span class="fg-muted">(@Display.Count(facts.AppliedMigrations.Count) applied)</span>
        </dd>

        <dt>Replicas</dt>
        <dd>
            @Options.Value.Database.ExpectedReplicas configured
            <span class="fg-muted">— one of them runs each job below, whichever holds its lease.</span>
        </dd>

        <dt>Key ring</dt>
        <dd class="fg-badge-lead">
            @if (MasterKey.IsSet)
            {
                <span>Encrypted with <code>FiGet:DataProtection:MasterKey</code>. Keep that key, and keep it apart from the database backup: without it the stored webhook address and every provider secret cannot be read.</span>
            }
            else
            {
                <span class="fg-badge fg-badge-warn">Not encrypted</span>
                <span>Anyone who can read this database can forge a sign-in cookie and read the stored webhook address. Set <code>FiGet:DataProtection:MasterKey</code> from a secret.</span>
            }
        </dd>
    </dl>
</section>

<section class="fg-panel">
    <h2>Size</h2>
    <dl class="fg-facts">
        <dt>Total</dt>
        <dd>@Display.Size(facts.SizeBytes)@(facts.Engine == DatabaseEngine.Sqlite ? ", including the write-ahead log" : "")</dd>

        @if (facts.LogSizeBytes > 0)
        {
            <dt>Transaction log</dt>
            <dd>@Display.Size(facts.LogSizeBytes)</dd>
        }

        <dt>Reclaimable</dt>
        <dd>
            @Display.Size(facts.ReclaimableBytes)
            <span class="fg-muted">— already inside the total, and reused before the database grows again.</span>
        </dd>
    </dl>
    <p class="fg-muted fg-small">
        Package, symbol and asset files are not in here: they are on the storage volume, and their size is the feeds'
        own pages. What is in here is the index of them, the descriptions cached from upstreams, the audit log and the
        usage counts.
    </p>
</section>

<section class="fg-panel">
    <h2>Jobs</h2>
    <p class="fg-muted fg-small">
        These are what keep the database from growing without end. A job that is off is not a job that is behind: nothing
        will ever remove what it was removing. "Last started" is when a run began, not that it finished.
    </p>
    <div class="fg-table-wrap">
        <table class="fg-table">
            <thead>
                <tr>
                    <th scope="col">Job</th>
                    <th scope="col">Every</th>
                    <th scope="col">Last started</th>
                    <th scope="col">What it bounds</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Jobs())
                {
                    <tr>
                        <td>@job.Label</td>
                        <td>
                            @if (JobsOptions.Runs(job.Interval))
                            {
                                @Display.Every(job.Interval)
                            }
                            else
                            {
                                <span class="fg-badge fg-badge-warn" title="The interval is zero, so this job is not registered at all">off</span>
                            }
                        </td>
                        <td>
                            @switch (Lease(job.Name))
                            {
                                case { TakenUtc: { } taken }:
                                    @Display.Date(taken)
                                    break;

                                case not null:
                                    // The lease exists, so the job has run - before this server recorded when. It says so
                                    // for one interval after the upgrade that added the column, and then never again.
                                    <span class="fg-muted" title="This job has run: it holds a lease. When it last started was not recorded before this version">not recorded</span>
                                    break;

                                default:
                                    <span class="fg-muted" title="No run has ever taken this job's lease against this database">never</span>
                                    break;
                            }
                        </td>
                        <td class="fg-muted">@job.Bounds</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    /// <summary>Missed heartbeats before an instance is called quiet: enough for one slow minute not to raise a flag.</summary>
    private static readonly TimeSpan Quiet = TimeSpan.FromMinutes(5);

    private DatabaseFacts? facts;
    private IReadOnlyList<JobLeaseState> leases = [];
    private IReadOnlyList<ServerInstance> instances = [];
    private IReadOnlyList<ServerInstance> running = [];
    private IReadOnlyList<string> versions = [];
    private VolumeSpace space = new("", 0, 0);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Inject]
    private JobInstance Self { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        facts = await Facts.ReadAsync(HttpContext.RequestAborted);
        leases = await Leases.ListAsync(HttpContext.RequestAborted);
        instances = await Instances.ListAsync(HttpContext.RequestAborted);
        space = Space.Read();

        // "Running" is what is still speaking, which is the only honest basis for comparing against the replica count.
        var now = Time.GetUtcNow().UtcDateTime;
        running = [.. instances.Where(i => now - i.LastSeenUtc <= Quiet)];
        versions = [.. running.Select(i => i.Version).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal)];
    }

    private static string Percent(long part, long whole) =>
        whole <= 0 ? "—" : ((int)Math.Round(100d * part / whole)).ToString(CultureInfo.InvariantCulture) + "%";

    private JobLeaseState? Lease(string name) => leases.FirstOrDefault(l => l.Name == name);

    /// <summary>
    /// Every job that takes a lease, with what stops growing when it stops. The list is written out rather than derived,
    /// because "what it bounds" is the sentence an operator needs and no job knows it about itself.
    /// </summary>
    private IEnumerable<JobRow> Jobs()
    {
        var jobs = Options.Value.Jobs;
        yield return new(JobLeaseNames.Retention, "Retention and cache pruning", jobs.Retention, "Package versions past each feed's retention rules, and cached copies past its pruning age.");
        yield return new(JobLeaseNames.AuditPrune, "Audit prune", jobs.AuditPrune, AuditBound());
        yield return new(JobLeaseNames.UsagePrune, "Usage prune", jobs.UsagePrune, "Per-feed download and search counts older than ninety days.");
        yield return new(JobLeaseNames.UploadSweep, "Upload sweep", jobs.UploadSweep, "Multipart uploads nobody finished. Files on the volume, not rows here.");
        yield return new(JobLeaseNames.CatalogueSweep, "Catalogue sweep", jobs.CatalogueSweep, "Nothing: it refreshes what upstreams offer rather than removing anything.");
        yield return new(JobLeaseNames.ChangeReport, "Change report", jobs.ChangeReport, "Nothing: it reports what changed, and keeps release notes current.");
    }

    private string AuditBound() => Options.Value.Audit.RetentionDays > 0
        ? $"Audit entries older than {Options.Value.Audit.RetentionDays} days (FiGet:Audit:RetentionDays)."
        : "Nothing: FiGet:Audit:RetentionDays is 0, so audit entries are kept for ever.";

    private sealed record JobRow(string Name, string Label, TimeSpan Interval, string Bounds);
}
