@page "/admin/feeds/{Name}"
@page "/admin/assets/{Name}"
@attribute [Authorize(Policy = FiGetApp.AdminPolicy)]
@layout AdminLayout
@using System.ComponentModel.DataAnnotations
@using FiGet.Application.Ports
@inject IFeedStore Feeds
@inject IPackageStorage Storage
@inject IAssetStorage AssetStorage
@inject NavigationManager Navigation
@inject FiGet.Http.AuditLog Audit

<PageTitle>@Name settings · FiGet</PageTitle>

@if (feed is null)
{
    <h1>Feed not found</h1>
    <p class="fg-muted">There is no feed named <code>@Name</code>. <a href="/admin/feeds">Back to feeds</a>.</p>
}
else
{
    <h1>@feed.Name</h1>

    @if (message is not null)
    {
        <div class="@(messageIsError ? "fg-alert fg-alert-danger" : "fg-alert fg-alert-ok")">@message</div>
    }

    @*
        Stacked rather than tiled. These sections were in a grid of auto-fit minmax(21rem, 1fr), so three
        panels of wildly unequal height sat in one row: a short Settings panel and a short Source URLs
        panel beside a very tall Upstreams panel, leaving the danger zone orphaned far below with nothing
        next to it. Each of these wants the full width anyway, because a source URL should not wrap
        mid-token and a table should not scroll sideways inside a column.
    *@
    <section class="fg-panel">
        <h2>Settings</h2>
        <EditForm Model="Settings!" FormName="feed-settings" OnValidSubmit="SaveAsync" method="post" class="fg-form">
            <label class="fg-check"><InputCheckbox id="anonymous-read" @bind-Value="Settings!.AnonymousRead" /> Anyone can read without a token</label>
            @if (IsAssets)
            {
                <p class="fg-muted fg-small">Uploading and deleting always need a token or a signed-in admin, whatever this says.</p>
            }
            else
            {
                <label class="fg-check"><InputCheckbox id="allow-overwrite" @bind-Value="Settings!.AllowOverwrite" /> Pushing an existing version replaces it</label>

                <div class="fg-field">
                    <label for="delete-behaviour">Delete behaviour</label>
                    <InputSelect id="delete-behaviour" @bind-Value="Settings!.DeletionBehavior">
                        <option value="@PackageDeletionBehavior.Unlist">Unlist (recommended)</option>
                        <option value="@PackageDeletionBehavior.HardDelete">Hard delete</option>
                    </InputSelect>
                </div>

                @if (feed.Upstreams.Count > 0)
                {
                    <label class="fg-check"><InputCheckbox id="merge-pushed-ids" @bind-Value="Settings!.MergePushedIdsWithUpstreams" /> Merge pushed packages with upstream packages of the same id</label>
                    <p class="fg-muted fg-small">
                        Off, an id pushed here is served only from this feed, and an upstream package with the same
                        name is no longer offered. On, both are merged into one version list and the higher version of
                        either becomes the latest - only right when the upstream package really is the same one.
                    </p>
                }
            }

            <button type="submit" class="fg-btn fg-btn-primary">Save settings</button>
        </EditForm>

        <dl class="fg-facts">
            <dt>Kind</dt><dd>@Display.Kind(feed.Kind)</dd>
            <dt>Created</dt><dd class="fg-num">@feed.CreatedUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</dd>
            <dt>@(IsAssets ? "Files" : "Versions")</dt><dd class="fg-num">@versionCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
        </dl>
    </section>

    @if (IsAssets)
    {
        <section class="fg-panel">
            <h2>URLs</h2>
            <dl class="fg-facts">
                <dt>Download</dt>
                <dd>
                    <div class="fg-url">
                        <code>@AssetContentUrl</code>
                        <button type="button" class="fg-copy" data-copy="@AssetContentUrl" title="Copy this URL" aria-label="Copy the download URL">Copy</button>
                    </div>
                </dd>
                <dt>Listing (JSON)</dt>
                <dd>
                    <div class="fg-url">
                        <code>@AssetListUrl</code>
                        <button type="button" class="fg-copy" data-copy="@AssetListUrl" title="Copy this URL" aria-label="Copy the listing URL">Copy</button>
                    </div>
                </dd>
            </dl>
            <p class="fg-muted fg-small">Browse and upload files on <a href="/assets/@feed.Name">the directory's page</a>.</p>
        </section>
    }
    else
    {
    <section class="fg-panel">
        <h2>Source URLs</h2>
        <dl class="fg-facts">
            <dt>NuGet v3</dt>
            <dd>
                <div class="fg-url">
                    <code>@V3Url</code>
                    <button type="button" class="fg-copy" data-copy="@V3Url" title="Copy this URL" aria-label="Copy the v3 source URL">Copy</button>
                </div>
            </dd>
            <dt>Feed root</dt>
            <dd>
                <div class="fg-url">
                    <code>@FeedUrl</code>
                    <button type="button" class="fg-copy" data-copy="@FeedUrl" title="Copy this URL" aria-label="Copy the feed root URL">Copy</button>
                </div>
            </dd>
        </dl>
    </section>

    <section class="fg-panel">
        <h2>Upstreams</h2>
        @if (feed.Upstreams.Count == 0)
        {
            <p class="fg-muted fg-small">
                None. This feed serves only what was pushed to it. Add an upstream to also offer, and
                cache on demand, everything another feed holds.
            </p>
        }
        else
        {
            <div class="fg-table-wrap">
                <table class="fg-table">
                    <thead>
                        <tr><th>Priority</th><th>Name</th><th>Protocol</th><th>URL</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (upstream, index) in feed.Upstreams.OrderBy(u => u.Ordinal).Select((u, i) => (u, i)))
                        {
                            <tr>
                                <td class="fg-num">
                                    <div class="fg-row fg-priority">
                                        <span>@(index + 1)</span>
                                        @if (feed.Upstreams.Count > 1)
                                        {
                                            <form method="post" action="/admin/feeds/@feed.Name/upstreams/move">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="key" value="@upstream.Key" />
                                                <input type="hidden" name="direction" value="up" />
                                                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                                <button type="submit" class="fg-btn fg-btn-sm" disabled="@(index == 0)" title="Ask this upstream earlier" aria-label="Move @upstream.Name up">↑</button>
                                            </form>
                                            <form method="post" action="/admin/feeds/@feed.Name/upstreams/move">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="key" value="@upstream.Key" />
                                                <input type="hidden" name="direction" value="down" />
                                                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                                <button type="submit" class="fg-btn fg-btn-sm" disabled="@(index == feed.Upstreams.Count - 1)" title="Ask this upstream later" aria-label="Move @upstream.Name down">↓</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                                <td>@upstream.Name</td>
                                <td><span class="fg-badge">@upstream.Kind</span></td>
                                <td><code>@upstream.Url</code></td>
                                <td class="fg-cell-actions">
                                    <form method="post" action="/admin/feeds/@feed.Name/upstreams/remove">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="key" value="@upstream.Key" />
                                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                        <button type="submit" class="fg-btn fg-btn-sm fg-btn-danger" title="Stop using this upstream">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="fg-muted fg-small">
                The first upstream that holds a package id serves it; upstreams further down are not asked about
                that id, so two different packages that share a name are never mixed. Removing an upstream keeps the
                packages already cached from it: they were downloaded, and something out there depends on them.
            </p>
        }

        @* Behind a disclosure. Seven fields, filled in rarely, that used to take most of the page height
           on every visit. Closed by default costs one click; open by default cost every other task. *@
        <details class="fg-more">
            <summary>Add an upstream</summary>
            <form method="post" action="/admin/feeds/@feed.Name/upstreams/add" class="fg-form">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <div class="fg-field">
                    <label for="upstream-name">Name</label>
                    <input id="upstream-name" name="name" required placeholder="for example: powershellgallery" />
                </div>

                <div class="fg-field">
                    <label for="upstream-url">URL</label>
                    <input id="upstream-url" name="url" required placeholder="https://www.powershellgallery.com/api/v2" />
                </div>

                <div class="fg-field">
                    <label for="upstream-kind">Protocol</label>
                    <select id="upstream-kind" name="kind">
                        <option value="V3">v3 service index (ends in index.json)</option>
                        <option value="V2">v2 feed root (the PowerShell Gallery)</option>
                    </select>
                </div>

                <div class="fg-field">
                    <label for="upstream-allow">Only these package ids (one regular expression per line, empty allows all)</label>
                    <textarea id="upstream-allow" name="allow" rows="2"></textarea>
                </div>

                <div class="fg-field">
                    <label for="upstream-deny">Never these package ids (one regular expression per line)</label>
                    <textarea id="upstream-deny" name="deny" rows="2"></textarea>
                </div>

                <div class="fg-field">
                    <label for="upstream-credential">Environment variable holding the API key, if the upstream needs one</label>
                    <input id="upstream-credential" name="credentialRef" placeholder="for example: FIGET_UPSTREAM_KEY" />
                </div>

                <button type="submit" class="fg-btn fg-btn-primary">Add upstream</button>
            </form>
        </details>
    </section>
    }

    <section class="fg-panel fg-panel-danger">
        <h2>Delete this @Noun</h2>
        <p class="fg-muted fg-small">
            Removes the @Noun with its @versionCount.ToString("N0", CultureInfo.InvariantCulture)
            @(IsAssets ? "file(s)" : "package version(s), their files,") and any token scoped to it.
            This cannot be undone.
        </p>
        <EditForm Model="Confirm!" FormName="delete-feed" OnValidSubmit="DeleteAsync" method="post" class="fg-form">
            <div class="fg-field">
                <label for="confirm-name">Type the @Noun name to confirm</label>
                <InputText id="confirm-name" @bind-Value="Confirm!.Name" autocomplete="off" placeholder="@feed.Name" />
            </div>
            <button type="submit" class="fg-btn fg-btn-danger">Delete @Noun</button>
        </EditForm>
    </section>
}

@code {
    private Feed? feed;
    private int versionCount;
    private string? message;
    private bool messageIsError;

    [Parameter]
    public string Name { get; set; } = "";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "feed-settings")]
    private SettingsForm? Settings { get; set; }

    [SupplyParameterFromForm(FormName = "delete-feed")]
    private ConfirmForm? Confirm { get; set; }

    private string FeedUrl => PublicUrls.Feed(HttpContext, feed!.Name);

    /// <summary>Where the buttons return to.</summary>
    private string ReturnUrl => HttpContext.Request.Path + HttpContext.Request.QueryString;

    private string V3Url => $"{FeedUrl}/v3/index.json";

    private bool IsAssets => feed?.Kind == FeedKind.Assets;

    private string Noun => IsAssets ? "directory" : "feed";

    private string AssetContentUrl => $"{PublicUrls.Base(HttpContext)}/endpoints/{Uri.EscapeDataString(feed!.Name)}/content/";

    private string AssetListUrl => $"{PublicUrls.Base(HttpContext)}/endpoints/{Uri.EscapeDataString(feed!.Name)}/dir/";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Confirm ??= new();
        // Only seed the settings form on a GET; on a post it already carries what was submitted.
        Settings ??= feed is null
            ? new SettingsForm()
            : new SettingsForm { AnonymousRead = feed.AnonymousRead, AllowOverwrite = feed.AllowOverwrite, DeletionBehavior = feed.DeletionBehavior, MergePushedIdsWithUpstreams = feed.MergePushedIdsWithUpstreams };
    }

    private async Task LoadAsync()
    {
        feed = await Feeds.FindAsync(Name, HttpContext.RequestAborted);
        versionCount = feed is null ? 0
            : feed.Kind == FeedKind.Assets ? await Feeds.CountAssetsAsync(feed.Key, HttpContext.RequestAborted)
            : await Feeds.CountVersionsAsync(feed.Key, HttpContext.RequestAborted);
    }

    private async Task SaveAsync()
    {
        if (feed is null)
        {
            return;
        }

        var saved = await Feeds.UpdateSettingsAsync(
            feed.Key, Settings!.AnonymousRead, Settings!.AllowOverwrite, Settings!.DeletionBehavior, Settings!.MergePushedIdsWithUpstreams, HttpContext.RequestAborted);

        if (saved)
        {
            // The values, not just that something changed: "who loosened this feed" is the question a
            // settings audit is asked, and it cannot be answered by a bare "settings saved".
            Audit.Record(
                HttpContext,
                "feed.settings",
                feed.Name,
                $"anonymousRead={Settings!.AnonymousRead} allowOverwrite={Settings!.AllowOverwrite} onDelete={Settings!.DeletionBehavior} mergePushedIds={Settings!.MergePushedIdsWithUpstreams}");
        }

        (message, messageIsError) = saved ? ("Settings saved.", false) : ("This feed no longer exists.", true);
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (feed is null)
        {
            return;
        }

        if (!string.Equals(Confirm!.Name?.Trim(), feed.Name, StringComparison.OrdinalIgnoreCase))
        {
            (message, messageIsError) = ($"Type '{feed.Name}' exactly to confirm the deletion.", true);
            return;
        }

        // Files first: a row without files is visible and fixable, an orphaned file is neither.
        Audit.Record(HttpContext, "feed.delete", feed.Name);
        await Storage.DeleteFeedAsync(feed.NameLower, HttpContext.RequestAborted);
        await AssetStorage.DeleteFeedAsync(feed.NameLower, HttpContext.RequestAborted);
        await Feeds.DeleteAsync(feed.Key, HttpContext.RequestAborted);
        Navigation.NavigateTo(IsAssets ? "/admin/assets" : "/admin/feeds", forceLoad: false);
    }

    private sealed class SettingsForm
    {
        public bool AnonymousRead { get; set; }

        public bool AllowOverwrite { get; set; }

        public PackageDeletionBehavior DeletionBehavior { get; set; } = PackageDeletionBehavior.Unlist;

        public bool MergePushedIdsWithUpstreams { get; set; }
    }

    private sealed class ConfirmForm
    {
        [Required(ErrorMessage = "Type the feed name.")]
        public string Name { get; set; } = "";
    }
}
