@page "/admin/feeds/{Name}"
@page "/admin/assets/{Name}"
@attribute [Authorize]
@layout AdminLayout
@inherits FeedAdminPage
@using FiGet.Domain.Feeds
@inject IShareFolders Shares
@inject Microsoft.Extensions.Options.IOptions<FiGet.Web.Configuration.FiGetOptions> Options
@inject FiGet.Http.AuditLog Audit

<PageTitle>@Name settings · FiGet</PageTitle>

<FeedAdminHeader Feed="Target" Name="@Name" />

@if (Target is { } feed)
{
    @if (message is not null)
    {
        <div class="@(messageIsError ? "fg-alert fg-alert-danger" : "fg-alert fg-alert-ok")">@message</div>
    }

    <section class="fg-panel">
        <h2>Settings</h2>
        <EditForm Model="Settings!" FormName="feed-settings" OnValidSubmit="SaveAsync" method="post" class="fg-form">
            <label class="fg-check"><InputCheckbox id="anonymous-read" @bind-Value="Settings!.AnonymousRead" /> @(IsAssets ? "Anyone can download a file without a token" : "Anyone can read without a token")</label>
            @if (IsAssets)
            {
                <label class="fg-check"><InputCheckbox id="anonymous-list" @bind-Value="Settings!.AnonymousList" /> Anyone can list and browse the folders without a token</label>
                <p class="fg-muted fg-small">
                    A consumer that knows its paths needs only the first. With the second off, a folder shows a stranger nothing
                    and a wrong path is the same 404 as a right one; listing then needs a signed-in account or a key with Read.
                    Uploading and deleting always need a token or a signed-in account with Publish, whatever these say.
                </p>
            }
            else
            {
                <label class="fg-check"><InputCheckbox id="allow-overwrite" @bind-Value="Settings!.AllowOverwrite" /> Pushing an existing version replaces it</label>

                <div class="fg-field">
                    <label for="delete-behaviour">Delete behaviour</label>
                    <InputSelect id="delete-behaviour" @bind-Value="Settings!.DeletionBehavior">
                        <option value="@PackageDeletionBehavior.Unlist">Unlist (recommended)</option>
                        <option value="@PackageDeletionBehavior.HardDelete">Hard delete</option>
                    </InputSelect>
                </div>

                @if (feed.Upstreams.Count > 0)
                {
                    <label class="fg-check"><InputCheckbox id="merge-pushed-ids" @bind-Value="Settings!.MergePushedIdsWithUpstreams" /> Merge pushed packages with upstream packages of the same id</label>
                    <p class="fg-muted fg-small">
                        Off, an id pushed here is served only from this feed, and an upstream package with the same
                        name is no longer offered. On, both are merged into one version list and the higher version of
                        either becomes the latest - only right when the upstream package really is the same one.
                    </p>
                }
            }

            @* One row of dots, the dot itself being the control: the native radio is hidden and the chosen dot wears a
               ring. Not a dropdown, which cannot show a colour, and not a colour picker, which would lose the point of
               the palette - nine hues chosen to stay apart from each other on the graph in both themes. *@
            <fieldset class="fg-swatches">
                <legend>Colour on the usage graph</legend>
                @* InputRadioGroup renders no element of its own, so a class on it went nowhere and the fieldset's grid stacked
                   the swatches: the row is a div of its own. *@
                <InputRadioGroup @bind-Value="Settings!.ChartColor">
                <div class="fg-swatch-row">
                    <label class="fg-swatch" title="Picked for this @Noun, the same every time">
                        <InputRadio Value="0" /><span class="fg-series-dot" style="--series: var(--fg-series-@AutomaticColor)"></span><span>Automatic</span>
                    </label>
                    @for (var color = 1; color <= FeedColors.Count; color++)
                    {
                        var value = color;
                        <label class="fg-swatch" title="Colour @value">
                            <InputRadio Value="value" /><span class="fg-series-dot" style="--series: var(--fg-series-@value)"></span><span class="fg-sr-only">Colour @value</span>
                        </label>
                    }
                </div>
                </InputRadioGroup>
            </fieldset>

            <button type="submit" class="fg-btn fg-btn-primary">Save settings</button>
        </EditForm>

        <dl class="fg-facts">
            <dt>Kind</dt><dd>@Display.Kind(feed.Kind)</dd>
            @if (feed.IsFolderBacked)
            {
                <dt>Folder</dt>
                <dd>
                    <code>@feed.FolderRoot</code>
                    <div class="fg-small fg-muted">
                        The files are this folder on the server, read as it is;
                        @if (FolderFromConfiguration)
                        {
                            <text>set in the server configuration (<code>FiGet:Feeds</code>), applied on every start.</text>
                        }
                        else if (ShowsFolderForm)
                        {
                            <text>chosen under <em>Content</em> below.</text>
                        }
                        else
                        {
                            <text>chosen by an administrator.</text>
                        }
                        Writes through FiGet are @(feed.FolderWritable ? "on" : "off") for it.
                    </div>
                </dd>
            }
            <dt>Created</dt><dd class="fg-num">@feed.CreatedUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</dd>
            <dt>@(IsAssets ? "Files" : "Versions")</dt><dd class="fg-num">@versionCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
        </dl>
    </section>

    @* Under a bar of its own, closed until asked: most feeds are open to the whole network, and the bar says when one
       is not. It reopens on a post that was refused, with the entry that was refused named. *@
    <Accordion Id="networks" Title="@NetworksTitle" FormName="feed-networks" Succeeded="@networksSaved">
        <EditForm Model="Networks!" FormName="feed-networks" OnValidSubmit="SaveNetworksAsync" method="post" class="fg-form">
            <div class="fg-field">
                <label for="allowed-networks">Addresses this @Noun can be reached from (empty: any)</label>
                <InputTextArea id="allowed-networks" @bind-Value="Networks!.Text" rows="4" class="fg-mono" placeholder="10.0.0.0/8&#10;192.168.1.25&#10;2001:db8::/32" />
                <span class="fg-small fg-muted">
                    One address or range per line, CIDR notation. A request from anywhere else gets 403 whatever key or
                    account it carries, and the @Noun is not on the public pages there; these settings pages are not limited.
                    IPv4 and IPv6 are separate: a client that comes both ways is listed twice. Behind a reverse proxy the
                    address is the one the proxy forwards (<code>ASPNETCORE_FORWARDEDHEADERS_ENABLED</code>); without that,
                    every client is the proxy's own address.
                </span>
            </div>
            @if (networksError is not null)
            {
                <p class="fg-error">@networksError</p>
            }
            <button type="submit" class="fg-btn fg-btn-primary">Save networks</button>
        </EditForm>
    </Accordion>

    @* The content of an asset directory: FiGet's own storage, or one sub-folder of the shares mount, chosen by name. Admins
       only, and not for a directory whose folder configuration sets, since the next start would put that back. *@
    @if (ShowsFolderForm)
    {
        <Accordion Id="folder" Title="@FolderTitle" FormName="feed-folder" Succeeded="@folderSaved">
            @if (!Shares.IsConfigured)
            {
                <p class="fg-muted fg-small">
                    A directory backed by a folder on the server needs the shares mount (<code>FiGet:Assets:SharesRoot</code>) or
                    the server configuration (<code>FiGet:Feeds:N:Folder</code>); see docs/configuration.md.
                </p>
            }
            else if (shares.Count == 0)
            {
                <p class="fg-muted fg-small">No folders under <code>@Shares.Root</code> yet: each share mounted as a sub-folder there can be a directory's content.</p>
            }
            else
            {
                <EditForm Model="Folder!" FormName="feed-folder" OnValidSubmit="SaveFolderAsync" method="post" class="fg-form">
                    <div class="fg-field">
                        <label for="folder-share">Content</label>
                        <InputSelect id="folder-share" @bind-Value="Folder!.Share">
                            <option value="">FiGet's own storage (uploads)</option>
                            @foreach (var share in shares)
                            {
                                <option value="@share.Name">Folder @share.Name on the shares mount, read as it is</option>
                            }
                        </InputSelect>
                        <span class="fg-small fg-muted">
                            Nothing is copied either way: a folder is read as it is, and moving the directory off a folder leaves
                            it on FiGet's own storage, empty until something is uploaded, with the folder untouched.
                            @if (feed.IsFolderBacked && CurrentShare.Length == 0)
                            {
                                <text>Its current folder <code>@feed.FolderRoot</code> is not under the shares mount; saving picks one from the list or moves off it.</text>
                            }
                        </span>
                    </div>
                    <label class="fg-check"><InputCheckbox id="folder-writes" @bind-Value="Folder!.Writes" /> Uploads and deletes through FiGet act on the folder (the share's own permissions still apply)</label>
                    @if (folderError is not null)
                    {
                        <p class="fg-error">@folderError</p>
                    }
                    <button type="submit" class="fg-btn fg-btn-primary">Save content</button>
                </EditForm>
            }
        </Accordion>
    }

    @if (IsAssets)
    {
        <section class="fg-panel">
            <h2>URLs</h2>
            <dl class="fg-facts">
                <dt>Download</dt>
                <dd>
                    <div class="fg-url">
                        <code>@AssetContentUrl</code>
                        <button type="button" class="fg-copy" data-copy="@AssetContentUrl" title="Copy this URL" aria-label="Copy the download URL">Copy</button>
                    </div>
                </dd>
                <dt>Listing (JSON)</dt>
                <dd>
                    <div class="fg-url">
                        <code>@AssetListUrl</code>
                        <button type="button" class="fg-copy" data-copy="@AssetListUrl" title="Copy this URL" aria-label="Copy the listing URL">Copy</button>
                    </div>
                </dd>
            </dl>
            <p class="fg-muted fg-small">Browse and upload files on <a href="/assets/@feed.Name">the directory's page</a>.</p>
        </section>
    }
    else
    {
        <section class="fg-panel">
            <h2>Source URLs</h2>
            <dl class="fg-facts">
                <dt>NuGet v3</dt>
                <dd>
                    <div class="fg-url">
                        <code>@V3Url</code>
                        <button type="button" class="fg-copy" data-copy="@V3Url" title="Copy this URL" aria-label="Copy the v3 source URL">Copy</button>
                    </div>
                </dd>
                <dt>Feed root</dt>
                <dd>
                    <div class="fg-url">
                        <code>@FeedUrl</code>
                        <button type="button" class="fg-copy" data-copy="@FeedUrl" title="Copy this URL" aria-label="Copy the feed root URL">Copy</button>
                    </div>
                </dd>
            </dl>
        </section>
    }
}

@code {
    private int versionCount;
    private string? message;
    private bool messageIsError;

    [SupplyParameterFromForm(FormName = "feed-settings")]
    private SettingsForm? Settings { get; set; }

    [SupplyParameterFromForm(FormName = "feed-networks")]
    private NetworksForm? Networks { get; set; }

    private string? networksError;
    private bool networksSaved;

    [SupplyParameterFromForm(FormName = "feed-folder")]
    private FolderForm? Folder { get; set; }

    private string? folderError;
    private bool folderSaved;
    private IReadOnlyList<ShareFolder> shares = [];

    /// <summary>Named in FiGet:Feeds with a Folder: the start re-applies it, so a choice made here would not survive.</summary>
    private bool FolderFromConfiguration =>
        Options.Value.Feeds.Any(seed =>
            !string.IsNullOrWhiteSpace(seed.Folder)
            && (string.Equals(seed.Name, Target?.Name, StringComparison.OrdinalIgnoreCase)
                || string.Equals(seed.Name, Name, StringComparison.OrdinalIgnoreCase)));

    private bool ShowsFolderForm => IsAssets && IsAdmin && !FolderFromConfiguration;

    /// <summary>The listed folder the directory is on now, by name; empty on FiGet's own storage or a folder outside the mount.</summary>
    private string CurrentShare =>
        shares.FirstOrDefault(share => string.Equals(share.Path, Target?.FolderRoot, StringComparison.Ordinal))?.Name ?? "";

    private string FolderTitle => Target is not { IsFolderBacked: true }
        ? "Content: FiGet's own storage"
        : CurrentShare.Length > 0 ? $"Content: folder {CurrentShare} on the shares mount" : "Content: a folder on the server";

    private string FeedUrl => PublicUrls.Feed(HttpContext, Target!.Name);

    private string V3Url => $"{FeedUrl}/v3/index.json";

    private string AssetContentUrl => $"{PublicUrls.Base(HttpContext)}/endpoints/{Uri.EscapeDataString(Target!.Name)}/content/";

    /// <summary>The colour "Automatic" gives this feed, shown beside it.</summary>
    private int AutomaticColor => FeedColors.Of(new Feed { Key = Target!.Key, Name = "", NameLower = "" });

    private string AssetListUrl => $"{PublicUrls.Base(HttpContext)}/endpoints/{Uri.EscapeDataString(Target!.Name)}/dir/";

    private string NetworksTitle => Target?.AllowedNetworks is null
        ? "Allowed networks: any"
        : $"Allowed networks: {FeedNetworks.Count(Target.AllowedNetworks).ToString(CultureInfo.InvariantCulture)} listed";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // Only seeded on a GET; on a post it already carries what was submitted.
        Settings ??= Target is not { } feed
            ? new SettingsForm()
            : new SettingsForm { AnonymousRead = feed.AnonymousRead, AnonymousList = feed.AnonymousList, AllowOverwrite = feed.AllowOverwrite, DeletionBehavior = feed.DeletionBehavior, MergePushedIdsWithUpstreams = feed.MergePushedIdsWithUpstreams, ChartColor = feed.ChartColor ?? 0 };
        Networks ??= new NetworksForm { Text = Target?.AllowedNetworks ?? "" };
        shares = IsAssets && Shares.IsConfigured ? Shares.List() : [];
        Folder ??= new FolderForm { Share = CurrentShare, Writes = Target?.FolderWritable ?? false };
    }

    private async Task SaveFolderAsync()
    {
        if (Target is not { } feed)
        {
            return;
        }

        // The form is not shown to a manager or for a configured directory, but a form can be posted by hand.
        if (!ShowsFolderForm || !Shares.IsConfigured)
        {
            folderError = "The content of this directory is not chosen here.";
            return;
        }

        var name = (Folder!.Share ?? "").Trim();
        string? root = null;
        if (name.Length > 0 && (root = Shares.Resolve(name)) is null)
        {
            folderError = $"'{name}' is not a folder on the shares mount.";
            return;
        }

        var writes = root is not null && Folder.Writes;

        // False means nothing changed, not that the directory is gone: that is what the reload below says.
        var changed = await Feeds.UpdateFolderAsync(feed.Key, root, writes, HttpContext.RequestAborted);
        if (changed)
        {
            Audit.Record(HttpContext, "feed.folder", feed.Name, $"folder={(root is null ? "none" : name)} folderWrites={writes}");
        }

        await LoadAsync();
        folderSaved = Target is not null;
        (message, messageIsError) = Target is null
            ? ($"This {Noun} no longer exists.", true)
            : (changed ? "Content saved." : "Content unchanged.", false);
    }

    private async Task SaveNetworksAsync()
    {
        if (Target is not { } feed)
        {
            return;
        }

        if ((Networks!.Text ?? "").Length > FeedNetworks.MaxLength)
        {
            networksError = $"The list is longer than {FeedNetworks.MaxLength} characters.";
            return;
        }

        if (!FeedNetworks.TryParse(Networks.Text, out _, out var invalid))
        {
            networksError = $"'{invalid}' is not an address or a range in CIDR notation (10.0.0.0/8; a range starts at its own boundary).";
            return;
        }

        var normalised = FeedNetworks.Normalise(Networks.Text);
        networksSaved = await Feeds.UpdateAllowedNetworksAsync(feed.Key, normalised, HttpContext.RequestAborted);
        if (networksSaved)
        {
            // The list itself: "who opened this feed to that network" is what the audit log is asked.
            Audit.Record(HttpContext, "feed.networks", feed.Name, $"networks={(normalised is null ? "any" : normalised.Replace('\n', ' '))}");
        }

        (message, messageIsError) = networksSaved ? ("Allowed networks saved.", false) : ($"This {Noun} no longer exists.", true);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (await LoadFeedAsync())
        {
            versionCount = IsAssets
                ? await Feeds.CountAssetsAsync(Target!.Key, HttpContext.RequestAborted)
                : await Feeds.CountVersionsAsync(Target!.Key, HttpContext.RequestAborted);
        }
    }

    private async Task SaveAsync()
    {
        if (Target is not { } feed)
        {
            return;
        }

        var saved = await Feeds.UpdateSettingsAsync(
            feed.Key, Settings!.AnonymousRead, Settings!.AnonymousList, Settings!.AllowOverwrite, Settings!.DeletionBehavior, Settings!.MergePushedIdsWithUpstreams, Settings!.ChartColor is 0 ? null : Settings!.ChartColor, HttpContext.RequestAborted);

        if (saved)
        {
            // The values, not just that something changed: "who loosened this feed" is the question a
            // settings audit is asked, and it cannot be answered by a bare "settings saved".
            Audit.Record(
                HttpContext,
                "feed.settings",
                feed.Name,
                $"anonymousRead={Settings!.AnonymousRead} anonymousList={Settings!.AnonymousList} allowOverwrite={Settings!.AllowOverwrite} onDelete={Settings!.DeletionBehavior} mergePushedIds={Settings!.MergePushedIdsWithUpstreams} chartColor={(Settings!.ChartColor is 0 ? "automatic" : Settings!.ChartColor.ToString(CultureInfo.InvariantCulture))}");
        }

        (message, messageIsError) = saved ? ("Settings saved.", false) : ("This feed no longer exists.", true);
        await LoadAsync();
    }

    private sealed class NetworksForm
    {
        public string? Text { get; set; }
    }

    private sealed class FolderForm
    {
        /// <summary>Empty for FiGet's own storage, else the name of a sub-folder of the shares mount. A name, never a path.</summary>
        public string Share { get; set; } = "";

        public bool Writes { get; set; }
    }

    private sealed class SettingsForm
    {
        public bool AnonymousRead { get; set; }

        public bool AnonymousList { get; set; }

        public bool AllowOverwrite { get; set; }

        public PackageDeletionBehavior DeletionBehavior { get; set; } = PackageDeletionBehavior.Unlist;

        public bool MergePushedIdsWithUpstreams { get; set; }

        /// <summary>0 for automatic: a radio group needs a value for every choice, and null is not one it can post.</summary>
        public int ChartColor { get; set; }
    }
}
