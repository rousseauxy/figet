@page "/admin/feeds/{Name}"
@page "/admin/assets/{Name}"
@attribute [Authorize]
@layout AdminLayout
@inherits FeedAdminPage
@inject FiGet.Http.AuditLog Audit

<PageTitle>@Name settings · FiGet</PageTitle>

<FeedAdminHeader Feed="Target" Name="@Name" />

@if (Target is { } feed)
{
    @if (message is not null)
    {
        <div class="@(messageIsError ? "fg-alert fg-alert-danger" : "fg-alert fg-alert-ok")">@message</div>
    }

    <section class="fg-panel">
        <h2>Settings</h2>
        <EditForm Model="Settings!" FormName="feed-settings" OnValidSubmit="SaveAsync" method="post" class="fg-form">
            <label class="fg-check"><InputCheckbox id="anonymous-read" @bind-Value="Settings!.AnonymousRead" /> Anyone can read without a token</label>
            @if (IsAssets)
            {
                <p class="fg-muted fg-small">Uploading and deleting always need a token or a signed-in admin, whatever this says.</p>
            }
            else
            {
                <label class="fg-check"><InputCheckbox id="allow-overwrite" @bind-Value="Settings!.AllowOverwrite" /> Pushing an existing version replaces it</label>

                <div class="fg-field">
                    <label for="delete-behaviour">Delete behaviour</label>
                    <InputSelect id="delete-behaviour" @bind-Value="Settings!.DeletionBehavior">
                        <option value="@PackageDeletionBehavior.Unlist">Unlist (recommended)</option>
                        <option value="@PackageDeletionBehavior.HardDelete">Hard delete</option>
                    </InputSelect>
                </div>

                @if (feed.Upstreams.Count > 0)
                {
                    <label class="fg-check"><InputCheckbox id="merge-pushed-ids" @bind-Value="Settings!.MergePushedIdsWithUpstreams" /> Merge pushed packages with upstream packages of the same id</label>
                    <p class="fg-muted fg-small">
                        Off, an id pushed here is served only from this feed, and an upstream package with the same
                        name is no longer offered. On, both are merged into one version list and the higher version of
                        either becomes the latest - only right when the upstream package really is the same one.
                    </p>
                }
            }

            @* One row of dots, the dot itself being the control: the native radio is hidden and the chosen dot wears a
               ring. Not a dropdown, which cannot show a colour, and not a colour picker, which would lose the point of
               the palette - nine hues chosen to stay apart from each other on the graph in both themes. *@
            <fieldset class="fg-swatches">
                <legend>Colour on the usage graph</legend>
                <InputRadioGroup @bind-Value="Settings!.ChartColor" class="fg-swatch-row">
                    <label class="fg-swatch" title="Picked for this @Noun, the same every time">
                        <InputRadio Value="0" /><span class="fg-series-dot" style="--series: var(--fg-series-@AutomaticColor)"></span><span>Automatic</span>
                    </label>
                    @for (var color = 1; color <= FeedColors.Count; color++)
                    {
                        var value = color;
                        <label class="fg-swatch" title="Colour @value">
                            <InputRadio Value="value" /><span class="fg-series-dot" style="--series: var(--fg-series-@value)"></span><span class="fg-sr-only">Colour @value</span>
                        </label>
                    }
                </InputRadioGroup>
            </fieldset>

            <button type="submit" class="fg-btn fg-btn-primary">Save settings</button>
        </EditForm>

        <dl class="fg-facts">
            <dt>Kind</dt><dd>@Display.Kind(feed.Kind)</dd>
            <dt>Created</dt><dd class="fg-num">@feed.CreatedUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</dd>
            <dt>@(IsAssets ? "Files" : "Versions")</dt><dd class="fg-num">@versionCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
        </dl>
    </section>

    @if (IsAssets)
    {
        <section class="fg-panel">
            <h2>URLs</h2>
            <dl class="fg-facts">
                <dt>Download</dt>
                <dd>
                    <div class="fg-url">
                        <code>@AssetContentUrl</code>
                        <button type="button" class="fg-copy" data-copy="@AssetContentUrl" title="Copy this URL" aria-label="Copy the download URL">Copy</button>
                    </div>
                </dd>
                <dt>Listing (JSON)</dt>
                <dd>
                    <div class="fg-url">
                        <code>@AssetListUrl</code>
                        <button type="button" class="fg-copy" data-copy="@AssetListUrl" title="Copy this URL" aria-label="Copy the listing URL">Copy</button>
                    </div>
                </dd>
            </dl>
            <p class="fg-muted fg-small">Browse and upload files on <a href="/assets/@feed.Name">the directory's page</a>.</p>
        </section>
    }
    else
    {
        <section class="fg-panel">
            <h2>Source URLs</h2>
            <dl class="fg-facts">
                <dt>NuGet v3</dt>
                <dd>
                    <div class="fg-url">
                        <code>@V3Url</code>
                        <button type="button" class="fg-copy" data-copy="@V3Url" title="Copy this URL" aria-label="Copy the v3 source URL">Copy</button>
                    </div>
                </dd>
                <dt>Feed root</dt>
                <dd>
                    <div class="fg-url">
                        <code>@FeedUrl</code>
                        <button type="button" class="fg-copy" data-copy="@FeedUrl" title="Copy this URL" aria-label="Copy the feed root URL">Copy</button>
                    </div>
                </dd>
            </dl>
        </section>
    }
}

@code {
    private int versionCount;
    private string? message;
    private bool messageIsError;

    [SupplyParameterFromForm(FormName = "feed-settings")]
    private SettingsForm? Settings { get; set; }

    private string FeedUrl => PublicUrls.Feed(HttpContext, Target!.Name);

    private string V3Url => $"{FeedUrl}/v3/index.json";

    private string AssetContentUrl => $"{PublicUrls.Base(HttpContext)}/endpoints/{Uri.EscapeDataString(Target!.Name)}/content/";

    /// <summary>The colour "Automatic" gives this feed, shown beside it.</summary>
    private int AutomaticColor => FeedColors.Of(new Feed { Key = Target!.Key, Name = "", NameLower = "" });

    private string AssetListUrl => $"{PublicUrls.Base(HttpContext)}/endpoints/{Uri.EscapeDataString(Target!.Name)}/dir/";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // Only seeded on a GET; on a post it already carries what was submitted.
        Settings ??= Target is not { } feed
            ? new SettingsForm()
            : new SettingsForm { AnonymousRead = feed.AnonymousRead, AllowOverwrite = feed.AllowOverwrite, DeletionBehavior = feed.DeletionBehavior, MergePushedIdsWithUpstreams = feed.MergePushedIdsWithUpstreams, ChartColor = feed.ChartColor ?? 0 };
    }

    private async Task LoadAsync()
    {
        if (await LoadFeedAsync())
        {
            versionCount = IsAssets
                ? await Feeds.CountAssetsAsync(Target!.Key, HttpContext.RequestAborted)
                : await Feeds.CountVersionsAsync(Target!.Key, HttpContext.RequestAborted);
        }
    }

    private async Task SaveAsync()
    {
        if (Target is not { } feed)
        {
            return;
        }

        var saved = await Feeds.UpdateSettingsAsync(
            feed.Key, Settings!.AnonymousRead, Settings!.AllowOverwrite, Settings!.DeletionBehavior, Settings!.MergePushedIdsWithUpstreams, Settings!.ChartColor is 0 ? null : Settings!.ChartColor, HttpContext.RequestAborted);

        if (saved)
        {
            // The values, not just that something changed: "who loosened this feed" is the question a
            // settings audit is asked, and it cannot be answered by a bare "settings saved".
            Audit.Record(
                HttpContext,
                "feed.settings",
                feed.Name,
                $"anonymousRead={Settings!.AnonymousRead} allowOverwrite={Settings!.AllowOverwrite} onDelete={Settings!.DeletionBehavior} mergePushedIds={Settings!.MergePushedIdsWithUpstreams} chartColor={(Settings!.ChartColor is 0 ? "automatic" : Settings!.ChartColor.ToString(CultureInfo.InvariantCulture))}");
        }

        (message, messageIsError) = saved ? ("Settings saved.", false) : ("This feed no longer exists.", true);
        await LoadAsync();
    }

    private sealed class SettingsForm
    {
        public bool AnonymousRead { get; set; }

        public bool AllowOverwrite { get; set; }

        public PackageDeletionBehavior DeletionBehavior { get; set; } = PackageDeletionBehavior.Unlist;

        public bool MergePushedIdsWithUpstreams { get; set; }

        /// <summary>0 for automatic: a radio group needs a value for every choice, and null is not one it can post.</summary>
        public int ChartColor { get; set; }
    }
}
