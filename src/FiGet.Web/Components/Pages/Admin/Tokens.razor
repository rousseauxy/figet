@page "/admin/tokens"
@attribute [Authorize(Policy = FiGetApp.AdminPolicy)]
@layout AdminLayout
@using System.ComponentModel.DataAnnotations
@using FiGet.Application.Tokens
@inject IAccessTokenStore Store
@inject IFeedStore Feeds
@inject AccessTokenService TokenService
@inject FiGet.Http.AuditLog Audit
@inject TimeProvider Time

<PageTitle>Tokens · FiGet</PageTitle>

@*
    Service tokens belong to nobody: automation that must keep working when a person leaves. Personal keys are made by
    their owners on the profile page and listed here so an admin can revoke one; they act as their owner and never more.
*@

<h1>Tokens</h1>
<p class="fg-lede">
    Clients send a token as <code>X-NuGet-ApiKey</code> (push), or as the password of Basic authentication
    (read). Only a hash is stored: a token is shown once, when it is created.
</p>

@if (created is not null)
{
    <div class="fg-secret" role="status">
        <p><strong>Token “@created.Token.Name” created.</strong> Copy it now; it will not be shown again.</p>
        <div class="fg-url">
            <pre><code>@created.Secret</code></pre>
            <button type="button" class="fg-copy" data-copy="@created.Secret" title="Copy this token" aria-label="Copy the new token">Copy</button>
        </div>
    </div>
}

<h2>Service tokens</h2>
@if (!tokens.Any(t => t.UserKey is null))
{
    <p class="fg-empty">No service tokens. Make one below for automation that should not depend on a person.</p>
}
else
{
    <div class="fg-table-wrap">
        <table class="fg-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Prefix</th>
                    <th>Scopes</th>
                    <th>Feed</th>
                    <th>Created</th>
                    <th>Last used</th>
                    <th>Expires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in tokens.Where(t => t.UserKey is null))
                {
                    var active = token.RevokedUtc is null && (token.ExpiresUtc is null || token.ExpiresUtc > now);
                    <tr class="@(active ? "" : "is-inactive")">
                        <td>@token.Name</td>
                        <td><code>@token.Prefix…</code></td>
                        <td><span class="fg-badge">@token.Scopes</span></td>
                        <td>@(token.Feed?.Name ?? "All feeds")</td>
                        <td class="fg-num">@Date(token.CreatedUtc)</td>
                        <td class="fg-num">@Date(token.LastUsedUtc)</td>
                        <td>
                            @if (token.RevokedUtc is not null)
                            {
                                <span class="fg-badge fg-badge-danger">Revoked</span>
                            }
                            else
                            {
                                <span class="fg-num">@Date(token.ExpiresUtc, "Never")</span>
                            }
                        </td>
                        <td class="fg-cell-actions">
                            @if (token.RevokedUtc is null)
                            {
                                <form method="post" @formname="@($"revoke-{token.Key}")" @onsubmit="() => RevokeAsync(token.Key)">
                                    <AntiforgeryToken />
                                    <button type="submit" class="fg-btn fg-btn-sm fg-btn-danger">Revoke</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2>Personal keys</h2>
@if (!tokens.Any(t => t.UserKey is not null))
{
    <p class="fg-empty">Nobody has made a personal key yet. Each account makes its own on its profile page.</p>
}
else
{
    <div class="fg-table-wrap">
        <table class="fg-table">
            <thead>
                <tr>
                    <th>Owner</th>
                    <th>Name</th>
                    <th>Prefix</th>
                    <th>Limited to</th>
                    <th>Last used</th>
                    <th>Expires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in tokens.Where(t => t.UserKey is not null))
                {
                    var active = token.RevokedUtc is null && (token.ExpiresUtc is null || token.ExpiresUtc > now);
                    <tr class="@(active ? "" : "is-inactive")">
                        <td><a href="/admin/users/@token.UserKey">@(token.User?.UserName ?? "?")</a></td>
                        <td>@token.Name</td>
                        <td><code>@token.Prefix…</code></td>
                        <td>@PersonalKeyLimits(token)</td>
                        <td class="fg-num">@Date(token.LastUsedUtc)</td>
                        <td>
                            @if (token.RevokedUtc is not null)
                            {
                                <span class="fg-badge fg-badge-danger">Revoked</span>
                            }
                            else
                            {
                                <span class="fg-num">@Date(token.ExpiresUtc, "Never")</span>
                            }
                        </td>
                        <td class="fg-cell-actions">
                            @if (token.RevokedUtc is null)
                            {
                                <form method="post" @formname="@($"revoke-{token.Key}")" @onsubmit="() => RevokeAsync(token.Key)">
                                    <AntiforgeryToken />
                                    <button type="submit" class="fg-btn fg-btn-sm fg-btn-danger">Revoke</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2>Create a service token</h2>
<div class="fg-panel">
    <EditForm Model="NewToken!" FormName="create-token" OnValidSubmit="CreateAsync" method="post" class="fg-form">
        <DataAnnotationsValidator />
        <div class="fg-field">
            <label for="token-name">Name</label>
            <InputText id="token-name" @bind-Value="NewToken!.Name" placeholder="for example: ci-publish" />
            <ValidationMessage For="() => NewToken!.Name" />
        </div>

        <fieldset>
            <legend>Scopes</legend>
            <label class="fg-check"><InputCheckbox @bind-Value="NewToken!.Read" /> Read</label>
            <label class="fg-check"><InputCheckbox @bind-Value="NewToken!.Push" /> Push (includes read)</label>
            <label class="fg-check"><InputCheckbox @bind-Value="NewToken!.Delete" /> Delete and relist (includes read)</label>
            @if (IsSuperAdmin)
            {
                <label class="fg-check"><InputCheckbox @bind-Value="NewToken!.Admin" /> Admin (every scope on every feed)</label>
            }
        </fieldset>

        <div class="fg-field">
            <label for="token-feed">Feed</label>
            <InputSelect id="token-feed" @bind-Value="NewToken!.FeedName">
                <option value="">All feeds</option>
                @foreach (var feed in feeds)
                {
                    <option value="@feed.Name">@feed.Name</option>
                }
            </InputSelect>
        </div>

        <div class="fg-field">
            <label for="token-expiry">Expires after (days, empty for never)</label>
            <InputNumber id="token-expiry" @bind-Value="NewToken!.ExpiresInDays" min="1" />
        </div>

        @if (error is not null)
        {
            <p class="fg-error">@error</p>
        }
        <button type="submit" class="fg-btn fg-btn-primary">Create service token</button>
    </EditForm>
</div>

@code {
    private IReadOnlyList<AccessToken> tokens = [];
    private IReadOnlyList<Feed> feeds = [];
    private CreatedToken? created;
    private string? error;
    private DateTime now;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "create-token")]
    private TokenForm? NewToken { get; set; }

    protected override void OnInitialized() => NewToken ??= new();

    protected override async Task OnInitializedAsync()
    {
        now = Time.GetUtcNow().UtcDateTime;
        feeds = await Feeds.ListAsync(HttpContext.RequestAborted);
        tokens = await Store.ListAsync(HttpContext.RequestAborted);
    }

    private async Task CreateAsync()
    {
        var scopes = (NewToken!.Read ? TokenScopes.Read : 0)
            | (NewToken!.Push ? TokenScopes.Push : 0)
            | (NewToken!.Delete ? TokenScopes.Delete : 0)
            | (NewToken!.Admin ? TokenScopes.Admin : 0);
        if (scopes == TokenScopes.None)
        {
            error = "Choose at least one scope.";
            return;
        }

        int? feedKey = null;
        if (!string.IsNullOrEmpty(NewToken!.FeedName))
        {
            var feed = feeds.FirstOrDefault(f => f.Name == NewToken!.FeedName);
            if (feed is null)
            {
                error = "That feed does not exist.";
                return;
            }

            feedKey = feed.Key;
        }

        DateTime? expires = NewToken!.ExpiresInDays is > 0 ? now.AddDays(NewToken!.ExpiresInDays.Value) : null;
        var result = await TokenService.CreateServiceTokenAsync(FiGetApp.Actor(HttpContext.User)!, NewToken!.Name, scopes, feedKey, expires, HttpContext.RequestAborted);
        if (result.Created is null)
        {
            error = result.Status == TokenCreateStatus.AboveYourRights
                ? "Only a super admin creates a token with the admin scope."
                : "Enter a name and choose at least one scope.";
            return;
        }

        created = result.Created;
        Audit.Record(
            HttpContext,
            "token.create",
            NewToken!.Name.Trim(),
            $"scopes={scopes} feed={NewToken!.FeedName ?? "all"} expires={(expires is null ? "never" : expires.Value.ToString("u"))}");
        tokens = await Store.ListAsync(HttpContext.RequestAborted);
        NewToken = new();
    }

    private async Task RevokeAsync(int key)
    {
        // Named before it goes: after revocation the row is still there, but reading it back to name it
        // would be a second query for something already on screen.
        var revoked = tokens.FirstOrDefault(t => t.Key == key);
        await TokenService.RevokeAsync(key, HttpContext.RequestAborted);
        Audit.Record(HttpContext, "token.revoke", revoked?.Name ?? key.ToString(CultureInfo.InvariantCulture));
        tokens = await Store.ListAsync(HttpContext.RequestAborted);
    }

    private bool IsSuperAdmin => HttpContext.User.IsInRole(FiGetApp.SuperAdminRole);

    private static string PersonalKeyLimits(AccessToken token) =>
        (token.Scopes.HasFlag(TokenScopes.Push) ? "Read and publish" : "Read") + " · " + (token.Feed?.Name ?? "all feeds");

    private static string Date(DateTime? value, string empty = "—") =>
        value is null ? empty : value.Value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    private sealed class TokenForm
    {
        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(128)]
        public string Name { get; set; } = "";

        public bool Read { get; set; } = true;

        public bool Push { get; set; }

        public bool Delete { get; set; }

        public bool Admin { get; set; }

        public string FeedName { get; set; } = "";

        public int? ExpiresInDays { get; set; }
    }
}
