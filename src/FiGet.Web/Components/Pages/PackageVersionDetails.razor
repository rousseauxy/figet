@page "/feeds/{Name}/packages/{Id}/{Version}"
@using System.IO.Compression
@using System.Security.Claims
@using FiGet.Application.Connectors
@using FiGet.Application.Ports
@using FiGet.Domain.Versions
@inject IFeedStore Feeds
@inject IPackageStore Packages
@inject IPackageStorage Storage
@inject ConnectorService Connector

<PageTitle>@Id @Version · FiGet</PageTitle>

@if (feed is null || entry is null)
{
    <h1>Version not found</h1>
    <p class="fg-muted">
        <code>@Id</code> <code>@Version</code> is not in feed <code>@Name</code>.
        <a href="/feeds/@Name">Back to the feed</a>.
    </p>
    return;
}

<p class="fg-crumbs">
    <a href="/">Feeds</a>
    <span class="fg-crumb-sep">/</span>
    <a href="/feeds/@feed.Name">@feed.Name</a>
    <span class="fg-crumb-sep">/</span>
    <a href="/feeds/@feed.Name/packages/@displayId">@displayId</a>
    <span class="fg-crumb-sep">/</span>
    <span>@row.NormalizedVersion</span>
</p>

<div class="fg-page-head">
    <h1>@displayId</h1>
    <span class="fg-version">@row.NormalizedVersion</span>
</div>

<div class="fg-toolbar">
    <span class="fg-badge @OriginBadge">@origin</span>
    @if (!row.Listed)
    {
        <span class="fg-badge fg-badge-warn">unlisted</span>
    }
    @if (entry.IsAbsoluteLatestVersion)
    {
        <span class="fg-badge fg-badge-accent">latest</span>
    }
    @if (entry.IsLatestVersion && !entry.IsAbsoluteLatestVersion)
    {
        <span class="fg-badge fg-badge-accent">latest stable</span>
    }

    <span class="fg-right"></span>

    @if (IsLocal)
    {
        <a class="fg-btn fg-btn-primary" href="@(feedUrl)/package/@displayId/@row.NormalizedVersion">Download</a>
    }
    else if (IsAdmin)
    {
        @* Not here yet: fetch it from the upstream and keep it, so a machine without internet can have it. *@
        <form method="post" action="/admin/feeds/@feed.Name/pull">
            <AntiforgeryToken />
            <input type="hidden" name="id" value="@displayId" />
            <input type="hidden" name="version" value="@row.NormalizedVersion" />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <button type="submit" class="fg-btn fg-btn-primary">Pull into this feed</button>
        </form>
    }
    else
    {
        <span class="fg-muted fg-small">Held by an upstream. Downloading it through a client caches it here.</span>
    }
</div>

<nav class="fg-tabs">
    <a class="fg-tab @Active("")" href="@TabLink("")">Overview</a>
    <a class="fg-tab @Active("metadata")" href="@TabLink("metadata")">Metadata</a>
    <a class="fg-tab @Active("dependencies")" href="@TabLink("dependencies")">Dependencies</a>
    @if (IsLocal)
    {
        <a class="fg-tab @Active("files")" href="@TabLink("files")">Files</a>
    }
</nav>

@switch (CurrentTab)
{
    case "metadata":
        <div class="fg-panel">
            <dl class="fg-facts">
                <dt>Id</dt><dd>@displayId</dd>
                <dt>Version</dt><dd class="fg-num">@row.NormalizedVersion@(row.OriginalVersion == row.NormalizedVersion ? "" : $" (published as {row.OriginalVersion})")</dd>
                <dt>Authors</dt><dd>@(string.IsNullOrWhiteSpace(row.Authors) ? "—" : row.Authors)</dd>
                <dt>Origin</dt><dd>@origin</dd>
                <dt>Published</dt><dd class="fg-num">@(row.PublishedUtc == default ? "—" : row.PublishedUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC")</dd>
                <dt>Size</dt><dd class="fg-num">@(IsLocal ? FormatSize(row.Size) : "—")</dd>
                <dt>Downloads</dt><dd class="fg-num">@row.Downloads.ToString("N0", CultureInfo.InvariantCulture)</dd>
                <dt>Licence</dt>
                <dd>
                    @if (row.LicenseExpression is { Length: > 0 } expression)
                    {
                        @expression
                    }
                    else if (Link(row.LicenseUrl) is { } licence)
                    {
                        <a href="@licence" rel="noopener noreferrer">@licence</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </dd>
                <dt>Project</dt>
                <dd>
                    @if (Link(row.ProjectUrl) is { } project)
                    {
                        <a href="@project" rel="noopener noreferrer">@project</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </dd>
                <dt>Hash</dt><dd class="fg-num">@(string.IsNullOrWhiteSpace(row.Hash) ? "—" : row.HashAlgorithm + " " + row.Hash)</dd>
            </dl>
        </div>

        <h2>Tags</h2>
        @if (Tags.Count == 0)
        {
            <p class="fg-muted">None.</p>
        }
        else
        {
            <div class="fg-chips">
                @foreach (var tag in Tags.Where(t => !IsGenerated(t)))
                {
                    <span class="fg-chip">@tag</span>
                }
            </div>

            @* A PowerShell module publishes one tag per exported command. Useful to search, useless to read. *@
            @if (Tags.Any(IsGenerated))
            {
                <details class="fg-more">
                    <summary>@Tags.Count(IsGenerated) command and function tags</summary>
                    <div class="fg-chips">
                        @foreach (var tag in Tags.Where(IsGenerated))
                        {
                            <span class="fg-chip">@tag</span>
                        }
                    </div>
                </details>
            }
        }
        break;

    case "dependencies":
        @if (dependencies.Count == 0)
        {
            <p class="fg-empty">
                @(IsLocal ? "This version declares no dependencies." : "Known once the package is here: dependencies are read from the package itself.")
            </p>
        }
        else
        {
            @foreach (var group in dependencies.GroupBy(d => d.TargetFramework))
            {
                <h2>@(string.IsNullOrWhiteSpace(group.Key) ? "Any framework" : group.Key)</h2>
                @if (group.All(d => d.Id is null))
                {
                    <p class="fg-muted">No dependencies for this target.</p>
                }
                else
                {
                    <div class="fg-table-wrap">
                        <table class="fg-table">
                            <thead>
                                <tr><th>Package</th><th>Version range</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var dependency in group.Where(d => d.Id is not null).OrderBy(d => d.Ordinal))
                                {
                                    <tr>
                                        <td><a href="/feeds/@feed.Name/packages/@dependency.Id">@dependency.Id</a></td>
                                        <td class="fg-num">@(string.IsNullOrWhiteSpace(dependency.VersionRange) ? "any" : dependency.VersionRange)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
        break;

    case "files":
        @if (files is null)
        {
            <p class="fg-empty">The package file could not be read.</p>
        }
        else
        {
            <p class="fg-result-count">@files.Count file@(files.Count == 1 ? "" : "s") inside the package.</p>
            <div class="fg-table-wrap">
                <table class="fg-table">
                    <thead>
                        <tr><th>Path</th><th>Size</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var file in files)
                        {
                            <tr><td><code>@file.Path</code></td><td class="fg-num">@FormatSize(file.Length)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        break;

    default:
        @if (!string.IsNullOrWhiteSpace(row.Description))
        {
            <p class="fg-lede">@row.Description</p>
        }

        <h2>Install this version</h2>
        <pre><code>Install-Module -Name @displayId -RequiredVersion @row.NormalizedVersion -Repository @feed.Name</code></pre>
        <pre><code>Install-PSResource -Name @displayId -Version @row.NormalizedVersion -Repository @feed.Name</code></pre>
        <pre><code>dotnet add package @displayId --version @row.NormalizedVersion --source @(feedUrl)/v3/index.json</code></pre>
        break;
}

@code {
    /// <summary>Tags a PowerShell module generates, one per exported command. Folded away, never dropped.</summary>
    private static readonly string[] GeneratedTagPrefixes =
        ["PSCommand_", "PSFunction_", "PSCmdlet_", "PSDscResource_", "PSRoleCapability_", "PSWorkflow_"];

    private Feed? feed;
    private string displayId = "";
    private string feedUrl = "";
    private string origin = "";
    private VersionListEntry<PackageVersion>? entry;
    private IReadOnlyList<PackageDependency> dependencies = [];
    private IReadOnlyList<PackageFile>? files;

    [Parameter]
    public string Name { get; set; } = "";

    [Parameter]
    public string Id { get; set; } = "";

    [Parameter]
    public string Version { get; set; } = "";

    [SupplyParameterFromQuery(Name = "tab")]
    private string? Tab { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private PackageVersion row => entry!.Payload!;

    private bool IsLocal => entry!.Source == VersionSource.Local;

    private bool IsAdmin => HttpContext.User.HasClaim(ClaimTypes.Role, "admin");

    private string ReturnUrl => HttpContext.Request.Path + HttpContext.Request.QueryString;

    private string CurrentTab => (Tab ?? "").Trim().ToLowerInvariant();

    private string OriginBadge => entry!.Source switch
    {
        VersionSource.Local when row.Origin == PackageOrigin.Cached => "fg-badge-info",
        VersionSource.Local => "fg-badge-accent",
        _ => "fg-badge-plain",
    };

    private List<string> Tags =>
        row.Tags.Split([' ', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    protected override async Task OnInitializedAsync()
    {
        feed = await Feeds.FindAsync(Name, HttpContext.RequestAborted);
        if (feed is not null && !feed.AnonymousRead && !IsAdmin)
        {
            feed = null;
        }

        if (feed is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var idLower = Id.ToLowerInvariant();
        var upstream = feed.Upstreams.Count == 0
            ? []
            : await Connector.UpstreamCandidatesAsync(feed, idLower, HttpContext.RequestAborted);

        var package = await Packages.GetPackageAsync(feed.Key, idLower, includeDependencies: true, HttpContext.RequestAborted);
        var local = package?.Versions ?? [];
        var merged = VersionListBuilder
            .Build(local.Select(VersionListBuilder.ToCandidate).Concat(upstream), includeSemVer2: true)
            .Where(e => e.Payload is not null)
            .ToList();

        entry = merged.FirstOrDefault(e =>
            e.Payload!.NormalizedVersion.Equals(Version, StringComparison.OrdinalIgnoreCase)
            || e.Payload!.OriginalVersion.Equals(Version, StringComparison.OrdinalIgnoreCase));

        if (entry is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        displayId = package?.Id ?? Id;
        feedUrl = PublicUrls.Feed(HttpContext, feed.Name);
        origin = entry.Source switch
        {
            VersionSource.Local when row.Origin == PackageOrigin.Cached => "Cached from an upstream",
            VersionSource.Local => "Pushed to this feed",
            _ => "Upstream only",
        };

        dependencies = row.Dependencies.OrderBy(d => d.Ordinal).ToList();
        if (IsLocal && CurrentTab == "files")
        {
            files = await ReadFilesAsync();
        }
    }

    /// <summary>
    /// The entries of the stored package, read on demand. Only for a version held here: there is nothing
    /// to open for one that still lives upstream.
    /// </summary>
    private async Task<IReadOnlyList<PackageFile>?> ReadFilesAsync()
    {
        var key = new PackageStorageKey(feed!.NameLower, displayId.ToLowerInvariant(), row.NormalizedVersionLower);
        var stream = await Storage.OpenPackageAsync(key, HttpContext.RequestAborted);
        if (stream is null)
        {
            return null;
        }

        await using (stream)
        {
            try
            {
                using var archive = new ZipArchive(stream, ZipArchiveMode.Read);
                return archive.Entries
                    .Where(e => e.Length > 0 || !e.FullName.EndsWith('/'))
                    .Select(e => new PackageFile(e.FullName, e.Length))
                    .OrderBy(f => f.Path, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            catch (InvalidDataException)
            {
                // A stored file that is not a readable zip is a storage problem, not a page error.
                return null;
            }
        }
    }

    private string TabLink(string tab)
    {
        var link = $"/feeds/{Uri.EscapeDataString(Name)}/packages/{Uri.EscapeDataString(displayId)}/{Uri.EscapeDataString(row.NormalizedVersion)}";
        return tab.Length == 0 ? link : link + "?tab=" + tab;
    }

    private string Active(string tab) => CurrentTab == tab ? "active" : "";

    private static bool IsGenerated(string tag) =>
        GeneratedTagPrefixes.Any(prefix => tag.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));

    private static string? Link(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var parsed) && parsed.Scheme is "https" or "http" ? parsed.ToString() : null;

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => (bytes / 1024d / 1024d).ToString("0.0", CultureInfo.InvariantCulture) + " MB",
        >= 1024 => (bytes / 1024d).ToString("0", CultureInfo.InvariantCulture) + " KB",
        _ => bytes.ToString(CultureInfo.InvariantCulture) + " B",
    };

    private sealed record PackageFile(string Path, long Length);
}
