@*
    The admin area's frame: one navigation for everything that changes something, so the public pages can
    stay read-only. Nested inside MainLayout rather than replacing it, because the site header, the theme
    toggle and the sign-out button belong on these pages too.

    Which feed is being managed is read from the URL rather than passed in. A layout cannot take parameters
    from the page it wraps, and the alternative - a cascading value every admin page has to remember to set
    - fails silently on the one page that forgets. The URL also says what kind it is: an asset directory is
    managed under /admin/assets, a package feed under /admin/feeds.

    The same links are rendered twice: as a column beside the page on a wide screen, and as a menu that opens
    from a bar on a narrow one. A <details> element, not a script, because every page is statically rendered and
    the menu has to open with no script at all.
*@
@inherits LayoutComponentBase
@layout MainLayout
@inject NavigationManager Navigation

@*
    The Manage group is for admins. An account that manages or publishes to one feed reaches that feed's pages through
    its own settings button, and sees only that feed's group here.
*@

<div class="fg-admin-shell">
    <nav class="fg-admin-nav" aria-label="Admin">
        @Links
    </nav>

    <details class="fg-admin-menu">
        <summary>
            <span class="fg-admin-menu-icon" aria-hidden="true">☰</span>
            <span class="fg-admin-menu-label">Admin</span>
            @if (CurrentLabel is { } label)
            {
                <span class="fg-admin-menu-current">@label</span>
            }
            <span class="fg-admin-menu-caret" aria-hidden="true">▾</span>
        </summary>
        <nav class="fg-admin-menu-panel" aria-label="Admin">
            @Links
        </nav>
    </details>

    <div class="fg-admin-body">
        @Body
    </div>
</div>

@code {
    private RenderFragment Links => @<text>
        @foreach (var group in Groups)
        {
            <div class="fg-admin-nav-group">
                <span class="fg-admin-nav-title">@group.Title</span>
                @foreach (var link in group.Links)
                {
                    <a class="fg-admin-nav-link @(IsActive(link) ? "active" : "")" href="@link.Href" aria-current="@(IsActive(link) ? "page" : null)">@link.Label</a>
                }
            </div>
        }
    </text>;

    private sealed record NavLink(string Label, string Href, bool Highlights = true);

    /// <summary>A section of the menu. A feed's own section names the feed in the closed menu bar; the fixed ones do not need to.</summary>
    private sealed record NavGroup(string Title, IReadOnlyList<NavLink> Links, bool TitleInMenuBar = false);

    private IReadOnlyList<NavGroup> Groups
    {
        get
        {
            var groups = new List<NavGroup>();
            if (HttpContext?.User.IsInRole(FiGetApp.AdminRole) == true)
            {
                groups.Add(new("Manage",
                [
                    new("Feeds", "/admin/feeds"),
                    new("Assets", "/admin/assets"),
                    new("Appearance", "/admin/appearance"),
                    new("Audit log", "/admin/audit"),
                    new("Storage check", "/admin/storage"),
                ]));
                var authentication = new List<NavLink>
                {
                    new("Users", "/admin/users"),
                    new("Groups", "/admin/groups"),
                    new("Tokens", "/admin/tokens"),
                };
                if (HttpContext.User.IsInRole(FiGetApp.SuperAdminRole))
                {
                    authentication.Add(new("Providers", "/admin/providers"));
                }

                groups.Add(new("Authentication", authentication));
            }

            if (Managed is { } managed)
            {
                // One page per section of the settings. Name and deletion only for admins: renaming changes every client's
                // URL and deleting removes the feed, which a grant of Manage does not cover.
                var name = Uri.EscapeDataString(managed.Name);
                var isAdmin = HttpContext?.User.IsInRole(FiGetApp.AdminRole) == true;
                var root = (managed.IsAssets ? "/admin/assets/" : "/admin/feeds/") + name;
                var links = new List<NavLink> { new("Settings", root) };
                if (!managed.IsAssets)
                {
                    links.Add(new("Upstreams", $"{root}/upstreams"));
                    links.Add(new("Retention", $"{root}/retention"));
                }

                links.Add(new("Instructions", $"{root}/instructions"));
                links.Add(new("Access", $"{root}/access"));
                if (isAdmin)
                {
                    links.Add(new("Name and deletion", $"{root}/name"));
                }

                if (managed.IsAssets)
                {
                    links.Add(new("Browse files", $"/assets/{name}", Highlights: false));
                }
                else
                {
                    links.Add(new("Unlisted versions", $"{root}/unlisted"));
                    links.Add(new("View as a reader", $"/feeds/{name}", Highlights: false));
                }

                groups.Add(new NavGroup(managed.Name, links, TitleInMenuBar: true));
            }

            return groups;
        }
    }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The path alone, without the query, and without a trailing slash to compare against.</summary>
    private string CurrentPath =>
        "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

    /// <summary>The feed or asset directory under management, when the URL names one.</summary>
    private (string Name, bool IsAssets)? Managed
    {
        get
        {
            var parts = CurrentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length < 3 || !parts[0].Equals("admin", StringComparison.OrdinalIgnoreCase))
            {
                return null;
            }

            return parts[1].ToLowerInvariant() switch
            {
                "feeds" => (Uri.UnescapeDataString(parts[2]), false),
                "assets" => (Uri.UnescapeDataString(parts[2]), true),
                _ => null,
            };
        }
    }

    /// <summary>Exact match, so "Feeds" does not stay lit while a single feed is being edited.</summary>
    private bool IsActive(NavLink link) =>
        link.Highlights && string.Equals(CurrentPath, link.Href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);

    /// <summary>Where the menu bar says you are, so a closed menu still answers that.</summary>
    private string? CurrentLabel =>
        Groups.SelectMany(g => g.Links.Select(l => (Group: g, Link: l))).FirstOrDefault(x => IsActive(x.Link)) is { Link: not null } hit
            ? hit.Group.TitleInMenuBar ? $"{hit.Group.Title} · {hit.Link.Label}" : hit.Link.Label
            : null;
}
