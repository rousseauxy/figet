@inherits LayoutComponentBase

<div class="fg-shell">
    <nav class="fg-navbar">
        <div class="fg-navbar-inner">
            <a class="fg-navbar-brand" href="/">FiGet</a>
            <div class="fg-nav-links">
                <a href="/">Feeds</a>
                @* One door into everything that changes something. The public pages below it are
                   read-only, which is what lets them be served to anyone. *@
                <AuthorizeView Policy="@FiGetApp.AdminPolicy">
                    <Authorized>
                        <a href="/admin/feeds">Admin</a>
                    </Authorized>
                </AuthorizeView>

                @* Static SSR cannot know the reader's choice, so the button ships a neutral glyph and
                   app.js paints the real one, flips the attribute the stylesheet keys off, and restores
                   the choice after an enhanced navigation replaces the document. Without script the page
                   still follows the operating system's preference, which is what it did before the
                   button existed. *@
                <button type="button" class="fg-theme-btn" data-theme-toggle title="Switch between light and dark" aria-label="Switch between light and dark">◐</button>

                <AuthorizeView Policy="@FiGetApp.AdminPolicy">
                    <Authorized>
                        <form method="post" action="/account/logout" class="fg-signed-in">
                            <AntiforgeryToken />
                            <span class="fg-who">@context.User.Identity?.Name</span>
                            <button type="submit" class="fg-linklike">Sign out</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        @* Reading is open on feeds that allow it; signing in is what adds the buttons. *@
                        <a href="/account/login">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>

    <main class="fg-main">
        @Body
    </main>
</div>
