<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @if (!string.IsNullOrWhiteSpace(Theme))
    {
        <link rel="stylesheet" href="@($"/themes/{Theme}.css")" />
    }
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="@Assets["app.js"]"></script>
</body>
</html>

@code {
    [Inject]
    private Microsoft.Extensions.Options.IOptions<FiGet.Web.Configuration.FiGetOptions> Options { get; set; } = default!;

    private string? Theme => Options.Value.Theming.Theme;
}
