<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @*
        Component-scoped styles, bundled by the build. Easy to leave out, because a project with no
        .razor.css files does not need it and nothing complains when it is missing — the page simply
        renders framework components unstyled. QuickGrid's pager arrives through here, as does the
        reconnect dialog, which is how the pager buttons came out as blank stubs.
    *@
    <link rel="stylesheet" href="@Assets["FiGet.Web.styles.css"]" />
    @if (!string.IsNullOrWhiteSpace(theme))
    {
        <link rel="stylesheet" href="@($"/themes/{theme}.css")" />
    }
    <HeadOutlet />
    @*
        Applied before the first paint, and deliberately inline rather than in app.js: a deferred script
        runs after the page has already been drawn, so every navigation would flash the other theme.
        Only an explicit choice is recorded here — with nothing stored, the stylesheet's media query
        answers the operating system on its own.
    *@
    <script>
        (function () {
            try {
                var chosen = localStorage.getItem("figet-theme");
                if (chosen === "light" || chosen === "dark") {
                    document.documentElement.setAttribute("data-theme", chosen);
                }
            } catch (error) {
                // A browser that refuses storage simply follows the system preference.
            }
        })();
    </script>
</head>
<body>
    <Routes />
    <script src="@Assets["app.js"]"></script>
    @*
        Only for a signed-in reader. The interactive views are the ones behind a sign-in, so an anonymous
        visitor to the read-only view downloads no framework at all — which is the point of leaving the
        public pages statically rendered in the first place.

        The reconnect dialog comes with it: session affinity keeps a circuit on one replica, but a restart
        or a rolling deploy still drops it, and without this the page would simply stop responding with no
        explanation.

        AuthorizeView rather than the cascading HttpContext: that cascade reaches the pages inside Routes
        but is NOT populated on this root component, so asking it here silently answered "anonymous" for
        everybody and the framework never shipped at all. The authentication state is cascaded app-wide by
        AddCascadingAuthenticationState, so it is the signal that actually works this far up.
    *@
    <AuthorizeView>
        <Authorized>
            <ReconnectModal />
            <script src="@Assets["_framework/blazor.web.js"]"></script>
        </Authorized>
    </AuthorizeView>
</body>
</html>

@code {
    [Inject]
    private Microsoft.Extensions.Options.IOptions<FiGet.Web.Configuration.FiGetOptions> Options { get; set; } = default!;

    [Inject]
    private IServiceScopeFactory Scopes { get; set; } = default!;

    private string? theme;

    /// <summary>
    /// A choice made in the admin area beats the configured one, so the look can change without a
    /// redeploy; configuration is what a fresh instance with no rows still answers with. One row by
    /// primary key per render.
    ///
    /// Read through a scope of its own, never the request's. The renderer does not wait for this to finish
    /// before it initialises the page inside, and the page reads the database too: sharing the request's one
    /// context, the two queries overlapped and the page answered 500. SQLite runs queries synchronously and
    /// never showed it; on SQL Server most concurrent page loads failed (PageRenderTests).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();
        var settings = scope.ServiceProvider.GetRequiredService<FiGet.Application.Ports.ISettingStore>();
        var stored = await settings.GetAsync(FiGet.Domain.Entities.SettingKeys.Theme, CancellationToken.None);
        theme = string.IsNullOrWhiteSpace(stored) ? Options.Value.Theming.Theme : stored;
    }
}
